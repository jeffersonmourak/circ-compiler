# JMP 0: 5 clocks.
set cpu_clock 1
set cpu_clock 0
set cpu_clock 1
set cpu_clock 0
set cpu_clock 1
set cpu_clock 0
set cpu_clock 1
set cpu_clock 0
set cpu_clock 1
set cpu_clock 0
get pc
dump out
# Only address 12 has changed.
mem mem
