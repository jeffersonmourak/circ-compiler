---
// A small, editable circ snippet in the docs: type, and the schematic below it
// follows. It ships inert — the editor and the compiler are fetched only once
// a reader actually touches it, so a tour page costs nothing to read.
import { url } from '../utils/url.ts';

interface Props {
  source: string;
  /**
   * Only `preview` ships. `simulate` would need a committed artifact for the
   * poster frame, and the tour's artifacts are deliberately untracked; the
   * examples page already has a live canvas of its own.
   */
  output?: 'preview';
  /** A catalogue id, so an unedited snippet expands by reference. */
  pick?: string;
  /** A committed artifact for the simulate poster frame. */
  wasm?: string;
  height?: string;
  readonly?: boolean;
  label?: string;
}
const {
  source,
  output = 'preview' as const,
  pick,
  wasm,
  height = '14rem',
  readonly = false,
  label = 'circ source',
} = Astro.props;

const wasmHref = wasm ? url(wasm) : '';
// A working link before any script runs, rewritten on each build once one has.
const expandHref = `${url('/playground')}${pick ? `#pick=${pick}` : ''}`;
---
<div
  class="le"
  data-le-output={output}
  data-le-height={height}
  data-le-readonly={String(readonly)}
  data-le-pick={pick ?? ''}
  data-le-wasm={wasmHref}
  data-le-label={label}
  data-le-wasm-url={url('/wasm/libcirc.wasm')}
  style={`--le-height: ${height}`}
>
  <div class="le-bar">
    <span class="le-status">Click to edit</span>
    <a class="le-expand" href={expandHref}>Open in playground &rarr;</a>
  </div>
  <div class="le-editor-wrap">
    <div class="le-editor" hidden></div>
    <pre class="le-source"><code>{source}</code></pre>
  </div>
  <div class="le-output" data-output={output}>
    <pre class="le-preview" hidden></pre>
  </div>
  <script type="application/json" class="le-src" set:html={JSON.stringify(source)} />
</div>

<script>
  import { mountLiveEditors } from '../scripts/live-editor.ts';
  mountLiveEditors();
</script>
