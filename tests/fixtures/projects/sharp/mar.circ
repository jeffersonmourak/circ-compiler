// MAR: the Memory Address Register, four MEM_CELs.
import mem_cel "mem_cel.circ"

input clock, we
input[4] din
input oe, reset

mem_cel m0(clock = clock, we = we, din = din[0], oe = oe, reset = reset)
mem_cel m1(clock = clock, we = we, din = din[1], oe = oe, reset = reset)
mem_cel m2(clock = clock, we = we, din = din[2], oe = oe, reset = reset)
mem_cel m3(clock = clock, we = we, din = din[3], oe = oe, reset = reset)

output[4] dout(in = {m0.dout, m1.dout, m2.dout, m3.dout})
output[4] sdata(in = {m0.sdata, m1.sdata, m2.sdata, m3.sdata})
