---
import Base from '../layouts/Base.astro';
import CodePreview from '../components/CodePreview.astro';
import OpenInPlayground from '../components/OpenInPlayground.astro';
import LiveEditor from '../components/LiveEditor.astro';
import { tour } from '../content/tour.ts';
---
<Base
  title="Tour — circ"
  description="A short progressive walkthrough of circ. Each step adds one new idea on top of the previous one."
>
  <h1>A short tour</h1>

  <p class="tour-intro">
    Each step adds one new idea on top of the previous one. By the end you'll
    have read enough <code>circ</code> to feel at home in the
    <a href="/reference">reference</a>. Source on the left, the
    <code>--preview</code> output on the right.
  </p>

  {tour.map((step, i) => (
    <section class="tour-step" id={`step-${i + 1}`}>
      <h2>
        <span class="step-num">Step {i + 1}.</span>
        {step.title}
      </h2>
      <p class="tour-prose">{step.prose}</p>
      <LiveEditor source={step.source} pick={`tour:${i + 1}`} />
      <OpenInPlayground id={`tour:${i + 1}`} />
    </section>
  ))}

  <p style="margin-top: 3rem; max-width: 36rem;">
    Done. The <a href="/reference">reference</a> covers the full surface — every
    keyword, every diagnostic code, the rules the validator enforces. The
    <a href="/gallery">gallery</a> has more circuits to read through.
  </p>
</Base>
