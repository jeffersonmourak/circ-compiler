---
import ThemeToggle from './ThemeToggle.astro';
import { url, GITHUB_REPO, GITHUB_PUBLIC } from '../utils/url.ts';

const links = [
  { href: url('/reference'), label: 'Reference' },
  { href: url('/gallery'), label: 'Gallery' },
  { href: url('/playground'), label: 'Playground' },
  { href: url('/download'), label: 'Download' },
];
---
<header class="site-nav">
  <a href={url('/')} class="brand">
    <span class="brand-mark">circ</span>
  </a>
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-nav"
    aria-label="Toggle menu"
  >
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
  </button>
  <nav id="primary-nav" aria-label="Primary">
    <ul>
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
      <li>
        {GITHUB_PUBLIC
          ? <a href={GITHUB_REPO} rel="noreferrer noopener">GitHub</a>
          : <span class="link-soon" title="Repo goes public once circ-compiler is ready to share">GitHub <small>(soon)</small></span>}
      </li>
    </ul>
  </nav>
  <ThemeToggle />
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
    };
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    nav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
  }
</script>
