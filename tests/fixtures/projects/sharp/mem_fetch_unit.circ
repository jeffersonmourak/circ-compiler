// MEM_FETCH_UNIT: steps 0..2 of every instruction.
//   step 0   MAR <- PC
//   step 1   MDR <- RAM[MAR]
//   step 2   IR <- MDR, PC <- PC + 1
// Carry rises from step 3 on and hands the control word to the instruction
// units.
//
// Control word, bit 0 first:
//    0 MAR.WE     1 MAR.OE    2 RAM.Store   3 RAM.Load
//    4 MDR.WE     5 MDR.OE    6 PC.Load     7 IR.WE
//    8 IR.OE      9 PC.OE    10 PC.Count   11 OUT.WE
//   12 X.WE      13 Y.WE     14 OUT.OE     15 ALU.OE
import tri_16 "tri_16.circ"

input[3] instruction_step_input

wire s0(in = instruction_step_input[0])
wire s1(in = instruction_step_input[1])
wire s2(in = instruction_step_input[2])

// Logisim Constants. circ has none, so 0 is a signal ANDed with its inverse.
and lo(a = s0, b = not(in = s0).out)
not hi(in = lo)

or  low_bits(a = s1, b = s0)
nor step_0(a = s2, b = low_bits.out)
nor high_clear(a = s2, b = s1)
and step_1(a = low_bits.out, b = high_clear.out)
nor even_low(a = s2, b = s0)
and step_2(a = even_low.out, b = s1)

tri_16 word_0(in = {hi, lo, lo, lo,  lo, lo, lo, lo,  lo, hi, lo, lo,  lo, lo, lo, lo}, en = step_0.out)
tri_16 word_1(in = {lo, hi, lo, hi,  hi, lo, lo, lo,  lo, lo, lo, lo,  lo, lo, lo, lo}, en = step_1.out)
tri_16 word_2(in = {lo, lo, lo, lo,  lo, hi, lo, hi,  lo, lo, hi, lo,  lo, lo, lo, lo}, en = step_2.out)
or words_01[16](a = word_0.out, b = word_1.out)
or words[16](a = words_01.out, b = word_2.out)

and done(
    a = and(a = not(in = step_2.out).out, b = not(in = step_1.out).out).out,
    b = not(in = step_0.out).out
)

output[16] data(in = words.out)
output[3] instruction_step_passthrough(in = instruction_step_input)
output carry(in = done.out)
