{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/code/CodePreview/**",
              "components/code/CommandSnippet/**",
              "components/code/LiveCanvas/**",
              "components/content/AlphaWarning/**",
              "components/content/ExampleCard/**",
              "components/content/Lineage/**",
              "components/content/StatusNote/**",
              "components/content/Tagline/**",
              "components/content/TourStep/**",
              "components/download/DownloadTable/**",
              "components/download/InstallLine/**",
              "components/layout/DocsPage/**",
              "components/layout/Prose/**",
              "components/layout/SiteShell/**",
              "components/navigation/Footer/**",
              "components/navigation/Nav/**",
              "components/navigation/ThemeToggle/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Ronzino|Necto Mono|JetBrains Mono|JetBrains Mono NL))/i]",
        "message": "Font not provided by the design system. Available: Ronzino, Necto Mono, JetBrains Mono, JetBrains Mono NL."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlphaWarning'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|children|key|ref|className|style|children)$/]",
        "message": "<AlphaWarning> doesn't accept that prop. Declared props: tag, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodePreview'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|source|preview|sourceLabel|previewLabel|caption|approximate|key|ref|className|style|children)$/]",
        "message": "<CodePreview> doesn't accept that prop. Declared props: title, source, preview, sourceLabel, previewLabel, caption, approximate."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandSnippet'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|copyLabel|key|ref|className|style|children)$/]",
        "message": "<CommandSnippet> doesn't accept that prop. Declared props: code, copyLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocsPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|headings|activeSlug|breadcrumb|children|key|ref|className|style|children)$/]",
        "message": "<DocsPage> doesn't accept that prop. Declared props: title, description, headings, activeSlug, breadcrumb, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|headers|key|ref|className|style|children)$/]",
        "message": "<DownloadTable> doesn't accept that prop. Declared props: rows, headers."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExampleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|id|lede|children|sourcePath|sourceHref|key|ref|className|style|children)$/]",
        "message": "<ExampleCard> doesn't accept that prop. Declared props: title, id, lede, children, sourcePath, sourceHref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|githubHref|githubPublic|license|colophon|signature|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: links, githubHref, githubPublic, license, colophon, signature."
      },
      {
        "selector": "JSXOpeningElement[name.name='InstallLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|key|ref|className|style|children)$/]",
        "message": "<InstallLine> doesn't accept that prop. Declared props: href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lineage'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Lineage> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|launchLabel|state|errorMessage|children|key|ref|className|style|children)$/]",
        "message": "<LiveCanvas> doesn't accept that prop. Declared props: label, hint, launchLabel, state, errorMessage, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveCanvas'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|loading|mounted|error)$/]",
        "message": "<LiveCanvas> state must be one of 'idle' | 'loading' | 'mounted' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|brandHref|links|githubHref|githubPublic|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: brand, brandHref, links, githubHref, githubPublic."
      },
      {
        "selector": "JSXOpeningElement[name.name='Prose'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Prose> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|nav|footer|key|ref|className|style|children)$/]",
        "message": "<SiteShell> doesn't accept that prop. Declared props: children, nav, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<StatusNote> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tagline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Tagline> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|className|style|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: label, icon, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TourStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|title|id|prose|children|key|ref|className|style|children)$/]",
        "message": "<TourStep> doesn't accept that prop. Declared props: step, title, id, prose, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AlphaWarning": {
        "replaces": []
      },
      "CodePreview": {
        "replaces": []
      },
      "CommandSnippet": {
        "replaces": []
      },
      "DocsPage": {
        "replaces": []
      },
      "DownloadTable": {
        "replaces": []
      },
      "ExampleCard": {
        "replaces": []
      },
      "Footer": {
        "replaces": []
      },
      "InstallLine": {
        "replaces": []
      },
      "Lineage": {
        "replaces": []
      },
      "LiveCanvas": {
        "replaces": []
      },
      "Nav": {
        "replaces": []
      },
      "Prose": {
        "replaces": []
      },
      "SiteShell": {
        "replaces": []
      },
      "StatusNote": {
        "replaces": []
      },
      "Tagline": {
        "replaces": []
      },
      "ThemeToggle": {
        "replaces": []
      },
      "TourStep": {
        "replaces": []
      }
    },
    "tokens": [
      "--accent",
      "--accent-soft",
      "--bg",
      "--border",
      "--code-bg",
      "--fg",
      "--font-mono",
      "--font-mono-strict",
      "--font-prose",
      "--line",
      "--measure",
      "--muted",
      "--pane-bg",
      "--pane-label-bg"
    ],
    "tokenKinds": {
      "--bg": "color",
      "--fg": "color",
      "--muted": "color",
      "--border": "color",
      "--accent": "color",
      "--accent-soft": "color",
      "--code-bg": "color",
      "--pane-bg": "color",
      "--pane-label-bg": "color",
      "--font-prose": "font",
      "--font-mono": "font",
      "--font-mono-strict": "font",
      "--measure": "spacing",
      "--line": "other"
    },
    "fontFamilies": [
      "JetBrains Mono",
      "JetBrains Mono NL",
      "Necto Mono",
      "Ronzino"
    ]
  }
}