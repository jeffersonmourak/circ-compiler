---
import Base from '../layouts/Base.astro';
import CodePreview from '../components/CodePreview.astro';
import OpenInPlayground from '../components/OpenInPlayground.astro';
import LiveCanvas from '../components/LiveCanvas.astro';
import { examples } from '../content/examples.ts';
import { GITHUB_REPO, GITHUB_PUBLIC, RENDERER_REPO } from '../utils/url.ts';
---
<Base
  title="Examples — circ"
  description="A gallery of circ circuits. Source on the left, the --preview ASCII schematic on the right, and a live interactive simulator where available."
>
  <h1>Examples</h1>

  <p class="examples-intro">
    A gallery of <code>circ</code> circuits — small to medium, primitives to
    multi-bit arithmetic and stateful latches. Each card shows the source on
    the left and the <code>--preview</code> output on the right. Where you see
    a <strong>▶ Run interactively</strong> button, click it to load
    <a href={RENDERER_REPO} rel="noreferrer noopener"><code>circ-renderer</code></a>
    and a compiled WASM artifact — you can then click input pins to flip them
    and watch the simulation propagate.
  </p>

  <div class="examples-grid">
    {examples.map((ex) => (
      <article class="example-card" id={ex.slug}>
        <h3>{ex.title}</h3>
        <p class="lede">{ex.lede}</p>
        <CodePreview source={ex.source} preview={ex.preview} />
        {ex.wasm && <LiveCanvas wasm={ex.wasm} />}
        <OpenInPlayground id={`example:${ex.slug}`} />
        {ex.repoPath && GITHUB_PUBLIC && (
          <p class="source-link muted">
            Source: <a
              href={`${GITHUB_REPO}/blob/main/${ex.repoPath}`}
              rel="noreferrer noopener"
            >{ex.repoPath}</a>
          </p>
        )}
      </article>
    ))}
  </div>
</Base>
