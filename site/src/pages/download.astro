---
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import Base from '../layouts/Base.astro';
import { url, GITHUB_PUBLIC, GITHUB_REPO } from '../utils/url.ts';

// Single source of truth: the VERSION file at the repo root, also read
// by tools/build-dist.sh so the archive filenames and the URLs on this
// page can never drift apart.
const here = path.dirname(fileURLToPath(import.meta.url));
const version = fs.readFileSync(path.resolve(here, '../../../VERSION'), 'utf8').trim();

const platforms = [
  {
    os: 'Linux',
    arch: 'x86_64',
    label: 'linux-x86_64',
    ext: 'tar.gz',
    minOs: 'Kernel 3.2+',
  },
  {
    os: 'macOS',
    arch: 'aarch64 (Apple Silicon)',
    label: 'macos-aarch64',
    ext: 'tar.gz',
    minOs: '11 (Big Sur)',
  },
  {
    os: 'Windows',
    arch: 'x86_64',
    label: 'windows-x86_64',
    ext: 'zip',
    minOs: '10',
  },
];

const downloads = platforms.map((p) => ({
  os: p.os,
  arch: p.arch,
  file: `circ-compile-${version}-${p.label}.${p.ext}`,
  minOs: p.minOs,
}));
---
<Base
  title="Download — circ"
  description="Pre-built circ-compile binaries for Linux, macOS, and Windows. The compiler is in alpha; errors are expected."
>
  <h1>Download</h1>

  <p class="download-version">Latest build: <code>{version}</code></p>

  <aside class="alpha-warning" role="note">
    <p class="alpha-tag"><strong>Alpha software.</strong></p>
    <p>
      <code>circ-compile</code> is under active development. Expect rough edges,
      cryptic error messages, and breaking changes between builds. Don't use it
      for anything you care about preserving. Reports of what doesn't work are
      welcome — but for now, please assume nothing here is stable.
    </p>
  </aside>

  <p class="download-intro">
    Pre-built binaries for the three major desktop platforms. Prefer to build
    from source? See the <a href={url('/reference/getting-started')}>getting-started guide</a>.
  </p>

  <table class="download-table">
    <thead>
      <tr>
        <th>OS</th>
        <th>Architecture</th>
        <th>File name</th>
        <th>Min OS version</th>
        <th>Download</th>
      </tr>
    </thead>
    <tbody>
      {downloads.map((d) => (
        <tr>
          <td>{d.os}</td>
          <td>{d.arch}</td>
          <td><code>{d.file}</code></td>
          <td>{d.minOs}</td>
          <td>
            <a
              href={url(`/downloads/${d.file}`)}
              download
              data-cli-download
              data-os={d.os}
              data-arch={d.arch}
              data-file={d.file}
              data-version={version}
            >↓ Download</a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  {GITHUB_PUBLIC && (
    <section class="download-source">
      <h2>Build from source</h2>
      <p>
        For Intel Macs, ARM Linux, ARM Windows, or any platform not listed above,
        build directly with <a href="https://ziglang.org/" rel="noreferrer noopener">Zig 0.15.x</a>:
      </p>
      <pre class="install-snippet"><code>{`git clone ${GITHUB_REPO}
cd ${GITHUB_REPO.split('/').pop()}
zig build circ-compile -Doptimize=ReleaseFast
./zig-out/bin/circ-compile --help`}</code></pre>
      <p>
        The full walkthrough — including writing your first <code>.circ</code> file
        and driving the compiled WASM from Node — lives in
        <a href={url('/reference/getting-started')}>Getting Started</a>.
      </p>
    </section>
  )}

  <script is:inline>
    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element
        ? event.target.closest('a[data-cli-download]')
        : null;
      if (!link) return;
      if (typeof window.posthog === 'undefined') return;
      window.posthog.capture('cli_download', {
        os: link.dataset.os,
        arch: link.dataset.arch,
        file: link.dataset.file,
        version: link.dataset.version,
        href: link.getAttribute('href'),
      });
    });
  </script>
</Base>
