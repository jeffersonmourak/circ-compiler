---
import { url } from '../utils/url.ts';
import ThemeToggle from './ThemeToggle.astro';
import { examples } from '../content/examples.ts';
import { tour } from '../content/tour.ts';
import { buildCatalogue } from '../utils/playground-store.ts';
import { displayGroups } from '../scripts/ws-tree.ts';

interface Props {
  manifest: { version: string; revision: string; full_version: number };
  supportedVersions: readonly number[];
}
const { manifest, supportedVersions } = Astro.props;
const wasmHref = url('/wasm/libcirc.wasm');
// One call feeds the sidebar rows, the embedded blob and the default pick, so
// they cannot drift from each other or from the shipped content.
const catalogue = buildCatalogue(examples, tour);
const initial = catalogue[0];
const groups = displayGroups(catalogue, []);
---
<div
  class="pg"
  style="--pg-term-h: 0px"
  data-libcirc-wasm={wasmHref}
  data-supported-versions={supportedVersions.join(',')}
  data-manifest-full-version={manifest.full_version.toString()}
  data-manifest-version={manifest.version}
  data-manifest-revision={manifest.revision}
  data-default-pick={initial.id}
>
  <!-- A classic script, executed during parsing, so the fragment is gone from
       location.href before any deferred module runs — PostHog's real init
       among them. The island reads the stashed copy instead. -->
  <script is:inline>
    (function () {
      try {
        var h = location.hash;
        if (/^#(src=|src0=|pick=)/.test(h) || /[#&](src|src0|pick)=/.test(h)) {
          window.__circShareHash = h;
          history.replaceState(history.state, '', location.pathname + location.search);
        }
      } catch (_) {
        // A blocked History API leaves the fragment in place; the island still
        // reads it from location.hash.
      }
    })();
  </script>
  <header class="pg-nav">
    <div class="pg-nav-left">
      <a class="pg-brand" href={url('/')}>circ</a>
      <button type="button" class="pg-crumb" aria-expanded="false" aria-controls="pg-switch">
        <span class="pg-crumb-group">Examples /</span>
        <span class="pg-crumb-name">{initial.label}</span>
        <span class="pg-crumb-chevron" aria-hidden="true">▾</span>
      </button>
      <span class="pg-status-cluster">
        <span class="pg-dot" data-state="idle" aria-hidden="true"></span>
        <span class="pg-status-label">Idle</span>
        <span class="pg-status-detail">Type to compile.</span>
      </span>
    </div>
    <div class="pg-nav-right">
      {/* Disabled until a build exists; the island keeps the label and title current. */}
      <button type="button" class="pg-action pg-download" disabled title="Compile a circuit first">
        <svg class="pg-action-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M8 2v7.5M4.75 6.5 8 9.75l3.25-3.25M3 12.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="pg-action-label">Download</span>
        <span class="pg-action-meta"></span>
      </button>
      <button type="button" class="pg-action pg-share" title="Copy a link to this circuit">
        <svg class="pg-action-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M6.5 9.5 9.5 6.5M7 4.5l1.3-1.3a2.5 2.5 0 0 1 3.5 3.5L10.5 8M5.5 8 4.2 9.3a2.5 2.5 0 0 0 3.5 3.5L9 11.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="pg-action-label">Share</span>
      </button>
      <ThemeToggle />
    </div>
  </header>
  <div class="pg-scrim" aria-hidden="true" hidden></div>
    <nav class="pg-switch" id="pg-switch" aria-label="Workspace" hidden>
      <label class="pg-switch-search">
        <span aria-hidden="true">⌕</span>
        <input type="search" class="pg-switch-query" aria-label="Find a circuit" placeholder="Find a circuit…" autocomplete="off" spellcheck="false" />
        <kbd aria-hidden="true">⌘K</kbd>
      </label>
      <div class="pg-switch-body" id="pg-switch-body">
        {/* The pre-hydration fallback: every project, flat, as ordinary links
            into the picker. The island replaces this whole subtree with a real
            `role=tree` once it runs — expansion state and the open project's
            file children both need the store, which the server does not have.
            Kept rather than shipped empty so the sidebar is never a blank box
            on a slow connection. */}
        <ul class="pg-switch-fallback">
          {groups.map(({ label, id, projects }) => (
            <li>
              <h2 class="pg-switch-group" id={`pg-switch-h-${id}`}>{label}</h2>
              <ul aria-labelledby={`pg-switch-h-${id}`}>
                {projects.map((c) => (
                  <li>
                    <button type="button" class="pg-switch-row pg-switch-project" data-pick={c.id}>{c.label}</button>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
        {/* One line under the tree, naming the first file that cannot be
            written back to the combined source. */}
        <p class="pg-switch-error" role="alert"></p>
      </div>
      <div class="pg-switch-footer">
        <button type="button" class="pg-switch-new" aria-label="New circuit">+ New circuit</button>
        <button type="button" class="pg-switch-import">Import .circ</button>
        <input type="file" class="pg-switch-picker" accept=".circ" aria-label="Import a circuit" hidden />
      </div>
    </nav>
  <div class="pg-body">
    <section class="pg-editor" id="pg-pane-editor">
      <div class="pg-banner" hidden></div>
      {/* The file strip (design file: 36px, the open file underlined in the
          accent). A switch only: rename, delete and reorder are the tree's,
          and the island fills the tabs from the same state the tree reads. */}
      <div class="pg-files" role="tablist" aria-label="Files">
        <button type="button" class="pg-file-add" aria-label="New file">+ file</button>
      </div>
      <div class="pg-editor-wrap" id="pg-editor-panel" role="tabpanel">
        <div id="pg-editor" class="pg-cm" hidden></div>
        <textarea
          id="pg-source"
          class="pg-source"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          aria-label="circ source"
          rows="18"
        >{initial.source}</textarea>
      </div>
      {/* The diagnostics footer (design file 3b: 30px). The bar says how many
          errors and warnings the compiler found and what the source is made
          of; the counts open the list, the gear opens the settings. Both are
          about the SOURCE, which is why they sit under the editor. */}
      <div class="pg-footer" data-open="false" data-tab="diagnostics">
        <div class="pg-footer-bar">
          <button type="button" class="pg-footer-counts" data-severity="none" aria-expanded="false" aria-controls="pg-footer-body">
            <span class="pg-footer-counts-text">0 errors · 0 warnings</span><span class="pg-footer-caret" aria-hidden="true">▾</span>
          </button>
          <span class="pg-footer-stats"></span>
          <button type="button" class="pg-footer-gear" aria-label="Settings" aria-expanded="false" aria-controls="pg-footer-body">⚙</button>
        </div>
        <div class="pg-footer-body" id="pg-footer-body" hidden>
          <ul class="pg-diag" data-footer-panel="diagnostics"></ul>
          <div class="pg-settings" data-footer-panel="settings" hidden>
          <fieldset class="pg-settings-group">
            <legend>Preview</legend>
            <label><input type="checkbox" data-setting="expandMacros" /> Expand macros</label>
            <label><input type="checkbox" data-setting="expandDisplay" /> Expand display</label>
          </fieldset>
          <fieldset class="pg-settings-group">
            <legend>Truth table</legend>
            <label for="pg-set-values">Values</label>
            <select id="pg-set-values" data-setting="valueFormat">
              <option value="binary">binary</option>
              <option value="hex">hex</option>
              <option value="decimal">decimal</option>
            </select>
            <label for="pg-set-cap">Input-bit cap</label>
            <input id="pg-set-cap" type="number" min="1" max="24" step="1" data-setting="truthTableCap" />
            <span class="pg-settings-hint">2^cap rows; once the enumeration starts, it runs to the end.</span>
          </fieldset>
          <fieldset class="pg-settings-group">
            <legend>Compile</legend>
            <label><input type="checkbox" data-setting="warningsAsErrors" /> Treat warnings as errors</label>
          </fieldset>
        </div>
        </div>
      </div>
    </section>
    <div
      class="pg-splitter"
      role="separator"
      tabindex="0"
      aria-orientation="vertical"
      aria-label="Resize the editor and output panes"
      aria-controls="pg-pane-editor pg-pane-output"
    ></div>
    <section class="pg-output" id="pg-pane-output">
      {/* The canvas region (design file, board 2a): the view switch top-left,
          the Data button top-right, the hint line bottom-left, the zoom line
          bottom-right, and the view itself in the inset between them. */}
      <div class="pg-view-bar">
        <div class="pg-view-switch" role="tablist" aria-label="View">
          <button type="button" role="tab" class="pg-view-tab" data-view="schematic" aria-selected="true" aria-controls="pg-view-schematic" tabindex="0">Schematic</button>
          <button type="button" role="tab" class="pg-view-tab" data-view="live" aria-selected="false" aria-controls="pg-view-live" tabindex="-1">Live</button>
          <button type="button" role="tab" class="pg-view-tab" data-view="truth" aria-selected="false" aria-controls="pg-view-truth" tabindex="-1">Truth</button>
        </div>
        {/* Each view's own tools, shown with it (design file 3e, 3f). The
            Schematic's two toggles are the same settings the footer's form
            binds, on the same `data-setting` attribute, so one binding paints
            both. The Truth chip carries the table's counts and, when the
            reader is blocked, why. */}
        <div class="pg-view-tools" data-for="schematic">
          <label class="pg-tool-toggle"><input type="checkbox" data-setting="expandMacros" /> Expand macros</label>
          <label class="pg-tool-toggle"><input type="checkbox" data-setting="expandDisplay" /> Expand display</label>
          <button type="button" class="pg-tool-btn" data-copy="preview" title="Copy the schematic as text"><span class="pg-action-label">Copy</span></button>
        </div>
        <span class="pg-truth-chip" id="pg-truth-chip" data-for="truth"></span>
        <button type="button" class="pg-data-btn" aria-expanded="false" aria-controls="pg-data-card">Data <span class="pg-data-count"></span></button>
      </div>
      <div class="pg-view-panel" id="pg-view-schematic" data-view-panel="schematic" role="tabpanel"><pre class="pg-preview"></pre></div>
      {/* The truth table in a card on the dot grid (design file 3f): the row
          matching the session's pins tinted, a click on a row driving them. */}
      <div class="pg-view-panel" id="pg-view-truth" data-view-panel="truth" role="tabpanel" hidden><div class="pg-truth-card"><div class="pg-table"></div></div></div>
      <div class="pg-view-panel pg-live" id="pg-view-live" data-view-panel="live" role="tabpanel" hidden>
        <div class="pg-sim-note"></div>
        <div class="pg-sim-mount" hidden></div>
      </div>
      {/* Every face drives the same session; the panel is a non-modal dialog. */}
      <div class="pg-data-card" id="pg-data-card" role="dialog" aria-label="Data" tabindex="-1" hidden>
        <div class="pg-data-head">
          <button type="button" class="pg-data-grip" aria-label="Move the panel" title="Drag, or use the arrow keys. Shift moves farther.">⋮⋮</button>
          <strong>Data</strong><span class="pg-data-summary"></span>
          <div class="pg-data-base" role="radiogroup" aria-label="Value base">
            {([['hex', 'hex'], ['binary', 'bin'], ['decimal', 'dec']] as const).map(([value, label]) => (
              <label><input type="radio" name="pg-data-base" data-setting="valueFormat" value={value} aria-label={value} /><span>{label}</span></label>
            ))}
          </div>
          <button type="button" class="pg-data-close" aria-label="Close Data">✕</button>
        </div>
        <div class="pg-data-note"></div>
        <div class="pg-data" hidden></div>
        <div class="pg-data-footer" hidden>
          <span class="pg-data-hint">edits settle the circuit and echo in the console</span>
          <button type="button" class="pg-data-reset" title="Every pin unknown, ROM images re-applied">Reset</button>
        </div>
      </div>
      <div class="pg-hint"></div>
      {/* The bottom-right line is the view's: the schematic's size, the truth
          table's copies, the Live view's zoom. */}
      <div class="pg-size" data-for="schematic">0 × 0 chars</div>
      <div class="pg-truth-copy" data-for="truth">
        <button type="button" class="pg-tool-btn" data-copy="markdown" title="Copy the table as markdown"><span class="pg-action-label">Copy as markdown</span></button>
        <span class="pg-zoom-sep" aria-hidden="true">·</span>
        <button type="button" class="pg-tool-btn" data-copy="csv" title="Copy the table as CSV"><span class="pg-action-label">CSV</span></button>
      </div>
      <div class="pg-zoom" data-for="live">
        <span class="pg-zoom-cell">cell 14</span>
        <span class="pg-zoom-sep" aria-hidden="true">·</span>
        <button type="button" class="pg-zoom-pct" aria-label="Reset zoom to 100%" aria-disabled="true">100%</button>
        <span class="pg-zoom-sep" aria-hidden="true">·</span>
        <button type="button" class="pg-zoom-fit" aria-label="Fit the circuit" aria-disabled="true">fit</button>
      </div>
    </section>
  </div>
  {/* Row 3 of the frame: the session's drawer, folded to one line until asked
      for. The line reads the console's transcript — the command title, the
      last thing typed and the first reply — and opens the drawer on Console
      or Memory. The drawer itself is the element it was under the output
      pane; only its row changed. */}
  <div class="pg-term" data-open="false" hidden inert>
    <div class="pg-term-line" tabindex="0" role="group" aria-label="Session console and memory">
      <span class="pg-term-title">circ-compile main.circ --sim</span>
      <span class="pg-term-prompt" aria-hidden="true">&gt;</span>
      <span class="pg-term-cmd"></span>
      <span class="pg-term-sep" aria-hidden="true"></span>
      <span class="pg-term-reply">Compile a circuit first.</span>
      <span class="pg-term-spacer"></span>
      <button type="button" class="pg-term-open" data-term="console" aria-controls="pg-drawer">Console <span aria-hidden="true">▴</span></button>
      <button type="button" class="pg-term-open pg-term-mem" data-term="memory" aria-controls="pg-drawer" aria-disabled="true">Memory</button>
    </div>
    <div
      class="pg-drawer-splitter"
      role="separator"
      tabindex="0"
      aria-orientation="horizontal"
      aria-label="Resize the output and the drawer"
      aria-controls="pg-pane-output pg-drawer"
      hidden
    ></div>
    <div class="pg-drawer" id="pg-drawer" data-open="false">
          {/* The --sim protocol at a prompt, dressed as an editor's terminal:
              a bar with the command the terminal is "running" and its
              actions, the log, the prompt line. Every line in the log is
              the executor's reply, the echo of a line (`> …`) — typed, or
              what another face did — or a comment (`# …`); Copy script
              gives the lines --sim accepts. The note says why there is
              nothing to drive. */}
          <div class="pg-console">
            <div class="pg-console-head">
              <span class="pg-console-tab">Console</span>
              <span class="pg-console-title">circ-compile main.circ --sim</span>
              <span class="pg-console-actions">
                <button type="button" class="pg-console-btn" data-console="clear" title="Clear the log (Ctrl+L)">Clear</button>
                <button type="button" class="pg-console-btn" data-console="script" title="Copy the commands, as a --sim script">Copy script</button>
                <button type="button" class="pg-console-btn" data-console="log" title="Copy the whole log">Copy log</button>
              </span>
              <button type="button" class="pg-drawer-close" aria-label="Close drawer">▾</button>
            </div>
            <p class="pg-console-note">Compile a circuit first.</p>
            <pre class="pg-console-log" aria-live="polite" aria-label="Console transcript"></pre>
            <form class="pg-console-form">
              <span class="pg-console-prompt" aria-hidden="true">&gt;</span>
              <span class="pg-console-caret" aria-hidden="true"></span>
              <input
                class="pg-console-in"
                type="text"
                spellcheck="false"
                autocomplete="off"
                autocapitalize="off"
                aria-label="Protocol command; help lists them"
                placeholder="help"
                disabled
              />
            </form>
          </div>
      <div class="pg-drawer-rule" hidden></div>
      <div class="pg-drawer-mem" aria-label="Memory" tabindex="-1" hidden><div class="pg-mem"></div></div>
    </div>
  </div>
  <footer class="pg-statusline">
    {/* Rendered from the committed manifest so the line is never blank before
        the version handshake resolves; the island overwrites it after. */}
    <span class="pg-status-identity">circ {manifest.version} · {manifest.revision} · CIRF v{manifest.full_version}</span>
    {/* The site footer's signature, verbatim: the app page renders no footer. */}
    <p class="signature muted">
      Made with <span class="heart" aria-hidden="true">♥︎</span><span class="visually-hidden">love</span>
      by <a href="https://github.com/jeffersonmourak" rel="noreferrer noopener">@jeffersonmourak</a>
    </p>
    <span class="pg-statusline-right">
      {/* The announcement channel: file-tab operations and store notes. While
          it holds a sentence the promise beside it yields the cell. */}
      <span class="pg-status" role="status" aria-live="polite"></span>
      <span class="pg-promise">runs in your browser · nothing leaves the page</span>
    </span>
  </footer>
  {/* Page data, not a module: it never enters the eager module graph, so the
      content files stay out of the island's bundle. */}
  <script type="application/json" id="pg-picks" set:html={JSON.stringify(catalogue)} />
</div>

<script>
  import { getSharedClient, type LibcircVersion, type WorkerReply } from '../scripts/libcirc-client.ts';
  // TYPE only: erased at build, so the renderer stays behind its dynamic import.
  import type { BitValue, CircRuntime, CircTheme, CircView } from 'circ-renderer';
  import type { PaletteKey } from '../utils/circ-theme.mjs';
  // A VALUE, but from the topology-only entry point: the decoder and its enum,
  // nothing of the canvas, so the eager bundle stays what it was.
  import { ComponentKind } from 'circ-renderer/topology';
  // The session the faces share. Pulls nothing of the canvas: its imports are
  // the topology entry point and the rom-image module, both already here.
  import { SimSession, type DriveAssign } from '../scripts/sim-session.ts';
  // The console over the session: the grammar and the reply strings of
  // `--sim`, and the prompt's own memory. Small, and the session already
  // pulls their one shared dependency, so they ride in the eager bundle.
  import { execute, handshake } from '../scripts/sim-executor.ts';
  import { HELP_VERB, HistoryRing, MemoryTabFiles, Transcript, commandFor, helpLines, promptEcho, scriptOf } from '../scripts/console.ts';
  import { summaryOf, memoryHeader, legendFor, imageLine } from '../scripts/terminal-line.ts';
  import { addressedWord } from '../scripts/memory-panel.ts';
  import { summarize, summaryLabels } from '../scripts/footer-summary.ts';
  import { pinCountLabel } from '../scripts/pin-count.ts';
  import { formatZoom } from '../scripts/zoom-label.ts';
  import { chipText } from '../scripts/truth-chip.ts';
  import type { TruthRows } from '../scripts/truth-view.ts';
  import { joinConflicts, requestFor, rootOf, splitFiles, PLAYGROUND_DIR } from '../utils/split-files.ts';
  import { createSplitter } from '../scripts/splitter.ts';
  import { clampPanel, defaultPos, positionFromDrag, crossedThreshold } from '../scripts/data-panel.ts';
  import type { PanelPos } from '../utils/playground-store.ts';
  import { fnv1a } from '../utils/artifact-hash.ts';
  import { artifactFileName } from '../utils/artifact-name.ts';
  import { capRefusal, mountSettingsDrawer, optionsFor, truthTableRefusal } from '../scripts/settings-drawer.ts';
  import { formatBytes } from '../scripts/pipeline.ts';
  import {
    applyRomImages,
    maxWords,
    parseRomImage,
    preloadsFor,
    romPlan,
    romSymbols,
    type MemorySymbol,
  } from '../utils/rom-image.ts';
  import {
    UNKNOWN,
    cellWidth,
    clampWindow,
    dumpRows,
    formatAddress,
    maskFor,
    pageContaining,
    pageCount,
    parseAddress,
    parseWord,
    type AddressWindow,
    type Cell,
  } from '../scripts/memory-panel.ts';
  import { editWord, imageCells, imageFromBytes } from '../scripts/rom-words.ts';
  import {
    declarationAt,
    declsFor,
    headerSymbolName,
    linkLayout,
    rootFileId,
    rootPathFor,
    type SourceLink,
    type Declaration,
    type LinkTable,
  } from '../scripts/source-link.ts';
  import { decodeShare, encodeShare, readHash, shareUrl, webStreamsCodec } from '../utils/share-link.ts';
  import { generateSillyName } from '../utils/sillyname.ts';
  import {
    createStore,
    describeNote,
    createScratch,
    deleteScratch,
    duplicateScratch,
    idKind,
    renameScratch,
    resolveInitial,
    resolveSource,
    touchScratch,
    uniqueName,
    NEW_PROJECT_SOURCE,
    type CatalogueItem,
    type View as StoredView,
    type FooterTab,
  } from '../utils/playground-store.ts';
  import {
    ANALYZE_DEBOUNCE_MS,
    BUILD_DEBOUNCE_MS,
    Stage,
    outputsShouldClear,
    shouldCompile,
    statusFor,
    type StatusInput,
  } from '../scripts/pipeline.ts';
  import {
    activeFile,
    addFile,
    canDelete,
    countsByFile,
    deleteFile,
    fromSource,
    moveFile,
    nameError,
    renameFile,
    rootIndex,
    select as selectTab,
    setBody,
    toSource,
    type FileTabsState,
  } from '../scripts/file-tabs.ts';
  import {
    fileNodeId,
    moveFor,
    reveal,
    sumCounts,
    toggle as toggleExpanded,
    visibleNodes,
    type TreeInput,
    type TreeKey,
    type TreeNode,
    displayGroups,
    groupOf,
    filterNodes,
  } from '../scripts/ws-tree.ts';
  import {
    indexDoc,
    mapPerTab,
    rangeToSpan,
    toLintDiagnostics,
    type Analysis,
    type AnalyzeDiagnostic as Diagnostic,
    type TabbedDiagnostic,
  } from '../scripts/circ-diagnostics.ts';


  /** A mapped diagnostic plus the file tab it belongs to; `null` when the
   *  compiler blamed a file with no tab (a `<builtin>/…` source, or a stale
   *  path from a reply that outlived a rename). */
  type MappedRow = TabbedDiagnostic;

  const root = document.querySelector<HTMLElement>('.pg');
  if (root) init(root);

  function init(el: HTMLElement) {
    const source = el.querySelector<HTMLTextAreaElement>('#pg-source')!;
    const editorWrap = el.querySelector<HTMLElement>('.pg-editor-wrap')!;
    const filesEl = el.querySelector<HTMLElement>('.pg-files')!;
    const fileAdd = el.querySelector<HTMLButtonElement>('.pg-file-add')!;
    const editorHost = el.querySelector<HTMLElement>('#pg-editor')!;
    const status = el.querySelector<HTMLElement>('.pg-status')!;
    const dot = el.querySelector<HTMLElement>('.pg-dot')!;
    const statusLabel = el.querySelector<HTMLElement>('.pg-status-label')!;
    const statusDetail = el.querySelector<HTMLElement>('.pg-status-detail')!;
    const statusIdentity = el.querySelector<HTMLElement>('.pg-status-identity')!;
    const banner = el.querySelector<HTMLElement>('.pg-banner')!;
    const diagList = el.querySelector<HTMLUListElement>('.pg-diag')!;
    const outputPane = el.querySelector<HTMLElement>('.pg-output')!;
    const previewEl = el.querySelector<HTMLElement>('.pg-preview')!;
    const tableEl = el.querySelector<HTMLElement>('.pg-table')!;
    const simNote = el.querySelector<HTMLElement>('.pg-sim-note')!;
    const dataNote = el.querySelector<HTMLElement>('.pg-data-note')!;
    const dataFooter = el.querySelector<HTMLElement>('.pg-data-footer')!;
    const dataSummary = el.querySelector<HTMLElement>('.pg-data-summary')!;
    const dataClose = el.querySelector<HTMLButtonElement>('.pg-data-close')!;
    const dataGrip = el.querySelector<HTMLButtonElement>('.pg-data-grip')!;
    const dataEl = el.querySelector<HTMLElement>('.pg-data')!;
    const dataReset = el.querySelector<HTMLButtonElement>('.pg-data-reset')!;
    // Narrowed to the view switch: an unscoped [role=tab] would also collect
    // the file strip, and showView() would then clobber its aria-selected.
    const viewSwitch = el.querySelector<HTMLElement>('.pg-view-switch')!;
    const viewTabs = Array.from(el.querySelectorAll<HTMLButtonElement>('.pg-view-switch [role=tab]'));
    const truthChip = el.querySelector<HTMLElement>('.pg-truth-chip')!;
    const sizeLine = el.querySelector<HTMLElement>('.pg-size')!;
    const copyButtons = Array.from(el.querySelectorAll<HTMLButtonElement>('[data-copy]'));
    const dataBtn = el.querySelector<HTMLButtonElement>('.pg-data-btn')!;
    const dataCount = el.querySelector<HTMLElement>('.pg-data-count')!;
    const dataCard = el.querySelector<HTMLElement>('.pg-data-card')!;
    const hintEl = el.querySelector<HTMLElement>('.pg-hint')!;
    const zoomPct = el.querySelector<HTMLButtonElement>('.pg-zoom-pct')!;
    const zoomFit = el.querySelector<HTMLButtonElement>('.pg-zoom-fit')!;
    const wsRoot = el.querySelector<HTMLElement>('.pg-switch')!;
    const scrim = el.querySelector<HTMLElement>('.pg-scrim')!;
    const crumbChevron = el.querySelector<HTMLElement>('.pg-crumb-chevron')!;
    const switchQuery = el.querySelector<HTMLInputElement>('.pg-switch-query')!;
    const crumb = el.querySelector<HTMLButtonElement>('.pg-crumb')!;
    const wsBody = el.querySelector<HTMLElement>('.pg-switch-body')!;
    const wsNew = el.querySelector<HTMLButtonElement>('.pg-switch-new')!;
    const importButton = el.querySelector<HTMLButtonElement>('.pg-switch-import')!;
    const importPicker = el.querySelector<HTMLInputElement>('.pg-switch-picker')!;
    const wsError = el.querySelector<HTMLElement>('.pg-switch-error')!;
    const shareBtn = el.querySelector<HTMLButtonElement>('.pg-share')!;
    const downloadBtn = el.querySelector<HTMLButtonElement>('.pg-download')!;
    const navActions = el.querySelector<HTMLElement>('.pg-nav-right')!;
    const downloadLabel = el.querySelector<HTMLElement>('.pg-download .pg-action-label')!;
    const downloadMeta = el.querySelector<HTMLElement>('.pg-download .pg-action-meta')!;
    const crumbGroup = el.querySelector<HTMLElement>('.pg-crumb-group')!;
    const crumbName = el.querySelector<HTMLElement>('.pg-crumb-name')!;
    const viewPanels = Array.from(el.querySelectorAll<HTMLElement>('[data-view-panel]'));
    // The diagnostics footer under the editor: its bar, the two openers, and
    // the body the two panels share.
    const footer = el.querySelector<HTMLElement>('.pg-footer')!;
    const footerCounts = el.querySelector<HTMLButtonElement>('.pg-footer-counts')!;
    const footerCountsText = el.querySelector<HTMLElement>('.pg-footer-counts-text')!;
    const footerStats = el.querySelector<HTMLElement>('.pg-footer-stats')!;
    const footerGear = el.querySelector<HTMLButtonElement>('.pg-footer-gear')!;
    const footerBody = el.querySelector<HTMLElement>('.pg-footer-body')!;
    const footerPanels = Array.from(el.querySelectorAll<HTMLElement>('[data-footer-panel]'));
    // The drawer: the session's strip under the Simulate and Data panels,
    // with the same scoped [role=tab] query as the two strips above.
    const drawer = el.querySelector<HTMLElement>('.pg-drawer')!;
    const term = el.querySelector<HTMLElement>('.pg-term')!;
    const termTitle = el.querySelector<HTMLElement>('.pg-term-title')!;
    const termCmd = el.querySelector<HTMLElement>('.pg-term-cmd')!;
    const termReply = el.querySelector<HTMLElement>('.pg-term-reply')!;
    const termOpeners = Array.from(el.querySelectorAll<HTMLButtonElement>('.pg-term-open'));
    const termMem = el.querySelector<HTMLButtonElement>('.pg-term-mem')!;
    const drawerSeparator = el.querySelector<HTMLElement>('.pg-drawer-splitter')!;
    const memColumn = el.querySelector<HTMLElement>('.pg-drawer-mem')!;
    const drawerRule = el.querySelector<HTMLElement>('.pg-drawer-rule')!;
    const consoleEl = el.querySelector<HTMLElement>('.pg-console')!;
    const consoleTitle = el.querySelector<HTMLElement>('.pg-console-title')!;
    const consoleButtons = Array.from(el.querySelectorAll<HTMLButtonElement>('.pg-console-btn'));
    const consoleNote = el.querySelector<HTMLElement>('.pg-console-note')!;
    const consoleLog = el.querySelector<HTMLElement>('.pg-console-log')!;
    const consoleForm = el.querySelector<HTMLFormElement>('.pg-console-form')!;
    const consoleIn = el.querySelector<HTMLInputElement>('.pg-console-in')!;
    const memPanel = el.querySelector<HTMLElement>('.pg-mem')!;
    const truthTab = el.querySelector<HTMLButtonElement>('.pg-view-tab[data-view="truth"]')!;
    const catalogue = JSON.parse(el.querySelector('#pg-picks')!.textContent || '[]') as CatalogueItem[];
    const countedCatalogue = catalogue.map((p) => ({ ...p, fileCount: splitFiles(p.source).length }));
    const supported = (el.dataset.supportedVersions || '').split(',').filter(Boolean).map(Number);

    // One client per wasm URL, shared by every island on the page.
    const client = getSharedClient(el.dataset.libcircWasm!);
    // Two independent debounces, each with its own sequence counter.
    const analyzeStage = new Stage(ANALYZE_DEBOUNCE_MS);
    const buildStage = new Stage(BUILD_DEBOUNCE_MS);

    const state = {
      /** Bumped on every edit; the freshness key the two stages compare. */
      doc: 0,
      analyzedDoc: null as number | null,
      /** The file NAME list as of the outputs currently on screen. */
      renderedFiles: [] as string[],
      stale: false,
      /** The pipeline's single source of truth: the file set and which tab is
       *  visible. The combined string is never stored — it is computed on
       *  demand with `toSource(state.tabs)`. Never read off the DOM. */
      tabs: fromSource(source.value) as FileTabsState,
      analysis: null as Analysis | null,
      diagnostics: [] as Diagnostic[],
      /** `state.diagnostics` mapped onto absolute offsets in the combined
       *  document. Refreshed by BOTH producers in the pipeline. */
      mapped: [] as MappedRow[],
      artifact: null as { bytes: Uint8Array; hash: number; size: number } | null,
      view: 'schematic' as StoredView,
      /** The Data card: open over whichever view; its rows are the session's. */
      dataOpen: false,
      version: null as LibcircVersion | null,
      simulateEnabled: true,
    };
    /** The Truth view's table on screen, and how it came to be. Declared
     *  here, beside the state, because the gate reads it at boot. */
    const truth = {
      table: null as TruthRows | null,
      /** The over-cap path: rows enumerated on the site over the unknown pins. */
      filtered: false,
      unknownBits: undefined as number | undefined,
      /** How long the last enumeration on the site took, for the record. */
      lastMs: null as number | null,
    };
    // Slice 8 attaches the simulator here.
    const hooks = {
      onDataOpen: null as null | (() => void),
      onArtifact: null as null | ((bytes: Uint8Array | null, reason: 'built' | 'files-changed') => void),
      /** The Live view was shown: build or note. Set once the simulator is
       *  wired, which is after the restore from the envelope runs — a restore
       *  onto Live must not reach the simulator's record before it exists. */
      onLive: null as null | (() => void),
      /** What a copy button copies, by its `data-copy`; null for one the
       *  island does not know. The Truth view registers markdown and csv. */
      copySource: null as null | ((what: string) => Promise<string> | null),
      /** Re-read the artifact into the Download button; set once the status
       *  actions are wired, called from every place the artifact changes. */
      refreshActions: null as null | (() => void),
    };
    // `renderMemory` is a deliberate test seam alongside the two above: the
    // memory panel only exists once an analysis reports a rom or a ram, and no
    // headless harness can run the worker that produces one. The smoke test
    // sets `state.analysis` and calls this.
    // `refreshActions` and `setStale` are seams too: the Download button
    // follows the artifact, which only the worker produces, so the smoke test
    // hands the state one and flips staleness the way the compile reply does.
    (el as any).__playground = {
      state,
      hooks,
      renderMemory: () => renderMemory({ force: true }),
      refreshActions: () => hooks.refreshActions?.(),
      setStale: (stale: boolean) => setStale(stale),
      // The terminal line follows the transcript, which only a session feeds;
      // the smoke test feeds it lines the way a reply would arrive.
      consoleAppend: (lines: readonly string[]) => consoleAppend(lines, 'page', { force: true }),
      // The footer's list follows `state.mapped`, which only an analysis
      // fills; the smoke test seeds it and calls this.
      renderDiagnostics: () => renderDiagnostics(),
      // The Truth view's rows come from the worker; the smoke test hands it
      // the compiler's JSON and reads the card.
      renderTruth: (json: string) => loadTruthView().then((m) => renderTruth(m.parseTruthTable(json))),
      // The Data walk uses a real artifact without mounting a canvas.
      getSession: () => ensureSession(),
      showData: () => showData(),
      placeDataPanel: () => placeDataPanel(),
      dataPanelState: () => ({ open: store.envelope.dataOpen, positions: store.envelope.dataPanel }),
      truth,
    };

    // ---- tabs ----
    /**
     * Why the truth table is unavailable, or null. Recomputed from state
     * rather than cached, because all three of its inputs — the error count,
     * the root's input width, and the cap — move independently.
     */
    function truthBlock(): string | null {
      const errors = state.mapped.filter((m) => m.severity === 'error');
      const first = errors[0];
      // The errors only: over the cap the table still opens (decision 10), on
      // the site's own enumeration of the unknown pins, so the cap is the
      // chip's to say and never a block.
      return truthTableRefusal(
        {
          errors: errors.length,
          // Code and message only. The file and line are one click away in the
          // footer right below, and a chip is not the place for a position.
          firstError: first ? `${first.code} ${first.message}` : null,
          bits: null,
        },
        settings(),
      );
    }

    /**
     * Paint the truth tab's availability.
     *
     * `aria-disabled`, never the `disabled` attribute: a disabled button is
     * unfocusable and swallows pointer events in most browsers, which would
     * take the tooltip — the only place the reason is stated — away from
     * exactly the readers who need it most. The click handler enforces it.
     */
    function applyTruthGate() {
      const reason = truthBlock();
      truthTab.setAttribute('aria-disabled', String(reason !== null));
      // The chip beside the switch carries the counts and, when the reader is
      // blocked, why; the tab is described by it only while there is a reason.
      truthChip.textContent = chipText({
        bits: rootInputBits(),
        rows: truth.table?.rows.length ?? null,
        cap: settings().truthTableCap,
        blocked: reason,
        filtered: truth.filtered,
        unknownBits: truth.unknownBits,
      });
      if (reason === null) truthTab.removeAttribute('aria-describedby');
      else truthTab.setAttribute('aria-describedby', 'pg-truth-chip');
      // Blocked while it is the open view: say so in the panel rather than
      // moving the reader somewhere they did not ask to go. Transient errors
      // are constant while typing, and a view that flees mid-keystroke is
      // worse than one that explains itself.
      if (reason !== null && state.view === 'truth') {
        tableEl.innerHTML = '';
        tableEl.textContent = reason;
      }
    }

    /** The hint line under each view (design file, board 2a). */
    const HINTS: Record<StoredView, string> = {
      schematic: '',
      live: 'click a pin to toggle · hover a part to find it in the source',
      truth: '',
    };

    function showView(view: StoredView, opts: { persist?: boolean } = {}) {
      state.view = view;
      if (opts.persist !== false) store.update((draft) => { draft.view = view; });
      for (const b of viewTabs) {
        const selected = b.dataset.view === view;
        b.setAttribute('aria-selected', String(selected));
        b.tabIndex = selected ? 0 : -1;
      }
      for (const p of viewPanels) p.hidden = p.dataset.viewPanel !== view;
      // The region wears the view: the Schematic's code surface without the
      // grid, and each view's tools and bottom-right line.
      outputPane.dataset.view = view;
      syncDrawerVisibility();
      if (memVisible()) renderMemory();
      hintEl.textContent = HINTS[view];
      // A view switch re-uses the build stage's current sequence rather than
      // claiming a new one, so a compile already in flight stays current and
      // its artifact still lands.
      if (view === 'schematic') void runPreview(buildStage.seq);
      if (view === 'truth') void runTruth(buildStage.seq);
      // Through the hook: `sim` is declared after the restore that calls this
      // at boot, and the artifact that lands later builds the canvas itself.
      if (view === 'live') hooks.onLive?.();
    }
    for (const b of viewTabs) {
      b.addEventListener('click', () => {
        const view = b.dataset.view as StoredView;
        // The gate lives here rather than in showView: a restore from the
        // envelope must still be able to land on a blocked view, or a reader
        // who left the page on the truth table would come back to a region
        // that silently moved. Refusing here also keeps the reason on screen.
        if (view === 'truth' && b.getAttribute('aria-disabled') === 'true') {
          const reason = truthChip.textContent;
          if (reason) status.textContent = reason;
          return;
        }
        showView(view);
      });
    }
    // The tablist's due: arrows move between the three, Home and End to the
    // ends, and a blocked Truth view is skipped the way a click would refuse it.
    viewSwitch.addEventListener('keydown', (e) => {
      const order = viewTabs.map((b) => b.dataset.view as StoredView);
      const at = order.indexOf(state.view);
      const next =
        e.key === 'ArrowLeft' ? Math.max(0, at - 1)
        : e.key === 'ArrowRight' ? Math.min(order.length - 1, at + 1)
        : e.key === 'Home' ? 0
        : e.key === 'End' ? order.length - 1
        : null;
      if (next === null) return;
      e.preventDefault();
      viewTabs[next].click();
      viewTabs[next].focus();
    });

    /** The Data card: open over whichever view, its rows the session's. */
    function setDataOpen(open: boolean, opts: { persist?: boolean; focus?: boolean } = {}) {
      if (!open) cancelDataDrag();
      state.dataOpen = open;
      if (opts.persist !== false) store.update((draft) => { draft.dataOpen = open; });
      dataCard.hidden = !open;
      dataBtn.setAttribute('aria-expanded', String(open));
      outputPane.dataset.dataOpen = String(open);
      if (open) {
        placeDataPanel();
        hooks.onDataOpen?.();
      }
      if (opts.focus !== false) (open ? dataCard : dataBtn).focus();
    }
    dataBtn.addEventListener('click', () => setDataOpen(!state.dataOpen));
    dataClose.addEventListener('click', () => setDataOpen(false));
    dataCard.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || e.defaultPrevented) return;
      e.preventDefault();
      e.stopPropagation();
      if (dataDrag) { cancelDataDrag(); return; }
      setDataOpen(false);
    });

    /** `N → M` on the Data button: the root's pins, from the last analysis. */
    function renderDataCount() {
      const a = state.analysis;
      dataCount.textContent = a
        ? pinCountLabel(a.symbols, rootFileId(a.files, rootPathFor(rootOf(state.tabs.files).name)))
        : '';
    }

    // ---- the diagnostics footer ----
    // The bar under the editor says how many errors and warnings there are and
    // what the source is made of; its body opens on the diagnostics list or on
    // the settings form. The gestures are the dock's: the counts open the body
    // on diagnostics, or close it when it is already open there; the gear
    // does the same for settings; the other button while open switches panel.
    // Escape in the body closes it and hands focus back to whichever opened it.
    let footerOpener: HTMLButtonElement | null = null;
    function reflectFooter() {
      const open = footer.dataset.open === 'true';
      const tab = footer.dataset.tab;
      footerCounts.setAttribute('aria-expanded', String(open && tab === 'diagnostics'));
      footerGear.setAttribute('aria-expanded', String(open && tab === 'settings'));
    }
    function showFooterTab(tab: FooterTab, opts: { persist?: boolean } = {}) {
      footer.dataset.tab = tab;
      for (const p of footerPanels) p.hidden = p.dataset.footerPanel !== tab;
      reflectFooter();
      if (opts.persist !== false) store.update((draft) => { draft.footer.tab = tab; });
    }
    function setFooterOpen(open: boolean, opts: { persist?: boolean } = {}) {
      footer.dataset.open = String(open);
      footerBody.hidden = !open;
      reflectFooter();
      if (opts.persist !== false) store.update((draft) => { draft.footer.open = open; });
    }
    function toggleFooter(tab: FooterTab, opener: HTMLButtonElement) {
      if (footer.dataset.open === 'true' && footer.dataset.tab === tab) {
        setFooterOpen(false);
        return;
      }
      footerOpener = opener;
      showFooterTab(tab);
      setFooterOpen(true);
    }
    footerCounts.addEventListener('click', () => toggleFooter('diagnostics', footerCounts));
    footerGear.addEventListener('click', () => toggleFooter('settings', footerGear));
    footerBody.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      e.preventDefault();
      setFooterOpen(false);
      (footerOpener ?? footerCounts).focus();
    });

    // ---- the drawer ----
    // The drawer keeps its open state while Schematic hides the whole row.
    /** The drawer's divider, created with the main one once the panes exist. */
    let drawerSplitter: ReturnType<typeof createSplitter> | null = null;
    const drawerClose = el.querySelector<HTMLButtonElement>('.pg-drawer-close')!;
    const termLine = el.querySelector<HTMLElement>('.pg-term-line')!;

    /** A hidden or folded drawer has no divider to reach. */
    function refreshDrawerSeparator() {
      drawerSeparator.hidden = term.hidden || drawer.dataset.open !== 'true';
      drawerSplitter?.refresh();
    }

    function syncDrawerVisibility() {
      const hidden = state.view === 'schematic';
      const hadFocus = hidden && term.contains(document.activeElement);
      term.hidden = hidden;
      term.toggleAttribute('inert', hidden);
      el.style.setProperty('--pg-term-h', hidden ? '0px' : drawer.dataset.open === 'true' ? 'var(--pg-drawer-h, 320px)' : '');
      refreshDrawerSeparator();
      if (hadFocus) viewTabs.find((b) => b.dataset.view === 'schematic')?.focus();
    }

    /** Open state is the terminal row's: `data-open` on it, and the row's
     *  height on the frame, written together so the two cannot disagree. */
    function setDrawerOpen(open: boolean) {
      if (open && state.view === 'schematic') return;
      term.dataset.open = String(open);
      drawer.dataset.open = String(open);
      for (const b of termOpeners) b.setAttribute('aria-expanded', String(open));
      syncDrawerVisibility();
      if (open && memVisible()) renderMemory();
      if (!open && (drawer.contains(document.activeElement) || document.activeElement === drawerSeparator)) termOpeners[0]?.focus();
    }
    drawerClose.addEventListener('click', () => setDrawerOpen(false));
    const openConsole = () => {
      if (term.hidden) return;
      setDrawerOpen(true);
      (consoleIn.disabled ? drawerClose : consoleIn).focus();
    };
    termLine.addEventListener('focusin', (e) => { if (e.target === termLine) openConsole(); });
    termLine.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('button')) openConsole(); });
    consoleIn.addEventListener('focus', () => { if (drawer.dataset.open !== 'true') setDrawerOpen(true); });

    /** The closed line: the last command and its reply, off the transcript. */
    function renderTermLine() {
      const { command, reply } = summaryOf(consoleState.transcript.lines);
      termCmd.textContent = command ?? '';
      // Liveness as the prompt's gate already renders it (`refreshConsoleGate`
      // hides the note while a session is alive), so this needs nothing that
      // is declared after it.
      const live = consoleNote.hidden;
      termReply.textContent = reply ?? (command ? '' : live ? (consoleState.transcript.last ?? '') : 'Compile a circuit first.');
      termReply.dataset.kind = reply ? consoleKind(reply) : 'note';
      const hasMem = drawer.hasAttribute('data-mem');
      termMem.setAttribute('aria-disabled', String(!hasMem));
    }
    for (const b of termOpeners) {
      b.addEventListener('click', () => {
        if (term.hidden) return;
        if (b.dataset.term === 'memory') {
          if (!drawer.hasAttribute('data-mem')) return;
          setDrawerOpen(true);
          memColumn.focus();
        } else if (drawer.dataset.open === 'true') setDrawerOpen(false);
        else openConsole();
      });
    }


    // ---- the console ----
    // One transcript and one history whichever output tab is open: the drawer
    // is one element, and it drives one session.
    const consoleState = {
      transcript: new Transcript(),
      history: new HistoryRing(),
      files: new MemoryTabFiles(),
      /** A line is running: the prompt waits, and a `rebuilt` waits for its reply. */
      busy: false,
      /** The session was rebuilt while a line ran; announce it after the reply. */
      rebuilt: false,
      /** The log was cleared for a new project and nothing has been printed
       *  since: the old session's end is not this log's news. */
      fresh: true,
    };

    /** What kind of line this is, for the stylesheet only; the text is untouched. */
    function consoleKind(line: string): string {
      if (line.startsWith('err ')) return 'err';
      if (line.startsWith('> ')) return 'echo';
      if (line.startsWith('# ')) return 'note';
      return 'reply';
    }

    /** True when the log is scrolled to its end, within a line and a half; a
     *  reader scrolled up to read must not be dragged down by a new line. */
    function consoleAtEnd(): boolean {
      const lineHeight = parseFloat(getComputedStyle(consoleLog).lineHeight);
      const threshold = Number.isFinite(lineHeight) && lineHeight > 0 ? lineHeight * 1.5 : 24;
      return consoleLog.scrollHeight - consoleLog.scrollTop - consoleLog.clientHeight <= threshold;
    }

    /**
     * Append lines to the log. `page` marks lines another face caused, for
     * the stylesheet only. The log follows a new line only when it was
     * already at the end, or when the caller insists (a submit, a handshake).
     */
    function consoleAppend(lines: readonly string[], origin: 'prompt' | 'page' = 'prompt', opts: { force?: boolean } = {}) {
      if (lines.length === 0) return;
      const follow = opts.force || consoleAtEnd();
      consoleState.transcript.append(lines);
      for (const line of lines) {
        const row = document.createElement('span');
        row.className = 'pg-console-line';
        row.dataset.kind = consoleKind(line);
        if (line.startsWith('ok')) row.dataset.ok = '';
        if (origin === 'page') row.dataset.origin = 'page';
        row.textContent = `${line}\n`;
        consoleLog.appendChild(row);
      }
      while (consoleLog.childElementCount > consoleState.transcript.cap) consoleLog.firstElementChild?.remove();
      if (follow) consoleLog.scrollTop = consoleLog.scrollHeight;
      renderTermLine();
    }

    function consoleClear() {
      consoleState.transcript.clear();
      consoleLog.innerHTML = '';
      renderTermLine();
    }

    /**
     * Another project: a new terminal. The log and the history start over,
     * as they would for a fresh process, and the session the last project
     * had is dropped by the pipeline without a `# session ended` line here.
     */
    function consoleNewSession() {
      consoleClear();
      consoleState.history = new HistoryRing();
      consoleState.fresh = true;
    }

    /** The prompt follows the session: live with one, shut without. */
    function refreshConsoleGate() {
      const live = sim.session !== null && sim.session.isAlive;
      consoleIn.disabled = !live || consoleState.busy;
      consoleNote.hidden = live;
    }

    /** The lines `--sim` prints first, with the root file as the name the CLI was given. */
    function consoleHandshake(session: SimSession) {
      const root = rootOf(state.tabs.files).name;
      consoleTitle.textContent = `circ-compile ${root} --sim`;
      termTitle.textContent = consoleTitle.textContent;
      consoleState.fresh = false;
      consoleAppend(handshake(session, root), 'prompt', { force: true });
    }

    /**
     * Hand the clipboard a text and say what went. `navigator.clipboard` is
     * absent off a secure context and in the test harness, and a browser may
     * refuse; both are a sentence, never a throw.
     */
    function consoleCopy(text: string, what: string) {
      const capped = consoleState.transcript.length === consoleState.transcript.cap
        ? `; the log is capped at ${consoleState.transcript.cap.toLocaleString('en-US')} lines`
        : '';
      const clip = typeof navigator !== 'undefined' ? navigator.clipboard : undefined;
      if (!clip || typeof clip.writeText !== 'function') {
        status.textContent = 'Clipboard unavailable; select the log and copy it.';
        return;
      }
      clip.writeText(text).then(
        () => { status.textContent = `${what}${capped}.`; },
        () => { status.textContent = 'Clipboard unavailable; select the log and copy it.'; },
      );
    }

    for (const b of consoleButtons) {
      b.addEventListener('click', () => {
        const action = b.dataset.console;
        if (action === 'clear') {
          consoleClear();
          consoleIn.focus();
        } else if (action === 'script') {
          const lines = scriptOf(consoleState.transcript.lines);
          consoleCopy(`${lines.join('\n')}\n`, `Copied ${lines.length} command line${lines.length === 1 ? '' : 's'}`);
        } else if (action === 'log') {
          const n = consoleState.transcript.length;
          consoleCopy(`${consoleState.transcript.text}\n`, `Copied the log, ${n} line${n === 1 ? '' : 's'}`);
        }
      });
    }

    async function consoleSubmit(line: string) {
      const session = sim.session;
      if (!session || consoleState.busy) return;
      consoleState.history.push(line);
      consoleAppend([promptEcho(line)], 'prompt', { force: true });
      if (line.trim() === HELP_VERB) {
        consoleAppend(helpLines());
        return;
      }
      consoleState.busy = true;
      refreshConsoleGate();
      try {
        const replies = await execute(session, consoleState.files, line);
        consoleAppend(replies);
        if (replies.length > 0) status.textContent = replies[replies.length - 1];
      } finally {
        consoleState.busy = false;
        if (consoleState.rebuilt) {
          // The `> reset` and its `ok` are already in the log; the new
          // session's handshake follows them, as it would a fresh process.
          consoleState.rebuilt = false;
          if (sim.session) consoleHandshake(sim.session);
        }
        refreshConsoleGate();
      }
    }

    consoleForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const line = consoleIn.value;
      consoleIn.value = '';
      void consoleSubmit(line).then(() => {
        if (!consoleIn.disabled) consoleIn.focus();
      });
    });
    consoleIn.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        const next = e.key === 'ArrowUp' ? consoleState.history.up() : consoleState.history.down();
        if (next === null) return;
        e.preventDefault();
        consoleIn.value = next;
        consoleIn.setSelectionRange(next.length, next.length);
      } else if (e.key === 'l' && e.ctrlKey && !e.metaKey && !e.altKey) {
        e.preventDefault();
        consoleClear();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        const empty = consoleIn.value === '';
        consoleIn.value = '';
        consoleState.history.reset();
        if (empty) setDrawerOpen(false);
      }
    });
    // A terminal takes the caret wherever you click in it, unless you are
    // selecting text to copy, or pressing one of its buttons.
    consoleEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('button, input')) return;
      if (!window.getSelection()?.isCollapsed) return;
      if (!consoleIn.disabled) consoleIn.focus();
    });

    // ---- source linking ----
    // `decls` refreshes on every analysis; `table` only when a new artifact is
    // drawn. They are deliberately separate: the last good canvas — and so the
    // table — stays on screen across failing edits while the analysis keeps
    // moving underneath it.
    const link = {
      decls: [] as Declaration[],
      table: null as LinkTable | null,
      current: null as Declaration | null,
    };

    /** Highlight the box a declaration draws as, or clear the highlight. */
    function highlightComponent(decl: Declaration | null) {
      const id = decl && link.table ? (link.table.byName.get(decl.name)?.componentId ?? null) : null;
      sim.view?.view.setHighlight?.(id);
    }

    /** Mark the truth-table column a declaration names. */
    function markTableColumn(decl: Declaration | null) {
      for (const th of tableEl.querySelectorAll<HTMLElement>('th[data-symbol-name]')) {
        th.classList.toggle('pg-th-linked', decl !== null && th.dataset.symbolName === decl.name);
      }
    }

    /**
     * Mark a declaration's span in the editor without moving the caret. A
     * hover must never steal the reader's place, so a declaration in another
     * file is named in the simulate note instead of switching tabs.
     */
    function markInEditor(link_: Pick<SourceLink, 'name' | 'kind'> | null) {
      if (!editor) return;
      if (!link_) {
        editor.setLinkHighlight(null);
        if (state.simulateEnabled) simNote.textContent = simNoteBase;
        return;
      }
      const decl = link.decls.find((d) => d.name === link_.name && d.kind === link_.kind);
      const rootIdx = rootIndex(state.tabs);
      if (!decl || state.tabs.active !== rootIdx) {
        editor.setLinkHighlight(null);
        simNote.textContent = `${link_.name} is declared in ${state.tabs.files[rootIdx]?.name ?? 'the root file'}.`;
        return;
      }
      const files = state.tabs.files;
      const body = files[rootIdx].body;
      const index = indexDoc(body);
      const span = rangeToSpan(
        index,
        [{ name: files[rootIdx].name, body, startLine: 0 }],
        { files: [{ file_id: decl.fileId, path: rootPathFor(files[rootIdx].name) }], diagnostics: [], symbols: [], references: [] } as Analysis,
        decl.fileId,
        decl.range,
      );
      if (!span) {
        editor.setLinkHighlight(null);
        return;
      }
      editor.setLinkHighlight(span);
      simNote.textContent = `${link_.name} — ${decl.kind}`;
    }

    /**
     * Highlight by declared name, from a source that has a name rather than a
     * position — a truth-table header, a diagnostics row. `null` restores
     * whatever the cursor was pointing at, so a passing hover never leaves the
     * reader's own context behind.
     */
    function highlightByName(name: string | null) {
      // The editor's span comes from the declaration; the layout table only
      // adds the box. Before a canvas exists (a page refreshed onto the Truth
      // view) the table is null, and the declaration alone is enough.
      if (name === null) {
        highlightComponent(link.current);
        markInEditor(link.current ? (link.table?.byName.get(link.current.name) ?? link.current) : null);
        markTableColumn(link.current);
        return;
      }
      const decl = link.decls.find((d) => d.name === name) ?? null;
      highlightComponent(decl);
      markInEditor(link.table?.byName.get(name) ?? decl);
      markTableColumn(decl);
    }

    /** One place decides what the cursor is pointing at. */
    function setCurrentDeclaration(decl: Declaration | null) {
      if (decl === link.current) return;
      link.current = decl;
      highlightComponent(decl);
      markTableColumn(decl);
    }

    // ---- the status bar ----
    // One record in, one view out. The label is written only when the state
    // KIND changes, so the bar does not churn per keystroke; the per-keystroke
    // text lives in the non-live detail span, and the separate `.pg-status`
    // span stays the only announcement channel.
    const pipe: StatusInput = {
      ready: false,
      loading: false,
      analyzing: false,
      building: false,
      errors: 0,
      warnings: 0,
      artifactBytes: null,
      stale: false,
      failure: null,
    };
    let lastKind = '';
    function renderStatus() {
      const view = statusFor(pipe);
      if (view.kind !== lastKind) {
        statusLabel.textContent = view.label;
        dot.dataset.state = view.kind;
        lastKind = view.kind;
      }
      statusDetail.textContent = view.detail;
    }

    // ---- persistence ----
    // One key, one envelope. Phase 3 populates layout.ratios only; the other
    // fields ship with their defaults for later phases to fill.
    const store = createStore();
    store.onNote((note) => { status.textContent = describeNote(note); });

    // One rendered position over per-project intent. Resizing only borrows
    // space; a pointer release or an arrow key is what commits a position.
    const dataNarrow = matchMedia('(max-width: 800px)');
    let dataPosition: PanelPos = { x: 0, y: 0 };
    let dataDrag: { pointerId: number; projectId: string; from: PanelPos; start: PanelPos; moved: boolean } | null = null;

    function placeDataPanel(pos?: PanelPos) {
      if (!state.dataOpen) return;
      dataGrip.disabled = dataNarrow.matches;
      if (dataNarrow.matches) {
        dataCard.style.removeProperty('left');
        dataCard.style.removeProperty('top');
        dataCard.style.removeProperty('right');
        return;
      }
      const region = outputPane.getBoundingClientRect();
      const card = dataCard.getBoundingClientRect();
      const id = store.envelope.activeId;
      const intent = pos ?? (dataDrag?.moved ? dataPosition : (id ? store.envelope.dataPanel[id] : undefined) ?? defaultPos(region));
      dataPosition = clampPanel(intent, card, region);
      dataCard.style.left = `${dataPosition.x}px`;
      dataCard.style.top = `${dataPosition.y}px`;
      dataCard.style.right = 'auto';
    }
    function cancelDataDrag() {
      if (!dataDrag) return;
      const id = dataDrag.pointerId;
      dataDrag = null;
      delete dataCard.dataset.dragging;
      try { dataGrip.releasePointerCapture(id); } catch { /* The pointer may already be gone. */ }
      placeDataPanel();
    }
    dataGrip.addEventListener('pointerdown', (e) => {
      const id = store.envelope.activeId;
      if (!id || !state.dataOpen || dataNarrow.matches || dataDrag || e.button !== 0 || e.isPrimary === false) return;
      placeDataPanel();
      dataDrag = { pointerId: e.pointerId, projectId: id, from: { x: e.clientX, y: e.clientY }, start: { ...dataPosition }, moved: false };
      e.preventDefault();
      e.stopPropagation();
      dataGrip.focus();
      try { dataGrip.setPointerCapture(e.pointerId); } catch { /* Synthetic pointers have no capture. */ }
    });
    dataGrip.addEventListener('pointermove', (e) => {
      const drag = dataDrag;
      if (!drag || e.pointerId !== drag.pointerId) return;
      if (dataNarrow.matches) { cancelDataDrag(); return; }
      const point = { x: e.clientX, y: e.clientY };
      if (!drag.moved && !crossedThreshold(drag.from, point)) return;
      drag.moved = true;
      dataCard.dataset.dragging = 'true';
      placeDataPanel(positionFromDrag(drag.start, drag.from, point));
    });
    dataGrip.addEventListener('pointerup', (e) => {
      const drag = dataDrag;
      if (!drag || e.pointerId !== drag.pointerId) return;
      if (drag.moved && drag.projectId === store.envelope.activeId) {
        const pos = { ...dataPosition };
        store.update((draft) => { draft.dataPanel[drag.projectId] = pos; });
      }
      cancelDataDrag();
    });
    for (const event of ['pointercancel', 'lostpointercapture']) dataGrip.addEventListener(event, (e) => {
      if ((e as PointerEvent).pointerId === dataDrag?.pointerId) cancelDataDrag();
    });
    dataGrip.addEventListener('keydown', (e) => {
      if (dataDrag || dataNarrow.matches || e.altKey || e.ctrlKey || e.metaKey) return;
      const delta = e.key === 'ArrowLeft' ? [-1, 0] : e.key === 'ArrowRight' ? [1, 0]
        : e.key === 'ArrowUp' ? [0, -1] : e.key === 'ArrowDown' ? [0, 1] : null;
      const id = store.envelope.activeId;
      if (!delta || !id) return;
      e.preventDefault();
      e.stopPropagation();
      const step = e.shiftKey ? 32 : 8;
      placeDataPanel({ x: dataPosition.x + delta[0] * step, y: dataPosition.y + delta[1] * step });
      const pos = { ...dataPosition };
      store.update((draft) => { draft.dataPanel[id] = pos; });
    });
    const dataResize = new ResizeObserver(() => placeDataPanel());
    dataResize.observe(outputPane);
    dataResize.observe(dataCard);
    dataNarrow.addEventListener('change', () => { cancelDataDrag(); placeDataPanel(); });

    // ---- the workspace ----
    /** Load a project by id. A switch replaces the whole document registry, so
     *  the previous project's text is never one Ctrl-Z away. */
    function loadProject(id: string, opts: { restoreFile?: string | null } = {}) {
      const text = resolveSource(id, catalogue, store.envelope.scratch);
      if (text === null) return false;
      state.tabs = fromSource(text);
      const wanted = opts.restoreFile;
      const index = wanted ? state.tabs.files.findIndex((f) => f.name === wanted) : -1;
      state.tabs = selectTab(state.tabs, index >= 0 ? index : rootIndex(state.tabs));
      source.value = toSource(state.tabs);
      editor?.setDocuments(state.tabs.files.map((f) => f.body), state.tabs.active);
      if (store.envelope.activeId !== id) {
        setDataOpen(false, { focus: false });
        consoleNewSession();
      }
      store.update((draft) => {
        draft.activeId = id;
        draft.activeFile = activeFile(state.tabs).name;
      });
      // Open the group holding what just loaded, and the project itself, so the
      // sidebar always contains the thing the editor is showing. A reader who
      // then shuts it keeps it shut until they switch projects again.
      const opened = reveal(expanded, treeInput(), id);
      if (opened.size !== expanded.size) {
        expanded = opened;
        persistExpanded();
      }
      renderTree({ keepFocusOn: null });
      renderWorkspace();
      schedule();
      return true;
    }

    /** The scratch project whose delete is armed, or null. */
    let confirmProject: string | null = null;

    /** What each join conflict means for the reader, in one line. */
    const CONFLICT_TEXT: Record<string, string> = {
      'blank-body': 'this file is empty, so the next file would merge into it',
      'marker-in-body': 'a `// name.circ` line after code starts a new file here',
      'illegal-name': 'this name cannot be written as a file marker',
      'duplicate-name': 'another file has this name, so one of them is dropped',
    };

    /** Index of the file whose delete is armed, or null. A second Delete (or
     *  the × on the row) removes it; anything else disarms. */
    let confirmIndex: number | null = null;
    let confirmTimer: number | null = null;

    const nowMs = () => Date.now();

    /**
     * Write the current text back to the envelope. A content project is never
     * overwritten: the first edit forks it into a scratch project, which is
     * what keeps a shipped example the shipped example.
     */
    function persistSource() {
      const id = store.envelope.activeId;
      const source = toSource(state.tabs);
      const fileName = activeFile(state.tabs).name;
      if (id && idKind(id) === 'scratch') {
        store.update((draft) => {
          draft.scratch = touchScratch(draft.scratch, id, source, nowMs()).list;
          draft.activeFile = fileName;
        });
        return;
      }
      const label = catalogue.find((c) => c.id === id)?.label ?? 'Untitled';
      let created: string | null = null;
      store.update((draft) => {
        const r = createScratch(draft.scratch, {
          name: label,
          source,
          now: nowMs(),
          keep: draft.activeId,
        });
        if (!r.created) return;
        draft.scratch = r.list;
        draft.activeId = r.created.id;
        draft.activeFile = fileName;
        created = r.created.id;
      });
      if (created) {
        status.textContent = `Copied into your own project so the example stays as it shipped.`;
        renderWorkspace();
      }
    }

    function newProject() {
      let created: string | null = null;
      store.update((draft) => {
        const r = createScratch(draft.scratch, {
          name: uniqueName('Untitled', draft.scratch.map((p) => p.name)),
          source: NEW_PROJECT_SOURCE,
          now: nowMs(),
          keep: draft.activeId,
        });
        if (!r.created) return;
        draft.scratch = r.list;
        created = r.created.id;
      });
      if (created) {
        loadProject(created);
        closeSwitcher();
      }
    }

    /** Import one file through the same store limits as a new project. The
     *  picker stays disabled until its read settles, including a failed read. */
    async function importProject() {
      const file = importPicker.files?.[0];
      if (!file || importPicker.disabled) return;
      importPicker.disabled = true;
      importButton.disabled = true;
      try {
        const source = await file.text();
        const result = createScratch(store.envelope.scratch, {
          name: file.name.replace(/\.circ$/i, '').trim() || 'Untitled',
          source,
          now: nowMs(),
          keep: store.envelope.activeId,
        });
        if (!result.created) {
          status.textContent = describeNote({ kind: 'skipped', names: result.skipped.map((p) => p.name) }, 'import');
          return;
        }
        store.update((draft) => { draft.scratch = result.list; });
        loadProject(result.created.id);
        closeSwitcher();
        status.textContent = `Imported ${file.name}.` + (result.evicted.length
          ? ` ${describeNote({ kind: 'evicted', names: result.evicted.map((p) => p.name) })}` : '');
      } catch {
        status.textContent = `Could not read ${file.name}.`;
      } finally {
        importPicker.value = '';
        importPicker.disabled = false;
        importButton.disabled = false;
      }
    }

    // ---- the workspace explorer ----
    // One tree, three levels: group folders, the projects inside them, and —
    // under the one project the editor holds — its files. It is the only place
    // files live now: the strip that used to sit above the editor carried the
    // active-file indicator and the per-file error badge, and both of those
    // belong next to the project they describe rather than over the text.

    /** Ids of the rows the reader has open. Seeded from the envelope, and
     *  written back on every deliberate toggle. */
    let expanded = new Set(store.envelope.ws.expanded);
    /**
     * What the last analysis said about each project the reader has opened.
     *
     * Only the open project is analysed, so without this a project's badge
     * disappeared the moment you looked at something else — which reads as
     * "the errors are gone" rather than "nobody is looking". Session-scoped on
     * purpose: it is a memory of an analysis, not a cache of one, and it is
     * dropped rather than persisted so a reload never shows a count that no
     * longer has an analysis behind it.
     */
    const remembered = new Map<string, { errors: number; warnings: number }>();
    /** Index into the flattened tree that holds the single tab stop. */
    let treeFocus = 0;
    let treeNodes: readonly TreeNode[] = [];
    let query = '';
    let searchExpanded = new Set<string>();

    /** The tree as data. Rebuilt on every render rather than cached: each of
     *  its inputs — the catalogue, the scratch list, the file set, the
     *  analysis — moves on its own schedule. */
    function treeInput(): TreeInput {
      const groups = displayGroups(countedCatalogue, store.envelope.scratch);
      return {
        groups,
        activeId: store.envelope.activeId,
        files: state.tabs.files,
        activeFile: state.tabs.active,
        counts: countsByFile(state.tabs.files, state.analysis),
        conflicts: new Map(joinConflicts(state.tabs.files).map((c) => [c.index, CONFLICT_TEXT[c.reason]])),
        expanded,
        remembered,
      };
    }

    function persistExpanded() {
      store.update((draft) => { draft.ws.expanded = [...expanded]; });
    }

    /** Open a row and redraw. */
    function expandNode(id: string, open: boolean) {
      if (query.trim()) {
        if (searchExpanded.has(id) === open) return;
        searchExpanded = toggleExpanded(searchExpanded, id);
      } else {
        if (expanded.has(id) === open) return;
        expanded = toggleExpanded(expanded, id);
        persistExpanded();
      }
      renderTree();
    }

    /** The row that should hold the tab stop after a redraw: whatever the
     *  reader was on if it still exists, else the active file, else the active
     *  project. Losing the tab stop into row 0 on every keystroke would make
     *  the tree unusable with a keyboard. */
    function preferredFocus(nodes: readonly TreeNode[], wantedId: string | null): number {
      if (wantedId) {
        const at = nodes.findIndex((n) => n.id === wantedId);
        if (at >= 0) return at;
      }
      const file = nodes.findIndex((n) => n.kind === 'file' && n.active);
      if (file >= 0) return file;
      const project = nodes.findIndex((n) => n.kind === 'project' && n.active);
      return project >= 0 ? project : 0;
    }

    function badgeEl(severity: 'error' | 'warning', count: number): HTMLElement {
      const badge = document.createElement('span');
      badge.className = 'pg-switch-badge';
      badge.dataset.severity = severity;
      badge.textContent = String(count);
      // The accessible name already carries the counts in words.
      badge.setAttribute('aria-hidden', 'true');
      return badge;
    }

    function iconButton(cls: string, glyph: string, label: string, onClick: () => void): HTMLButtonElement {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = cls;
      b.textContent = glyph;
      b.setAttribute('aria-label', label);
      // A real tab stop, unlike the old strip's close control: `treeitem` is
      // not on ARIA's presentational-children list, so a nested button here IS
      // announced. That was the one thing `role=tab` could never allow.
      b.tabIndex = -1;
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        onClick();
      });
      return b;
    }

    /** The breadcrumb names the open project the way the tree does: its
     *  group's label, then its own. Rendered with the tree, which redraws on
     *  every load, rename and duplicate. */
    function renderCrumb() {
      const id = store.envelope.activeId;
      const input = treeInput();
      const group = input.groups.find((g) => g.id === groupOf(input, id))?.label ?? 'Mine';
      crumbGroup.textContent = `${group} /`;
      crumbName.textContent = activeLabel();
    }

    function renderTree(opts: { keepFocusOn?: string | null } = {}) {
      renderCrumb();
      const wantedId = opts.keepFocusOn !== undefined
        ? opts.keepFocusOn
        : (treeNodes[treeFocus]?.id ?? null);
      const input = treeInput();
      // Search also reaches collapsed groups, without saving an expansion the
      // reader never chose. Clearing it restores the original tree.
      if (query.trim()) input.expanded = new Set([
        ...input.groups.map((g) => g.id), ...(input.activeId ? [input.activeId] : []),
      ]);
      treeNodes = filterNodes(visibleNodes(input, nowMs()), query);
      if (query.trim()) {
        let groupOpen = true;
        let projectOpen = true;
        treeNodes = treeNodes.flatMap((node): TreeNode[] => {
          if (node.kind === 'group') {
            groupOpen = searchExpanded.has(node.id);
            return [{ ...node, expanded: groupOpen }];
          }
          if (!groupOpen) return [];
          if (node.kind === 'project') {
            projectOpen = node.expandable && searchExpanded.has(node.id);
            return [{ ...node, expanded: projectOpen }];
          }
          return projectOpen ? [node] : [];
        });
      }
      treeFocus = preferredFocus(treeNodes, wantedId);

      const tree = document.createElement('div');
      tree.className = 'pg-switch-tree';
      tree.setAttribute('role', 'tree');
      tree.setAttribute('aria-label', 'Projects and files');

      treeNodes.forEach((node, i) => {
        const row = document.createElement('div');
        row.className = `pg-switch-row pg-switch-${node.kind}`;
        row.setAttribute('role', 'treeitem');
        row.setAttribute('aria-level', String(node.level));
        row.dataset.node = node.id;
        row.dataset.index = String(i);
        row.style.setProperty('--depth', String(node.level - 1));
        // Roving tabindex: one stop for the whole tree.
        row.tabIndex = i === treeFocus ? 0 : -1;

        const parts: string[] = [node.label];

        if (node.kind === 'group') {
          row.setAttribute('aria-expanded', String(node.expanded));
          parts.push(`${node.count} project${node.count === 1 ? '' : 's'}`);
        }

        // The twisty. Always present on an openable row, always absent
        // otherwise: a disabled-looking triangle that does nothing is worse
        // than the indent alone.
        const twisty = document.createElement('span');
        twisty.className = 'pg-switch-twisty';
        twisty.setAttribute('aria-hidden', 'true');
        const openable = node.kind === 'group' || (node.kind === 'project' && node.expandable);
        twisty.textContent = openable ? (node.expanded ? '▾' : '▸') : '';
        if (node.kind !== 'group') row.appendChild(twisty);

        const name = document.createElement('span');
        name.className = 'pg-switch-label';
        name.textContent = node.label;
        row.appendChild(name);
        if (node.kind === 'group') row.appendChild(twisty);

        if (node.kind === 'project') {
          row.dataset.pick = node.id;
          if (node.expandable) row.setAttribute('aria-expanded', String(node.expanded));
          if (node.active) {
            row.setAttribute('aria-current', 'true');
            parts.push('open');
          }
          if (node.severity) {
            row.appendChild(badgeEl(node.severity, node.badge));
            parts.push(`${node.badge} ${node.severity}${node.badge === 1 ? '' : 's'}`);
          } else {
            const meta = document.createElement('span');
            meta.className = 'pg-switch-meta';
            meta.textContent = node.meta;
            row.appendChild(meta);
            parts.push(node.meta);
          }
          if (node.editable) {
            const actions = document.createElement('span');
            actions.className = 'pg-switch-actions';
            const id = node.id;
            const label = node.label;
            actions.appendChild(iconButton('pg-switch-action', '✎', `Rename ${label}`, () => startRenameProject(id)));
            actions.appendChild(
              iconButton('pg-switch-action', '⧉', `Duplicate ${label}`, () => duplicateProject(id)),
            );
            const del = iconButton('pg-switch-action', '×', `Delete ${label}`, () => armOrDeleteProject(id));
            if (confirmProject === id) {
              del.dataset.confirm = 'true';
              del.setAttribute('aria-label', `Delete ${label}? Activate again to confirm`);
            }
            actions.appendChild(del);
            row.appendChild(actions);
          }
          if (node.active) {
            const add = iconButton('pg-switch-action pg-switch-add', '＋', 'Add a file', addNewFile);
            row.appendChild(add);
          }
        }

        if (node.kind === 'file') {
          row.dataset.index = String(i);
          row.dataset.file = String(node.index);
          if (node.active) {
            row.setAttribute('aria-selected', 'true');
            row.setAttribute('aria-current', 'true');
          }
          if (node.root) {
            const chip = document.createElement('span');
            chip.className = 'pg-switch-root';
            chip.textContent = 'root';
            chip.setAttribute('aria-hidden', 'true');
            row.appendChild(chip);
            parts.push('root file');
          }
          if (node.severity) {
            row.appendChild(badgeEl(node.severity, node.badge));
            parts.push(`${node.badge} ${node.severity}${node.badge === 1 ? '' : 's'}`);
          } else {
            parts.push('no diagnostics');
          }
          if (node.conflict) {
            const mark = document.createElement('span');
            mark.className = 'pg-switch-conflict';
            mark.textContent = '⚠';
            mark.setAttribute('aria-hidden', 'true');
            row.appendChild(mark);
            parts.push(`unsaveable: ${node.conflict}`);
          }
          const fileIndex = node.index;
          const armed = confirmIndex === fileIndex;
          if (armed) row.dataset.confirm = 'true';
          // Same shape as a project row's controls, so a file is renamed the
          // way a project is rather than only through F2 — which is reachable
          // but undiscoverable, and unusable without a keyboard.
          const fileActions = document.createElement('span');
          fileActions.className = 'pg-switch-actions';
          fileActions.appendChild(
            iconButton('pg-switch-action', '✎', `Rename ${node.label}`, () => startRename(fileIndex)),
          );
          fileActions.appendChild(
            iconButton('pg-switch-action', '×', `Delete ${node.label}`, () => armOrDelete(fileIndex)),
          );
          row.appendChild(fileActions);

          // Pointer reorder, an enhancement over Alt+Arrow and never the only
          // path: a drag is impossible with a keyboard.
          row.draggable = true;
          row.addEventListener('dragstart', (e) => {
            e.dataTransfer?.setData('text/plain', String(fileIndex));
            if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
          });
          row.addEventListener('dragover', (e) => {
            e.preventDefault();
            if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
            row.dataset.drop = 'true';
          });
          row.addEventListener('dragleave', () => { delete row.dataset.drop; });
          row.addEventListener('drop', (e) => {
            e.preventDefault();
            delete row.dataset.drop;
            const from = Number(e.dataTransfer?.getData('text/plain'));
            if (Number.isInteger(from)) reorder(from, fileIndex);
          });
          if (armed) {
            parts.length = 0;
            parts.push(`Delete ${node.label}? Press Delete again to confirm`);
          }
        }

        row.setAttribute('aria-label', parts.join(', '));
        row.addEventListener('click', () => activate(i));
        tree.appendChild(row);

        // An open folder with nothing in it says so, rather than looking like
        // a row that failed to render. Only "Yours" can be empty today.
        if (node.kind === 'group' && node.expanded && node.count === 0) {
          const empty = document.createElement('div');
          empty.className = 'pg-switch-empty';
          empty.textContent = 'Edit an example to start your own.';
          tree.appendChild(empty);
        }
      });

      wsBody.querySelector('.pg-switch-tree')?.remove();
      wsBody.querySelector('.pg-switch-fallback')?.remove();
      wsBody.insertBefore(tree, wsError);
      if (treeNodes.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'pg-switch-empty';
        empty.textContent = 'No circuits found.';
        tree.appendChild(empty);
      }

      // One line naming the first file that cannot be written back, so the
      // reader learns why a row is marked rather than only that it is.
      const first = joinConflicts(state.tabs.files)[0];
      wsError.textContent = first
        ? `${state.tabs.files[first.index].name}: ${CONFLICT_TEXT[first.reason]}`
        : '';

      const activeRow = tree.querySelector<HTMLElement>('.pg-switch-file[aria-current="true"]');
      if (activeRow) activeRow.id = `pg-switch-file-${state.tabs.active}`;
      // The strip reads the same state, and the editor panel is labelled by
      // its current tab.
      renderFileTabs();
    }

    // ---- the file strip ----
    /** One tab per file, in order, the active one selected and the only tab
     *  stop; rebuilt whole, since a strip of a handful of names is cheap. */
    function renderFileTabs() {
      for (const old of filesEl.querySelectorAll('.pg-file')) old.remove();
      state.tabs.files.forEach((f, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'pg-file';
        b.setAttribute('role', 'tab');
        b.id = `pg-file-${i}`;
        b.dataset.file = String(i);
        const active = i === state.tabs.active;
        b.setAttribute('aria-selected', String(active));
        b.setAttribute('aria-controls', 'pg-editor-panel');
        b.tabIndex = active ? 0 : -1;
        b.textContent = f.name;
        b.addEventListener('click', () => showFile(i));
        filesEl.insertBefore(b, fileAdd);
      });
      editorWrap.setAttribute('aria-labelledby', `pg-file-${state.tabs.active}`);
    }
    filesEl.addEventListener('keydown', (e) => {
      const at = state.tabs.active;
      const last = state.tabs.files.length - 1;
      const next =
        e.key === 'ArrowLeft' ? Math.max(0, at - 1)
        : e.key === 'ArrowRight' ? Math.min(last, at + 1)
        : e.key === 'Home' ? 0
        : e.key === 'End' ? last
        : null;
      if (next === null || !(e.target as HTMLElement).classList.contains('pg-file')) return;
      e.preventDefault();
      showFile(next);
    });
    fileAdd.addEventListener('click', addNewFile);

    /** Kept for the callers that predate the tree; the tree is the workspace. */
    const renderWorkspace = renderTree;

    function focusNode(index: number) {
      treeFocus = Math.max(0, Math.min(index, treeNodes.length - 1));
      for (const row of wsBody.querySelectorAll<HTMLElement>('.pg-switch-row')) {
        row.tabIndex = Number(row.dataset.index) === treeFocus ? 0 : -1;
      }
      const row = wsBody.querySelector<HTMLElement>(`.pg-switch-row[data-index="${treeFocus}"]`);
      row?.focus();
      row?.scrollIntoView({ block: 'nearest' });
    }

    /** Focus the row showing file `index`, which is what every file operation
     *  wants afterwards. */
    /** Focus follows the file: into the tree's row while the card is open (a
     *  rename or a delete there keeps the reader where they were), else onto
     *  the strip's tab. */
    function focusFileTab(index: number) {
      if (!wsRoot.hidden) {
        const at = treeNodes.findIndex((n) => n.kind === 'file' && n.index === index);
        if (at >= 0) { focusNode(at); return; }
      }
      filesEl.querySelector<HTMLElement>(`.pg-file[data-file="${index}"]`)?.focus();
    }

    /** Enter, Space, or a click. A folder toggles; a project loads; a file
     *  opens in the editor. */
    function activate(index: number) {
      const node = treeNodes[index];
      if (!node) return;
      treeFocus = index;
      if (node.kind === 'group') {
        expandNode(node.id, !node.expanded);
        focusNode(index);
        return;
      }
      if (node.kind === 'project') {
        disarm();
        confirmProject = null;
        if (node.active && node.expandable) {
          // Already open: the click is about its files, not about loading it
          // again, so it works the twisty.
          expandNode(node.id, !node.expanded);
          focusNode(index);
          return;
        }
        loadProject(node.id);
        closeSwitcher();
        return;
      }
      showFile(node.index);
      closeSwitcher();
    }

    wsBody.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      // Nested controls own Enter and Space. Tab reaches the focused row's
      // actions; arrows, F2 and Delete remain the tree's shortcuts.
      if (target.closest('button, input')) return;
      const row = target.closest<HTMLElement>('.pg-switch-row');
      if (!row) return;
      const index = Number(row.dataset.index);
      const node = treeNodes[index];
      if (!node) return;

      // Alt+Arrow moves a FILE. Checked before the plain arrows and always
      // prevented: Alt+ArrowLeft is Back on Windows and Linux, and losing the
      // page mid-edit would cost the reader real work.
      if (e.altKey && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
        e.preventDefault();
        if (node.kind === 'file') reorder(node.index, node.index + (e.key === 'ArrowDown' ? 1 : -1));
        return;
      }

      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activate(index);
        return;
      }
      if (e.key === 'F2') {
        e.preventDefault();
        if (node.kind === 'file') startRename(node.index);
        else if (node.kind === 'project' && node.editable) startRenameProject(node.id);
        return;
      }
      if (e.key === 'Delete' || e.key === 'Backspace') {
        e.preventDefault();
        if (node.kind === 'file') armOrDelete(node.index);
        else if (node.kind === 'project' && node.editable) armOrDeleteProject(node.id);
        return;
      }
      if (e.key === 'Escape') {
        e.preventDefault();
        confirmProject = null;
        disarm();
        return;
      }

      const move = moveFor(treeNodes, index, e.key as TreeKey);
      if (!move) return;
      // Only consumed keys are prevented: Home and End must still work inside
      // a rename input, and the arrows must still move the caret in the editor.
      e.preventDefault();
      if (move.kind === 'focus') focusNode(move.index);
      else {
        expandNode(move.id, move.kind === 'expand');
        focusNode(treeFocus);
      }
    });

    // ---- project operations ----
    function duplicateProject(id: string) {
      let created: string | null = null;
      store.update((draft) => {
        const r = duplicateScratch(draft.scratch, id, { now: nowMs() });
        if (!r || !r.created) return;
        draft.scratch = r.list;
        created = r.created.id;
      });
      if (created) loadProject(created);
    }

    function armOrDeleteProject(id: string) {
      const name = store.envelope.scratch.find((p) => p.id === id)?.name ?? id;
      // Two presses, as for a file: a project is not undoable.
      if (confirmProject !== id) {
        confirmProject = id;
        status.textContent = `Delete ${name}? Activate the × again to confirm.`;
        renderTree();
        return;
      }
      confirmProject = null;
      const wasActive = store.envelope.activeId === id;
      remembered.delete(id);
      store.update((draft) => {
        draft.scratch = deleteScratch(draft.scratch, id);
        if (wasActive) draft.activeId = null;
      });
      status.textContent = `Deleted ${name}.`;
      if (wasActive) loadProject(el.dataset.defaultPick ?? catalogue[0].id);
      else renderTree({ keepFocusOn: null });
    }

    /** Swaps the row's label for an input. Escape reverts; a blur commits. */
    function startRenameProject(id: string) {
      const current = store.envelope.scratch.find((p) => p.id === id);
      const row = wsBody.querySelector<HTMLElement>(`.pg-switch-row[data-node="${CSS.escape(id)}"]`);
      const nameEl = row?.querySelector<HTMLElement>('.pg-switch-label');
      if (!current || !row || !nameEl) return;
      const input = document.createElement('input');
      input.className = 'pg-switch-input';
      input.value = current.name;
      input.setAttribute('aria-label', 'Project name');
      let done = false;
      const finish = (commit: boolean) => {
        if (done) return;
        done = true;
        if (commit && input.value.trim() !== '') {
          store.update((draft) => { draft.scratch = renameScratch(draft.scratch, id, input.value); });
        }
        renderTree({ keepFocusOn: id });
        focusNode(treeFocus);
      };
      input.addEventListener('keydown', (e) => {
        e.stopPropagation();
        if (e.key === 'Enter') { e.preventDefault(); finish(true); }
        else if (e.key === 'Escape') { e.preventDefault(); finish(false); }
      });
      input.addEventListener('blur', () => finish(true));
      nameEl.replaceWith(input);
      input.focus();
      input.select();
    }

    wsNew.addEventListener('click', newProject);
    importButton.addEventListener('click', () => importPicker.click());
    importPicker.addEventListener('change', importProject);
    switchQuery.addEventListener('input', () => {
      query = switchQuery.value;
      const input = treeInput();
      searchExpanded = new Set([
        ...expanded, ...input.groups.map((g) => g.id), ...(input.activeId ? [input.activeId] : []),
      ]);
      renderTree();
    });
    switchQuery.addEventListener('keydown', (e) => {
      if (e.isComposing || (e.key !== 'ArrowDown' && e.key !== 'Enter')) return;
      e.preventDefault();
      const matches = treeNodes.filter((n) => n.kind === 'project');
      if (e.key === 'Enter' && matches.length === 1) {
        loadProject(matches[0].id);
        closeSwitcher();
      }
      else focusNode(0);
    });

    // ---- the workspace card ----
    // The tree opens under the breadcrumb and closes on Escape, on a click
    // outside it, or on the breadcrumb again; focus goes back to the button
    // it came from. Nothing else on the bench moves when it opens.
    function openSwitcher() {
      setSwitcherOpen(true);
      switchQuery.focus();
      switchQuery.select();
    }
    function closeSwitcher(opts: { focus?: boolean } = {}) { setSwitcherOpen(false, opts); }
    function setSwitcherOpen(open: boolean, opts: { focus?: boolean } = {}) {
      if (open === !wsRoot.hidden) return;
      crumb.setAttribute('aria-expanded', String(open));
      crumbChevron.textContent = open ? '▴' : '▾';
      wsRoot.hidden = !open;
      scrim.hidden = !open;
      if (open) {
        renderTree();
        document.addEventListener('pointerdown', onOutsidePointer, true);
        document.addEventListener('keydown', onSwitcherKey, true);
      } else {
        document.removeEventListener('pointerdown', onOutsidePointer, true);
        document.removeEventListener('keydown', onSwitcherKey, true);
        query = '';
        switchQuery.value = '';
        renderTree();
        if (opts.focus !== false) crumb.focus();
      }
    }
    function onOutsidePointer(e: Event) {
      const t = e.target as Node | null;
      if (t && (wsRoot.contains(t) || crumb.contains(t))) return;
      closeSwitcher({ focus: t === scrim || wsRoot.contains(document.activeElement) });
    }
    function onSwitcherKey(e: KeyboardEvent) {
      if (e.key !== 'Escape') return;
      // A rename input owns its own Escape; the card closes on the next one.
      if ((e.target as HTMLElement | null)?.classList.contains('pg-switch-input')) return;
      e.preventDefault();
      e.stopPropagation();
      closeSwitcher();
    }
    crumb.addEventListener('click', () => wsRoot.hidden ? openSwitcher() : closeSwitcher());
    scrim.addEventListener('click', () => closeSwitcher());
    const nav = el.querySelector<HTMLElement>('.pg-nav')!;
    new ResizeObserver(() => {
      const height = nav.getBoundingClientRect().height;
      if (height > 0) el.style.setProperty('--pg-nav-h', `${height}px`);
    }).observe(nav);
    document.addEventListener('keydown', (e) => {
      if (e.isComposing || e.altKey || e.shiftKey || !(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'k') return;
      const target = e.target as HTMLElement | null;
      if (target?.closest('input, textarea') && target !== switchQuery && !target.closest('.pg-cm')) return;
      e.preventDefault();
      openSwitcher();
    });
    // The popover is non-modal. Leaving it by Tab closes it without stealing
    // focus from the next bench control.
    wsRoot.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !wsRoot.contains(next) && !crumb.contains(next)) closeSwitcher({ focus: false });
    });
    wsBody.addEventListener('focusin', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.pg-switch-row');
      if (!row) return;
      treeFocus = Number(row.dataset.index);
      for (const candidate of wsBody.querySelectorAll<HTMLElement>('.pg-switch-row')) {
        const active = candidate === row;
        candidate.tabIndex = active ? 0 : -1;
        for (const action of candidate.querySelectorAll<HTMLButtonElement>('button')) action.tabIndex = active ? 0 : -1;
      }
    });

    // ---- share ----
    /** Copy `text`, or fall back to a focused read-only input the reader can
     *  select. Never leaves the button pending. */
    async function copyText(text: string): Promise<boolean> {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const input = document.createElement('input');
        input.className = 'pg-share-fallback';
        input.readOnly = true;
        input.value = text;
        navActions.appendChild(input);
        input.focus();
        input.select();
        input.addEventListener('blur', () => input.remove(), { once: true });
        return false;
      }
    }

    /** Flash a button's label for a moment — "Copied", "Saved" — then put it
     *  back. The status line carries the full sentence; this is the glance. */
    function flash(button: HTMLButtonElement, text: string, state: 'done' | 'failed' = 'done') {
      const label = button.querySelector<HTMLElement>('.pg-action-label');
      if (!label) return;
      const was = label.textContent;
      label.textContent = text;
      button.dataset.state = state;
      window.setTimeout(() => {
        label.textContent = was;
        delete button.dataset.state;
      }, 1600);
    }

    shareBtn.addEventListener('click', async () => {
      if (shareBtn.disabled) return;
      shareBtn.disabled = true;
      try {
        const source = toSource(state.tabs);
        const result = await encodeShare(source, webStreamsCodec());
        if (!result.ok) {
          // Past the cap the link is useless, so offer the thing that is not.
          const copied = await copyText(source);
          flash(shareBtn, copied ? 'Source copied' : 'Too long', copied ? 'done' : 'failed');
          status.textContent = copied
            ? `Too long to put in a link (${result.chars} characters, limit ${result.cap}); the source is on your clipboard.`
            : `Too long to put in a link (${result.chars} characters, limit ${result.cap}); the source is selected below.`;
          return;
        }
        const link = shareUrl(location.href, result.fragment);
        // A phone has a share sheet, and a link is what it is for; a desktop
        // reader wants the link on the clipboard, where the sheet would only
        // be in the way. Dismissing the sheet is not a failure.
        const sheet = typeof navigator.share === 'function' && matchMedia('(pointer: coarse)').matches;
        if (sheet) {
          try {
            await navigator.share({ title: `${activeLabel()} — circ`, url: link });
            flash(shareBtn, 'Shared');
            status.textContent = `Link shared (${result.chars} characters).`;
            return;
          } catch (err) {
            if ((err as { name?: string }).name === 'AbortError') return;
            // Anything else falls through to the clipboard.
          }
        }
        const copied = await copyText(link);
        flash(shareBtn, copied ? 'Copied' : 'Select below', copied ? 'done' : 'failed');
        status.textContent = copied
          ? `Link copied (${result.chars} characters).`
          : 'Link selected below — copy it with your keyboard.';
      } finally {
        shareBtn.disabled = false;
      }
    });

    // ---- download ----
    /** The name the tree shows for the open project: an example's title, a
     *  scratch project's name. */
    function activeLabel(): string {
      const id = store.envelope.activeId;
      if (!id) return 'circuit';
      if (idKind(id) === 'scratch') return store.envelope.scratch.find((p) => p.id === id)?.name ?? 'circuit';
      return catalogue.find((c) => c.id === id)?.label ?? 'circuit';
    }

    /**
     * The button follows the artifact: disabled with no build, and with a
     * build it says what it would save and whether the source has moved on
     * since. Called wherever the artifact or its staleness changes.
     */
    function refreshActions() {
      const a = state.artifact;
      downloadBtn.disabled = !a;
      // The button says what it would save: the artifact's name, and its
      // size beside it in the muted tone. With no build it is the bare verb.
      downloadLabel.textContent = a ? artifactFileName(activeLabel()) : 'Download';
      downloadMeta.textContent = a ? formatBytes(a.size) : '';
      downloadBtn.title = !a
        ? 'Compile a circuit first'
        : state.stale
          ? `Download the last good build, ${artifactFileName(activeLabel())} (${formatBytes(a.size)}) — the source has changed since it was built`
          : `Download ${artifactFileName(activeLabel())} (${formatBytes(a.size)})`;
      if (state.stale && a) downloadBtn.dataset.stale = '';
      else delete downloadBtn.dataset.stale;
    }

    /** Hand the reader a file through a Blob link, revoked after the click. */
    function downloadBytes(name: string, bytes: Uint8Array, type: string) {
      // A copy, not a view: a worker-transferred buffer or a runtime's staging
      // buffer may be replaced while the download is still being written.
      const blob = new Blob([bytes.slice() as BlobPart], { type });
      const href = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = href;
      link.download = name;
      link.hidden = true;
      // In the document for the click, so the page's own listeners see it.
      navActions.appendChild(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(href), 1000);
    }

    downloadBtn.addEventListener('click', () => {
      const a = state.artifact;
      if (!a) return;
      const name = artifactFileName(activeLabel());
      downloadBytes(name, a.bytes, 'application/wasm');
      flash(downloadBtn, 'Saved');
      status.textContent = state.stale
        ? `Saved ${name} (${formatBytes(a.size)}) from the last good build; the source has changed since.`
        : `Saved ${name} (${formatBytes(a.size)}).`;
    });
    hooks.refreshActions = refreshActions;

    // ---- settings ----
    const settings = () => store.envelope.settings;
    /** The reader's ROM text, per memory. Session state: an image can be
     *  megabytes once hex-encoded, far past what the envelope may hold. */
    const romImages = new Map<string, string>();
    const currentRoms = (): MemorySymbol[] => {
      const a = state.analysis;
      if (!a) return [];
      return romSymbols(a.symbols, rootFileId(a.files, rootPathFor(rootOf(state.tabs.files).name)));
    };
    const preloads = () => preloadsFor(romImages, currentRoms());

    // ---- the memory panel ----
    // A rom or ram keeps its contents as RUNTIME STATE: the artifact carries
    // the shape and nothing else, so everything shown here is read back from a
    // running circuit one word at a time. That is also why the tab only exists
    // when something is declared — for a circuit with no memory there is not
    // an empty table to show, there is nothing at all.

    /** How many words one page of the dump holds, and how many per row. */
    const MEM_PAGE = 64;
    const MEM_PER_ROW = 8;
    /** Where each memory's dump is scrolled to, by declared name. */
    const memWindows = new Map<string, number>();
    /** Addresses holding a zero the reader never typed, per rom. The image
     *  cannot tell a chosen zero from a gap it had to fill, so the distinction
     *  is carried beside it. */
    const romImplied = new Map<string, Set<number>>();
    /** Roms whose hex escape hatch is showing. */
    const hexOpen = new Set<string>();
    const imageFiles = new Map<string, { text: string; file: string }>();

    /** The running circuit's runtime, or null when nothing is simulating or
     *  the artifact predates memories. Contents can be read whenever a
     *  session exists, whichever face built it. */
    function memHost(): CircRuntime | null {
      const rt = sim.session?.runtime as CircRuntime | undefined;
      return rt && rt.hasMemory ? rt : null;
    }

    /** The id of a declared memory in the running circuit, from the runtime's
     *  own list and checked against the analysis's shape, so a drifted
     *  artifact reads nothing rather than reading the wrong memory. */
    function memIdOf(mem: MemorySymbol): number | null {
      const host = memHost();
      if (!host) return null;
      const found = host.memories().find(
        (m) => m.name === mem.name && m.info.width === mem.width && m.info.addrWidth === mem.addrWidth,
      );
      return found ? found.id : null;
    }

    function readCell(host: CircRuntime, id: number, addr: number): Cell {
      return host.readMemWord(id, addr);
    }

    /** The tab appears and disappears with the declared set. */
    function updateMemColumn() {
      const mems = currentRoms();
      drawer.toggleAttribute('data-mem', mems.length > 0);
      memColumn.hidden = drawerRule.hidden = mems.length === 0;
      memColumn.setAttribute('aria-label', `Memory, ${mems.length} declared`);
      termMem.setAttribute('aria-disabled', String(mems.length === 0));
    }

    /** True only when the memory dump is actually on screen. Every visible
     *  word is a call across the wasm boundary, so nothing reads one otherwise. */
    function memVisible(): boolean {
      return !term.hidden && term.dataset.open === 'true' && drawer.hasAttribute('data-mem');
    }

    /** Rebuild the whole panel. Cheap: the number of declared memories is
     *  small, and only one page of one memory is ever read. */
    function renderMemory(opts: { force?: boolean } = {}) {
      updateMemColumn();
      const mems = currentRoms();
      if (mems.length === 0) {
        memPanel.innerHTML = '';
        return;
      }
      if (!memVisible()) return;
      // Typing in the hex box must not destroy the box being typed into, so a
      // rebuild is skipped while a TEXT FIELD inside the panel has focus and
      // nothing structural changed. `force` overrides that, and every path
      // that changes contents uses it: after a cell edit the focus is still
      // inside the panel, and skipping there would swallow the edit that was
      // just made.
      const signature = mems.map((m) => `${m.name}:${m.kind}:${m.width}:${m.addrWidth}`).join('|');
      const active = document.activeElement;
      // Only a field that is being TYPED INTO can be destroyed mid-keystroke.
      // This used to say "any INPUT", which included the checkbox that opens
      // the hex editor — so the click that ticked it also suppressed the
      // redraw that was supposed to show what it opened, and it did nothing.
      const typing = active !== null
        && memPanel.contains(active)
        && (active.tagName === 'TEXTAREA'
          || (active.tagName === 'INPUT' && (active as HTMLInputElement).type === 'text'));
      if (!opts.force && memPanel.dataset.signature === signature && typing) {
        for (const mem of mems) updateRomStatus(mem);
        return;
      }
      memPanel.dataset.signature = signature;
      memPanel.innerHTML = '';
      for (const mem of mems) memPanel.appendChild(renderOneMemory(mem));
    }

    /**
     * What each address holds, and where that came from.
     *
     * One grid serves both jobs the panel used to split between a textarea and
     * a dump. A running circuit is the truth when there is one; otherwise a rom
     * shows its pending image, and a ram shows nothing, because a ram has no
     * image and its contents do not exist until it runs.
     */
    function cellsFor(mem: MemorySymbol): {
      read: (addr: number) => Cell;
      live: boolean;
      editable: boolean;
      note: string | null;
    } {
      const host = memHost();
      const id = host ? memIdOf(mem) : null;
      if (host && id !== null) {
        return {
          read: (addr) => readCell(host, id, addr),
          live: true,
          editable: true,
          note: null,
        };
      }
      if (mem.kind === 'ram') {
        return {
          read: () => ({ value: 0n, defined: 0n }),
          live: false,
          editable: false,
          note: 'A ram holds nothing until the circuit runs. Open Live to fill it.',
        };
      }
      const cells = imageCells(romImages.get(mem.name) ?? '', mem);
      if (!cells.ok) {
        return { read: () => ({ value: 0n, defined: 0n }), live: false, editable: false, note: cells.message };
      }
      const mask = maskFor(mem.width);
      return {
        read: (addr) => {
          const word = cells.cells[addr];
          return word === null ? { value: 0n, defined: 0n } : { value: word, defined: mask };
        },
        live: false,
        editable: true,
        note: 'Not running: this is the image that will be loaded. Open Live to watch it.',
      };
    }

    function renderOneMemory(mem: MemorySymbol): HTMLElement {
      const total = maxWords(mem.addrWidth);
      const source = cellsFor(mem);
      const wrap = document.createElement('section');
      wrap.className = 'pg-mem-item';
      wrap.dataset.name = mem.name;

      const head = document.createElement('div');
      head.className = 'pg-mem-head';
      const label = document.createElement('span');
      label.className = 'pg-mem-tab';
      label.textContent = 'Memory';
      head.appendChild(label);
      const title = document.createElement('h3');
      title.className = 'pg-mem-name';
      title.textContent = mem.name;
      head.appendChild(title);
      const shape = document.createElement('span');
      shape.className = 'pg-mem-shape';
      shape.textContent = memoryHeader(mem, total);
      head.appendChild(shape);
      const live = document.createElement('span');
      live.className = 'pg-mem-live';
      live.dataset.live = String(source.live);
      live.textContent = source.live ? 'live' : 'not running';
      head.appendChild(live);
      const base = document.createElement('div');
      base.className = 'pg-mem-base';
      base.setAttribute('role', 'radiogroup');
      base.setAttribute('aria-label', `${mem.name} value base`);
      for (const [value, text] of [['hex', 'hex'], ['binary', 'bin'], ['decimal', 'dec']]) {
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'radio'; input.name = `pg-mem-base-${mem.name}`;
        input.dataset.setting = 'valueFormat'; input.value = value;
        input.checked = settings().valueFormat === value;
        input.setAttribute('aria-label', value);
        const span = document.createElement('span'); span.textContent = text;
        label.append(input, span); base.appendChild(label);
      }
      head.appendChild(base);
      wrap.appendChild(head);

      // --- the grid, which is now the editor as well as the view
      const win = clampWindow(memWindows.get(mem.name) ?? 0, MEM_PAGE, total);
      const gridError = document.createElement('p');
      gridError.className = 'pg-mem-error';
      gridError.id = memErrorId(mem);
      gridError.setAttribute('role', 'alert');

      // --- controls
      const controls = document.createElement('div');
      controls.className = 'pg-mem-tools';
      controls.appendChild(pageNav(mem, win, total));

      const buttons = document.createElement('div');
      buttons.className = 'pg-mem-buttons';
      const clear = document.createElement('button');
      clear.type = 'button';
      clear.className = 'pg-mem-btn';
      clear.dataset.mem = 'clear';
      clear.textContent = 'Clear';
      clear.title = mem.kind === 'rom'
        ? 'Empty the image, so every word is unknown again'
        : 'Make every word unknown again';
      clear.disabled = mem.kind === 'ram' && !source.live;
      clear.addEventListener('click', () => clearMemory(mem));
      buttons.appendChild(clear);

      {
        const refresh = document.createElement('button');
        refresh.type = 'button';
        refresh.className = 'pg-mem-btn';
        refresh.dataset.mem = 'refresh';
        refresh.disabled = !source.live;
        refresh.textContent = 'Refresh';
        refresh.title = 'Read the contents again';
        refresh.addEventListener('click', () => renderMemory({ force: true }));
        buttons.prepend(refresh);
      }

      // The image the running circuit holds, as the raw file `--sim`'s `save`
      // writes: `value & defined` per word, every word of the address space.
      const save = document.createElement('button');
      save.type = 'button';
      save.className = 'pg-mem-btn pg-mem-save';
      save.dataset.mem = 'save';
      save.textContent = 'Save';
      save.title = source.live
        ? `Download ${mem.name}.bin, every word as the circuit holds it`
        : 'Open Live or Data to save what the circuit holds';
      save.disabled = !source.live;
      save.addEventListener('click', () => saveMemoryImage(mem));

      if (mem.kind === 'rom') {
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'pg-mem-btn pg-mem-load';
        toggle.dataset.mem = 'load';
        toggle.textContent = 'Load image…';
        toggle.setAttribute('aria-expanded', String(hexOpen.has(mem.name)));
        toggle.addEventListener('click', () => {
          if (!hexOpen.delete(mem.name)) hexOpen.add(mem.name);
          renderMemory({ force: true });
          memPanel.querySelector<HTMLButtonElement>(`.pg-mem-item[data-name="${CSS.escape(mem.name)}"] .pg-mem-load`)?.focus();
        });
        buttons.appendChild(toggle);
      }
      buttons.appendChild(save);
      controls.appendChild(buttons);
      wrap.appendChild(controls);
      wrap.appendChild(gridTable(mem, source, win));
      wrap.appendChild(gridError);
      const legend = document.createElement('p');
      legend.className = 'pg-mem-legend';
      const host = source.live ? memHost() : null;
      const memId = host ? memIdOf(mem) : null;
      legend.textContent = legendFor(mem, host && memId !== null ? addressedWord(host, memId) : null);
      wrap.appendChild(legend);
      if (source.note) {
        const note = document.createElement('p');
        note.className = 'pg-mem-idle'; note.textContent = source.note; wrap.appendChild(note);
      }
      if (mem.kind === 'rom' && hexOpen.has(mem.name)) wrap.appendChild(hexEditor(mem));

      const meta = document.createElement('div');
      meta.className = 'pg-rom-meta pg-mem-image';
      if (mem.kind === 'ram') meta.textContent = imageLine(mem, null);
      wrap.appendChild(meta);
      const err = document.createElement('div');
      err.className = 'pg-rom-error';
      wrap.appendChild(err);

      if (mem.kind === 'rom') updateRomStatus(mem, wrap);
      return wrap;
    }

    /** The hex textarea and the file picker, both writing the same image. */
    function hexEditor(mem: MemorySymbol): HTMLElement {
      const holder = document.createElement('div');
      holder.className = 'pg-mem-hex';

      const boxId = `pg-rom-${mem.name}`;
      const label = document.createElement('label');
      label.className = 'pg-mem-imglabel';
      label.htmlFor = boxId;
      label.textContent = 'Image, hex bytes, little-endian';
      holder.appendChild(label);

      const box = document.createElement('textarea');
      box.id = boxId;
      box.className = 'pg-rom-box';
      box.spellcheck = false;
      box.value = romImages.get(mem.name) ?? '';
      box.placeholder = `${(mem.width + 7) >> 3} byte${(mem.width + 7) >> 3 === 1 ? '' : 's'} per word`;
      box.addEventListener('input', () => {
        setImage(mem, box.value, new Set(), { redraw: false });
        updateRomStatus(mem);
      });
      // Typing hex and then leaving redraws the grid against the new image.
      box.addEventListener('change', () => renderMemory({ force: true }));
      holder.appendChild(box);

      const file = document.createElement('input');
      file.type = 'file';
      file.className = 'pg-mem-file';
      file.setAttribute('aria-label', `Load a binary image into ${mem.name}`);
      file.addEventListener('change', () => {
        const chosen = file.files?.[0];
        if (!chosen) return;
        void chosen.arrayBuffer().then((buffer) => {
          const result = imageFromBytes(new Uint8Array(buffer), mem);
          if (!result.ok) {
            status.textContent = result.message;
            return;
          }
          // A loaded file is entirely the reader's choice, so nothing in it is
          // implied.
          imageFiles.set(mem.name, { text: result.text, file: chosen.name });
          setImage(mem, result.text, new Set());
          status.textContent = `Loaded ${chosen.name} into ${mem.name}.`;
        });
      });
      holder.appendChild(file);
      return holder;
    }

    function pageNav(mem: MemorySymbol, win: AddressWindow, total: number): HTMLElement {
      const nav = document.createElement('div');
      nav.className = 'pg-mem-nav';
      const back = document.createElement('button');
      back.type = 'button';
      back.className = 'pg-mem-btn';
      back.textContent = '◂';
      back.setAttribute('aria-label', 'Previous page');
      back.disabled = win.start === 0;
      back.addEventListener('click', () => {
        memWindows.set(mem.name, Math.max(0, win.start - MEM_PAGE));
        renderMemory();
      });
      nav.appendChild(back);

      const range = document.createElement('span');
      range.className = 'pg-mem-range';
      range.textContent =
        `0x${formatAddress(win.start, mem.addrWidth)} – 0x${formatAddress(win.start + win.count - 1, mem.addrWidth)}`;
      nav.appendChild(range);

      const fwd = document.createElement('button');
      fwd.type = 'button';
      fwd.className = 'pg-mem-btn';
      fwd.textContent = '▸';
      fwd.setAttribute('aria-label', 'Next page');
      fwd.disabled = win.start + win.count >= total;
      fwd.addEventListener('click', () => {
        memWindows.set(mem.name, win.start + MEM_PAGE);
        renderMemory();
      });
      nav.appendChild(fwd);

      const jump = document.createElement('input');
      jump.className = 'pg-mem-jump';
      jump.setAttribute('aria-label', `Go to an address in ${mem.name}`);
      jump.placeholder = '0x__';
      jump.addEventListener('keydown', (e) => {
        e.stopPropagation();
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const addr = parseAddress(jump.value, mem.addrWidth);
        if (addr === null) {
          status.textContent = `Not an address in ${mem.name}. Hex, or d for decimal.`;
          return;
        }
        memWindows.set(mem.name, pageContaining(addr, MEM_PAGE, total).start);
        renderMemory({ force: true });
      });
      const label = document.createElement('label');
      label.textContent = 'jump '; label.appendChild(jump); nav.appendChild(label);
      return nav;
    }

    function gridTable(
      mem: MemorySymbol,
      source: ReturnType<typeof cellsFor>,
      win: AddressWindow,
    ): HTMLElement {
      const implied = romImplied.get(mem.name) ?? new Set<number>();
      const table = document.createElement('table');
      table.className = 'pg-mem-table';
      const head = document.createElement('thead');
      const labels = document.createElement('tr');
      for (const text of ['addr', ...Array.from({ length: MEM_PER_ROW }, (_, i) => `+${i}`)]) {
        const th = document.createElement('th');
        th.scope = 'col'; th.textContent = text;
        th.className = text === 'addr' ? 'pg-mem-addr' : 'pg-mem-offset';
        labels.appendChild(th);
      }
      head.appendChild(labels); table.appendChild(head);
      const body = document.createElement('tbody');
      const host = source.live ? memHost() : null;
      const memId = host ? memIdOf(mem) : null;
      const addressed = host && memId !== null ? addressedWord(host, memId) : null;
      const rows = dumpRows(source.read, win, MEM_PER_ROW, mem.width, settings().valueFormat);
      for (const row of rows) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.className = 'pg-mem-addr';
        th.textContent = formatAddress(row.base, mem.addrWidth);
        tr.appendChild(th);
        for (const c of row.cells) {
          const td = document.createElement('td');
          td.className = 'pg-mem-cell';
          td.dataset.addr = String(c.addr);
          if (c.addr === addressed) td.dataset.addressed = 'true';
          td.textContent = c.text;
          if (!c.known) td.dataset.unknown = 'true';
          // A zero that is only there because a later word was written is not
          // a value the reader chose, and must not read like one.
          const isImplied = mem.kind === 'rom' && implied.has(c.addr) && c.known;
          if (isImplied) td.dataset.implied = 'true';
          const where = `${mem.name} at ${formatAddress(c.addr, mem.addrWidth)}`;
          const said = isImplied
            ? `${c.text}, filled to reach a later word`
            : c.text;
          if (source.editable) {
            td.tabIndex = 0;
            td.setAttribute('role', 'button');
            td.setAttribute('aria-label', `${where} is ${said}. Activate to change it.`);
            const edit = () => editCell(td, mem, c.addr);
            td.addEventListener('dblclick', edit);
            td.addEventListener('keydown', (e) => {
              if (e.key !== 'Enter' && e.key !== ' ') return;
              e.preventDefault();
              e.stopPropagation();
              edit();
            });
          } else {
            td.setAttribute('aria-label', `${where} is ${said}`);
          }
          tr.appendChild(td);
        }
        body.appendChild(tr);
      }
      table.appendChild(body);
      return table;
    }

    /** Replace a memory's image, and push it wherever it has to go. */
    function setImage(
      mem: MemorySymbol,
      text: string,
      implied: ReadonlySet<number>,
      opts: { redraw?: boolean } = {},
    ) {
      if (imageFiles.get(mem.name)?.text !== text) imageFiles.delete(mem.name);
      romImages.set(mem.name, text);
      romImplied.set(mem.name, new Set(implied));
      applyToView();
      void runTruth(buildStage.seq);
      if (opts.redraw !== false) renderMemory({ force: true });
    }

    /** Swap one cell for an input. Enter writes it; Escape leaves it alone. */
    function editCell(td: HTMLElement, mem: MemorySymbol, addr: number) {
      if (td.querySelector('input')) return;
      td.dataset.editing = 'true';
      const format = settings().valueFormat;
      const previous = td.textContent ?? '';
      const input = document.createElement('input');
      input.className = 'pg-mem-input';
      input.type = 'text';
      input.value = previous === UNKNOWN ? '' : previous;
      input.setAttribute('aria-label', `${mem.name} at ${formatAddress(addr, mem.addrWidth)}`);
      input.setAttribute('aria-invalid', 'false');
      input.setAttribute('aria-describedby', memErrorId(mem));
      input.autocomplete = 'off';
      input.spellcheck = false;
      // A generous cap rather than a tight one: the longest legal input is not
      // the widest rendering, because `0x` and `_` are both allowed.
      input.maxLength = cellWidth(mem.width, format) + 4;
      let done = false;

      const complain = (message: string) => {
        input.setAttribute('aria-invalid', 'true');
        setMemError(mem, message);
        // Stay open. A refusal that closes the editor throws away what the
        // reader typed and makes them find the cell again to try once more.
        input.focus();
        input.select();
      };

      const finish = (commit: boolean) => {
        if (done) return;
        if (!commit) {
          done = true;
          setMemError(mem, '');
          renderMemory({ force: true });
          return;
        }
        const parsed = parseWord(input.value, mem.width, format);
        if (!parsed.ok) {
          complain(parsed.message);
          return;
        }
        done = true;
        setMemError(mem, '');
        const unknown = parsed.defined === 0n;
        if (mem.kind === 'rom') writeRomWord(mem, addr, unknown ? null : parsed.value);
        else writeLiveWord(mem, addr, parsed.value, parsed.defined);
      };

      // Characters that cannot begin any legal word never make it in, so the
      // only refusals left are about VALUE — too large for the width, or the
      // wrong base — which cannot be prevented by filtering.
      input.addEventListener('input', () => {
        const cleaned = input.value.replace(/[^0-9a-fA-FxX_?]/g, '');
        if (cleaned !== input.value) {
          const at = input.selectionStart ?? cleaned.length;
          input.value = cleaned;
          const back = Math.max(0, at - 1);
          input.setSelectionRange(back, back);
        }
        // Typing again is the reader answering the complaint; drop it.
        if (input.getAttribute('aria-invalid') === 'true') {
          input.setAttribute('aria-invalid', 'false');
          setMemError(mem, '');
        }
      });

      input.addEventListener('keydown', (e) => {
        e.stopPropagation();
        if (e.key === 'Enter') { e.preventDefault(); finish(true); }
        else if (e.key === 'Escape') { e.preventDefault(); finish(false); }
      });
      // Clicking away from a word that will not parse abandons it rather than
      // trapping focus in the cell, the way a file rename does.
      input.addEventListener('blur', () => {
        if (done) return;
        const parsed = parseWord(input.value, mem.width, format);
        finish(parsed.ok);
        if (!parsed.ok) {
          done = true;
          setMemError(mem, '');
          renderMemory({ force: true });
        }
      });
      td.textContent = '';
      td.appendChild(input);
      input.focus();
      input.select();
    }

    const memErrorId = (mem: MemorySymbol) => `pg-mem-err-${mem.name}`;

    /** The line under a memory's grid. Cleared by the next keystroke. */
    function setMemError(mem: MemorySymbol, message: string) {
      const wrap = memPanel.querySelector<HTMLElement>(`.pg-mem-item[data-name="${CSS.escape(mem.name)}"]`);
      const line = wrap?.querySelector<HTMLElement>('.pg-mem-error');
      if (line) line.textContent = message;
    }

    /** A rom is edited through its IMAGE, so the truth table and the canvas
     *  both see the change and a reload cannot lose it. */
    function writeRomWord(mem: MemorySymbol, addr: number, value: bigint | null) {
      const text = romImages.get(mem.name) ?? '';
      const implied = romImplied.get(mem.name) ?? new Set<number>();
      const result = editWord(text, implied, mem, addr, value);
      if (!result.ok) {
        status.textContent = result.message;
        renderMemory({ force: true });
        return;
      }
      const filled = [...result.edit.implied].filter((a) => !implied.has(a));
      setImage(mem, result.edit.text, result.edit.implied);
      status.textContent = filled.length > 0
        ? `${mem.name}[${formatAddress(addr, mem.addrWidth)}] set. An image is a prefix, so ${filled.length} earlier word${filled.length === 1 ? '' : 's'} became zero.`
        : `${mem.name}[${formatAddress(addr, mem.addrWidth)}] ${value === null ? 'is unknown again' : 'set'}.`;
    }

    /** A ram has no image, so it is written into the running circuit — through
     *  the session, which settles, tells the other faces and logs the `poke`. */
    function writeLiveWord(mem: MemorySymbol, addr: number, value: bigint, defined: bigint) {
      const session = sim.session;
      if (!session || memIdOf(mem) === null) {
        status.textContent = `${mem.name} is not running.`;
        renderMemory({ force: true });
        return;
      }
      const r = session.poke(mem.name, BigInt(addr), value, defined);
      status.textContent = r.ok
        ? `${mem.name}[${formatAddress(addr, mem.addrWidth)}] ${defined === 0n ? 'is unknown again' : 'set'}.`
        : `${mem.name} refused the write (${r.code} ${r.arg}).`;
      renderMemory({ force: true });
    }

    /** `save <mem> <path>` for the page: the same bytes, to a download. */
    function saveMemoryImage(mem: MemorySymbol) {
      const session = sim.session;
      const result = session?.storeImage(mem.name);
      if (!session || !result || !result.ok) {
        status.textContent = `${mem.name} is not running.`;
        return;
      }
      const name = `${mem.name}.bin`;
      downloadBytes(name, result.bytes, 'application/octet-stream');
      status.textContent = `Saved ${name} (${result.words} words).`;
    }

    function clearMemory(mem: MemorySymbol) {
      if (mem.kind === 'rom') {
        // Emptying the image is what clears a rom: an empty image is a legal
        // instruction that reaches the runtime as memClear.
        setImage(mem, '', new Set());
        status.textContent = `${mem.name} cleared; every word is unknown.`;
        return;
      }
      const session = sim.session;
      if (!session || memIdOf(mem) === null) return;
      const r = session.clear(mem.name);
      status.textContent = r.ok
        ? `${mem.name} cleared; every word is unknown.`
        : `${mem.name} refused the clear (${r.code} ${r.arg}).`;
      renderMemory({ force: true });
    }

    /** Say what the current rom text amounts to, or why it does not. */
    /**
     * `into` is the row being built, which is NOT in the panel yet: the
     * caller appends it after this returns. Looking it up by name at that
     * moment finds nothing, and the line silently stays blank.
     */
    function updateRomStatus(mem: MemorySymbol, into?: HTMLElement) {
      const wrap = into
        ?? memPanel.querySelector<HTMLElement>(`.pg-mem-item[data-name="${CSS.escape(mem.name)}"]`);
      if (!wrap) return;
      const meta = wrap.querySelector<HTMLElement>('.pg-rom-meta');
      const err = wrap.querySelector<HTMLElement>('.pg-rom-error');
      if (!meta || !err || mem.kind !== 'rom') return;
      const text = romImages.get(mem.name) ?? '';
      const parsed = parseRomImage(text, mem);
      if (parsed.ok) {
        err.textContent = '';
        meta.textContent = imageLine(mem, { file: imageFiles.get(mem.name)?.file ?? null, words: parsed.words });
      } else {
        meta.textContent = '';
        err.textContent = parsed.message;
      }
    }

    /** The name the rest of the island already calls. */
    function renderRoms() {
      renderMemory();
    }

    /** Push every valid image into the running circuit: the session's preload
     *  step, the same one it runs at build and at reset. Called after an edit,
     *  because that changes what is loaded. */
    function applyToView() {
      const session = sim.session;
      if (!session) return;
      const result = session.applyPreloads();
      for (const mem of currentRoms()) updateRomStatus(mem);
      if (result.applied.length > 0) {
        sim.view?.view.refreshState();
        renderMemory();
      }
    }

    mountSettingsDrawer(el, {
      get: settings,
      set: (mutate) => {
        const before = settings().valueFormat;
        store.update((draft) => mutate(draft.settings));
        // The cap is a setting, so changing one can unblock or block the tab.
        applyTruthGate();
        // Both output panes read a setting, so both are re-run.
        void runPreview(buildStage.seq);
        void runTruth(buildStage.seq);
        // The canvas re-spells its badges in place; nothing is rebuilt and
        // nothing the reader typed or loaded is touched.
        if (settings().valueFormat !== before) {
          sim.view?.view.setValueFormat(settings().valueFormat);
          if (state.dataOpen) renderData();
          renderMemory({ force: true });
        }
        schedule();
      },
    });

    // ---- bootstrap ----
    // The share decode is async, so the whole bootstrap is: the editor is
    // created only once the source is settled, and nothing renders twice.
    async function bootstrap() {
      const hash = (window as { __circShareHash?: string }).__circShareHash ?? location.hash;
      const intent = readHash(hash);
      const decoded = intent.src ? await decodeShare(hash, webStreamsCodec()) : null;
      const { outcome, note } = resolveInitial({
        intent,
        decoded,
        env: store.envelope,
        catalogue,
        defaultId: el.dataset.defaultPick ?? catalogue[0]?.id ?? '',
      });

      if (outcome.kind === 'share') {
        // A shared source becomes a project of the reader's own, so editing it
        // does not need a second fork.
        let created: string | null = null;
        store.update((draft) => {
          const r = createScratch(draft.scratch, {
            name: uniqueName(generateSillyName(), draft.scratch.map((p) => p.name)),
            source: outcome.source,
            now: nowMs(),
            keep: draft.activeId,
          });
          if (!r.created) return;
          draft.scratch = r.list;
          created = r.created.id;
        });
        if (created) {
          loadProject(created);
          status.textContent = 'Opened the shared circuit as a new project.';
        } else {
          status.textContent = 'That shared circuit is too large to open.';
        }
      } else {
        loadProject(outcome.id, { restoreFile: store.envelope.activeFile });
        if (note) status.textContent = note;
      }

      showView(store.envelope.view, { persist: false });
      setDataOpen(store.envelope.dataOpen, { persist: false, focus: false });
      showFooterTab(store.envelope.footer.tab, { persist: false });
      setFooterOpen(store.envelope.footer.open, { persist: false });
      renderFooterBar();
      applyTruthGate();
      renderWorkspace();

      whenIdle(() => {
        void loadEditor().then(mountEditor, () => {
          status.textContent = 'Rich editor unavailable; using the plain text box.';
        });
      });
    }

    // ---- the pane divider ----
    // The source column's width in pixels (design file: `480px 1px
    // minmax(0, 1fr)`), the envelope's `layout.sourceWidth`.
    const body = el.querySelector<HTMLElement>('.pg-body')!;
    const separator = el.querySelector<HTMLElement>('.pg-splitter')!;
    const splitter = createSplitter({
      container: body,
      separator,
      unit: 'px',
      property: '--pg-source-w',
      initial: store.envelope.layout.sourceWidth,
      minPx: 320,
      maxReservePx: 480,
      stepPx: 16,
      coarseStepPx: 64,
      labels: ['source', 'canvas'],
      // Only a drag, a key or a double-click persists; a window resize
      // re-clamps what is rendered and never commits.
      onCommit: (px) => store.update((draft) => { draft.layout.sourceWidth = px; }),
    });

    // Below the breakpoint the panes stack, so the divider means nothing: it
    // leaves the page and the tab order together. The persisted desktop ratio
    // is untouched.
    const narrow = window.matchMedia('(max-width: 800px)');
    const applyBreakpoint = () => {
      separator.hidden = narrow.matches;
      splitter.refresh();
    };
    narrow.addEventListener('change', applyBreakpoint);
    applyBreakpoint();

    // The drawer's divider: the output panels' share of the pane, so the
    // drawer takes the rest. Declared after the drawer's handlers, which read
    // it through `refreshDrawerSeparator` only once it exists.
    drawerSplitter = createSplitter({
      container: el,
      separator: drawerSeparator,
      property: '--pg-drawer-h',
      unit: 'px',
      pane: 'second',
      orientation: 'horizontal',
      minPx: 160,
      maxReservePx: 200,
      initial: store.envelope.drawerHeight,
      labels: ['bench', 'drawer'],
      measure: () => {
        const frame = el.getBoundingClientRect();
        const nav = el.querySelector<HTMLElement>('.pg-nav')!.getBoundingClientRect().height;
        const footer = el.querySelector<HTMLElement>('.pg-statusline')!.getBoundingClientRect().height;
        return { start: frame.top + nav, size: Math.max(0, frame.height - nav - footer) };
      },
      onCommit: (height) => store.update((draft) => { draft.drawerHeight = height; }),
    });
    refreshDrawerSeparator();

    // localStorage is synchronous, so a flush on the way out is enough.
    window.addEventListener('pagehide', () => store.flush());
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') store.flush();
    });

    // ---- file tabs ----
    function showFile(index: number) {
      const next = selectTab(state.tabs, index);
      if (next === state.tabs) {
        // Already active: still move focus there, so a click always lands.
        focusFileTab(state.tabs.active);
        return;
      }
      state.tabs = next;
      editor?.showDocument(state.tabs.active);
      renderTree();
      focusFileTab(state.tabs.active);
      // No schedule(): the source did not change, only which file is visible.
    }


    function disarm() {
      if (confirmIndex === null) return;
      confirmIndex = null;
      if (confirmTimer !== null) window.clearTimeout(confirmTimer);
      confirmTimer = null;
      renderTree();
    }

    function armOrDelete(index: number) {
      if (!canDelete(state.tabs)) {
        status.textContent = 'You cannot delete the last file.';
        return;
      }
      if (confirmIndex !== index) {
        confirmIndex = index;
        if (confirmTimer !== null) window.clearTimeout(confirmTimer);
        confirmTimer = window.setTimeout(disarm, 4000);
        renderTree();
        status.textContent = `Delete ${state.tabs.files[index].name}? Press Delete again, or the ×, to confirm.`;
        return;
      }
      const name = state.tabs.files[index].name;
      const wasRoot = index === rootIndex(state.tabs);
      confirmIndex = null;
      if (confirmTimer !== null) window.clearTimeout(confirmTimer);
      confirmTimer = null;
      state.tabs = deleteFile(state.tabs, index);
      editor?.removeDocument(index);
      editor?.showDocument(state.tabs.active);
      renderTree();
      focusFileTab(state.tabs.active);
      status.textContent = wasRoot
        ? `Deleted ${name}. ${rootOf(state.tabs.files).name} is now the root.`
        : `Deleted ${name}.`;
      schedule();
    }

    function addNewFile() {
      disarm();
      state.tabs = addFile(state.tabs);
      const index = state.tabs.active;
      editor?.insertDocument(index, state.tabs.files[index].body);
      editor?.showDocument(index);
      renderTree();
      focusFileTab(index);
      status.textContent = `Added ${state.tabs.files[index].name}.`;
      schedule();
    }

    /** Swaps the tab's name span for an input. Committing needs a valid name;
     *  Escape reverts, and a blur commits only if the name is legal. */
    function startRename(index: number) {
      disarm();
      const tab = wsBody.querySelector<HTMLElement>(`.pg-switch-file[data-file="${index}"]`);
      const nameEl = tab?.querySelector<HTMLElement>('.pg-switch-label');
      if (!tab || !nameEl) return;
      const input = document.createElement('input');
      input.className = 'pg-switch-input';
      input.value = state.tabs.files[index].name;
      input.setAttribute('aria-label', 'File name');
      input.setAttribute('aria-invalid', 'false');
      let done = false;

      const finish = (commit: boolean) => {
        if (done) return;
        done = true;
        wsError.textContent = '';
        if (commit) {
          const next = renameFile(state.tabs, index, input.value);
          if (next !== state.tabs) {
            state.tabs = next;
            status.textContent =
              `Renamed to ${input.value}. Imports keep the old name; update them yourself if another file imports this one.`;
            renderTree();
            focusFileTab(index);
            schedule();
            return;
          }
        }
        renderTree();
        focusFileTab(index);
      };

      input.addEventListener('keydown', (e) => {
        e.stopPropagation(); // the tree's own arrow handling must not fire
        if (e.key === 'Enter') {
          e.preventDefault();
          const problem = nameError(state.tabs, index, input.value);
          if (problem) {
            input.setAttribute('aria-invalid', 'true');
            wsError.textContent = problem;
            return;
          }
          finish(true);
        } else if (e.key === 'Escape') {
          e.preventDefault();
          finish(false);
        }
      });
      // A blur commits when the name is legal and reverts silently otherwise.
      input.addEventListener('blur', () => finish(nameError(state.tabs, index, input.value) === null));

      nameEl.replaceWith(input);
      input.focus();
      input.select();
    }

    /** Reorder. Moving a tab past the end is how the root changes, so the move
     *  is announced whenever the last position is involved. */
    function reorder(from: number, to: number) {
      disarm();
      const next = moveFile(state.tabs, from, to);
      if (next === state.tabs) return;
      const wasRoot = rootOf(state.tabs.files).name;
      state.tabs = next;
      editor?.moveDocument(from, to);
      editor?.showDocument(state.tabs.active);
      renderTree();
      focusFileTab(state.tabs.active);
      const nowRoot = rootOf(state.tabs.files).name;
      if (nowRoot !== wasRoot) status.textContent = `${nowRoot} is now the root.`;
      schedule();
    }

    // ---- editor ----
    // The textarea is the fallback editing surface: it edits and compiles on
    // its own, and it is removed from the DOM only once CodeMirror has mounted.
    source.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        source.setRangeText('  ', source.selectionStart, source.selectionEnd, 'end');
        state.tabs = fromSource(source.value);
        schedule();
      }
    });
    /** Every edit arms both stages: the fast one paints squiggles, the slow one
     *  builds. They never wait on each other. */
    function schedule() {
      state.doc += 1;
      state.stale = true;
      analyzeStage.schedule((seq) => void runAnalyze(seq));
      buildStage.schedule((seq) => void runBuild(seq));
    }
    // The fallback surface edits the COMBINED text; re-splitting on every
    // keystroke keeps one model for both surfaces.
    source.addEventListener('input', () => {
      state.tabs = fromSource(source.value);
      persistSource();
      schedule();
    });

    // ---- the CodeMirror island, loaded on idle ----
    // A deliberate, recorded exception to "nothing heavy loads before
    // interaction": on /playground the editor IS the page, so a first-focus
    // gate would show a bare textarea to every visitor who reads before
    // typing. It does not extend to libcirc.wasm, whose ensureReady() gate
    // sits on the editor host's focusin below.
    type EditorMod = typeof import('../scripts/circ-editor.ts');
    let editorMod: EditorMod | null = null;
    let editor: ReturnType<EditorMod['createEditor']> | null = null;
    let editorPromise: Promise<EditorMod> | null = null;
    const loadEditor = () => (editorPromise ??= import('../scripts/circ-editor.ts'));

    function mountEditor(mod: EditorMod) {
      editorMod = mod;
      editor = mod.createEditor(editorHost, {
        doc: activeFile(state.tabs).body,
        theme: mod.currentThemeMode(),
        ariaLabel: 'circ source',
        onCursor: (index, line, col, lineText) => {
          // Only the root file's declarations are drawn, so a cursor in a
          // sibling tab resolves to nothing rather than to the wrong box.
          const isRoot = index === rootIndex(state.tabs);
          setCurrentDeclaration(isRoot ? declarationAt(link.decls, line, col, lineText) : null);
        },
        onChange: (doc, index) => {
          state.tabs = setBody(state.tabs, index, doc);
          renderTree();
          persistSource();
          schedule();
        },
      });
      editor.setDocuments(state.tabs.files.map((f) => f.body), state.tabs.active);
      editorHost.hidden = false;
      source.remove();
      // The strip only exists once the editor does: on the fallback path a tab
      // would mean nothing, because one textarea holds every file at once.
      renderTree();
    }

    const whenIdle = (fn: () => void) => {
      const ric = (window as unknown as { requestIdleCallback?: (cb: () => void) => number })
        .requestIdleCallback;
      if (typeof ric === 'function') ric(fn);
      else window.setTimeout(fn, 0);
    };
    void bootstrap();

    // ---- version handshake ----
    async function ensureReady(): Promise<boolean> {
      if (state.version) return true;
      pipe.loading = true;
      renderStatus();
      try {
        state.version = await client.init();
      } catch (err) {
        pipe.loading = false;
        pipe.failure = `Could not load libcirc.wasm: ${(err as Error).message}`;
        renderStatus();
        return false;
      }
      pipe.loading = false;
      pipe.ready = true;
      pipe.failure = null;
      const v = state.version;
      statusIdentity.textContent = `circ ${v.version} · ${v.revision} · CIRF v${v.full_version}`;
      renderStatus();
      if (!supported.includes(state.version.full_version)) {
        banner.textContent =
          `libcirc.wasm emits topology v${state.version.full_version}, but the bundled circ-renderer reads v${supported.join('/')}; ` +
          'Simulate is disabled until the site is rebuilt from one compiler revision.';
        banner.hidden = false;
        state.simulateEnabled = false;
        simNote.textContent = 'Simulate is disabled: renderer and compiler disagree on the topology version.';
        dataNote.textContent = simNote.textContent;
      }
      return true;
    }

    // ---- pipeline ----
    // Two stages, each guarded at EVERY await. Dropping a reply is not
    // cancellation — the worker has no abort, so a stale call finishes and its
    // result is discarded on arrival.

    /** The bodies this run's offsets are computed against, per tab. */
    function snapshotBodies(): string[] {
      return state.tabs.files.map((f) => f.body);
    }

    function setBusy(analyzing: boolean, building: boolean) {
      pipe.analyzing = analyzing;
      pipe.building = building;
      renderStatus();
    }

    /** Dim the outputs, or clear them outright when the FILE SET changed —
     *  the only case where the last good preview, table and canvas describe a
     *  project that no longer exists. */
    function markOutputs(nextFiles: string[]) {
      if (outputsShouldClear(state.renderedFiles, nextFiles)) {
        state.renderedFiles = nextFiles;
        state.artifact = null;
        state.stale = false;
        pipe.artifactBytes = null;
        previewEl.textContent = '';
        tableEl.innerHTML = '';
        outputPane.removeAttribute('data-stale');
        hooks.onArtifact?.(null, 'files-changed');
        hooks.refreshActions?.();
        return;
      }
      state.renderedFiles = nextFiles;
    }

    function setStale(stale: boolean) {
      state.stale = stale;
      pipe.stale = stale;
      if (stale) outputPane.setAttribute('data-stale', '');
      else outputPane.removeAttribute('data-stale');
      hooks.refreshActions?.();
      renderStatus();
    }

    async function runAnalyze(seq: number) {
      const doc = state.doc;
      if (!(await ensureReady())) return;
      if (!analyzeStage.isCurrent(seq)) return;
      const snapshot = snapshotBodies();
      setBusy(true, pipe.building);

      const an = await client.call('analyze', requestFor(state.tabs.files));
      if (!analyzeStage.isCurrent(seq)) return;
      if (an.status !== 0) {
        pipe.failure = `analyze failed: ${an.error ?? an.status}`;
        setBusy(false, pipe.building);
        return;
      }
      pipe.failure = null;
      state.analysis = JSON.parse(an.text!) as Analysis;
      state.diagnostics = state.analysis.diagnostics;
      publishDiagnostics(snapshot, state.analysis);
      // So the badge survives switching away from this project.
      const openId = store.envelope.activeId;
      if (openId) remembered.set(openId, sumCounts(countsByFile(state.tabs.files, state.analysis)));
      renderTree();
      link.decls = declsFor(state.analysis, rootPathFor(rootOf(state.tabs.files).name));
      renderRoms();

      const errors = state.diagnostics.filter((d) => d.severity === 'error').length;
      state.analyzedDoc = doc;
      pipe.errors = errors;
      pipe.warnings = state.diagnostics.length - errors;
      setBusy(false, pipe.building);
    }

    async function runBuild(seq: number) {
      const doc = state.doc;
      if (!(await ensureReady())) return;
      if (!buildStage.isCurrent(seq)) return;

      markOutputs(state.tabs.files.map((f) => f.name));
      // Skip the compile only when a FRESH analysis already found errors; a
      // stale or missing one builds anyway, so neither timer can wedge the
      // other.
      const fresh = state.analyzedDoc === doc ? { doc, errors: pipe.errors } : null;
      if (!shouldCompile(fresh, doc)) {
        setStale(state.artifact !== null);
        setBusy(pipe.analyzing, false);
        return;
      }

      const snapshot = snapshotBodies();
      setBusy(pipe.analyzing, true);
      const c = await client.call('compile', requestFor(state.tabs.files));
      if (!buildStage.isCurrent(seq)) return;

      if (c.status === 0 && c.bytes) {
        // Captured now: the worker transfers the buffer, and a detached view
        // reports 0.
        const size = c.bytes.length;
        const hash = fnv1a(c.bytes);
        if (!state.artifact || state.artifact.hash !== hash) {
          state.artifact = { bytes: c.bytes, hash, size };
          hooks.onArtifact?.(c.bytes, 'built');
          hooks.refreshActions?.();
        }
        pipe.artifactBytes = size;
        pipe.failure = null;
        setStale(false);
      } else if (c.status === 1 && c.text) {
        // A second, independent producer: the compile reply carries its own
        // `files[]`, which the mapping needs, so map THAT analysis.
        const compileAnalysis = JSON.parse(c.text) as Analysis;
        state.diagnostics = compileAnalysis.diagnostics;
        publishDiagnostics(snapshot, compileAnalysis);
        renderTree();
        pipe.errors = Math.max(1, state.diagnostics.filter((d) => d.severity === 'error').length);
        // The artifact and the canvas are LEFT ALONE: the last good build stays
        // on screen, dimmed, until the source builds again.
        setStale(state.artifact !== null);
      } else {
        pipe.failure = `compile failed: ${c.error ?? c.status}`;
        setStale(state.artifact !== null);
      }
      setBusy(pipe.analyzing, false);

      if (state.view === 'schematic') await runPreview(seq);
      if (state.view === 'truth') await runTruth(seq);
    }

    async function runPreview(seq: number) {
      if (!state.tabs.files.length || !state.version) return;
      const r = await client.call('preview', requestFor(state.tabs.files, optionsFor('preview', settings())));
      // The follow-on call re-checks the SAME stage: this is the guard the
      // langlang playground omits on its second stage.
      if (!buildStage.isCurrent(seq)) return;
      if (r.status === 0) {
        previewEl.textContent = r.text!;
        renderSizeLine();
        return;
      }
      // Leave the last good schematic in place and say so in the status bar.
      pipe.failure = messageOf(r);
      setStale(previewEl.textContent !== '');
    }

    /** `rows × cols chars` of the schematic on screen (design file 3e). */
    function renderSizeLine() {
      const lines = previewEl.textContent ? previewEl.textContent.replace(/\n$/, '').split('\n') : [];
      const cols = lines.reduce((w, l) => Math.max(w, l.length), 0);
      sizeLine.textContent = `${lines.length} × ${cols} chars`;
    }

    // ---- the copies ----
    // The schematic as its text; the table as the compiler's markdown or CSV
    // (the Truth slice fills those two in).
    for (const b of copyButtons) {
      b.addEventListener('click', async () => {
        const what = b.dataset.copy;
        const textOf = hooks.copySource?.(what ?? '') ?? (what === 'preview' ? Promise.resolve(previewEl.textContent ?? '') : null);
        if (!textOf) return;
        const text = await textOf;
        if (!text) {
          flash(b, 'Nothing yet', 'failed');
          return;
        }
        flash(b, (await copyText(text)) ? 'Copied' : 'Select below', 'done');
      });
    }

    function rootInputBits(): number | null {
      const a = state.analysis;
      if (!a) return null;
      const rootId = rootFileId(a.files, rootPathFor(rootOf(state.tabs.files).name));
      // Null stays null: a 0 here would read as "no input bits" and silently
      // switch off the only defence against an enumeration that cannot be
      // stopped once it has started.
      if (rootId === null) return null;
      return a.symbols.filter((s) => s.file_id === rootId && s.kind === 'input').reduce((n, s) => n + s.width, 0);
    }

    // ---- the Truth view ----
    let truthViewPromise: Promise<typeof import('../scripts/truth-view.ts')> | null = null;
    /** The module reaches the renderer, so it loads beside it, on first need. */
    const loadTruthView = () => (truthViewPromise ??= import('../scripts/truth-view.ts'));

    /** The reader's input pins as the live row is matched against them: the
     *  session's when there is one, else the ones the page remembers. */
    function inputPins(): { name: string; value: PinValue }[] {
      const session = sim.session;
      if (session && session.isAlive) {
        return session.pins.filter((p) => p.kind === 'in').map((p) => {
          const r = session.get(p.name);
          return { name: p.name, value: r.ok ? r.value : { value: 0n, defined: 0n, width: p.width } };
        });
      }
      return Array.from(sim.pins, ([name, value]) => ({ name, value }));
    }

    /** The tint follows the session, never the click (decision 11). */
    async function refreshTruthTint() {
      if (!truth.table) return;
      const { liveRowIndex } = await loadTruthView();
      const at = liveRowIndex(truth.table, inputPins());
      for (const tr of tableEl.querySelectorAll<HTMLElement>('tr[data-row]')) {
        if (Number(tr.dataset.row) === at) tr.setAttribute('aria-current', 'true');
        else tr.removeAttribute('aria-current');
      }
    }

    /** Drive every input column of a row through the session, so the canvas,
     *  the Data panel and the console all follow (decision 11). */
    async function driveTruthRow(row: number) {
      const table = truth.table;
      if (!table) return;
      const session = await ensureSession();
      if (!session) {
        status.textContent = state.simulateEnabled ? 'Compile a circuit first.' : 'Simulate is disabled.';
        return;
      }
      const [{ driveRow }, { describeError }] = await Promise.all([loadTruthView(), loadDataView()]);
      if (sim.session !== session) return;
      const r = driveRow(session, table, row);
      if (!r.ok) {
        status.textContent = describeError(r.code, r.arg);
        return;
      }
      // The page's memory of the pins, so a rebuilt session replays the row.
      for (const col of table.inputs) {
        const v = session.get(col.name);
        if (v.ok) sim.pins.set(col.name, v.value);
      }
    }

    /** Draw the rows: headers that light the schematic and the editor, cells
     *  by value in the reader's base, rows that drive. */
    async function renderTruth(table: TruthRows) {
      const { cellText } = await loadTruthView();
      truth.table = table;
      tableEl.innerHTML = '';
      // Plain elements rather than `insertRow`/`insertCell`: the same DOM,
      // and the headless harness the smoke test runs in has only the former.
      const t = document.createElement('table');
      const thead = document.createElement('thead');
      const head = document.createElement('tr');
      thead.appendChild(head);
      t.appendChild(thead);
      const cols = [...table.inputs, ...table.outputs];
      cols.forEach((col, i) => {
        const th = document.createElement('th');
        th.textContent = col.width > 1 ? `${col.name}[${col.width}]` : col.name;
        // The join key is the bare name.
        th.dataset.symbolName = col.name;
        if (i === table.inputs.length) th.classList.add('pg-truth-first-out');
        // Focusable, so this is not a pointer-only affordance.
        th.tabIndex = 0;
        const show = () => highlightByName(col.name);
        const clear = () => highlightByName(null);
        th.addEventListener('pointerenter', show);
        th.addEventListener('focus', show);
        th.addEventListener('pointerleave', clear);
        th.addEventListener('blur', clear);
        head.appendChild(th);
      });
      const body = document.createElement('tbody');
      t.appendChild(body);
      const format = settings().valueFormat;
      table.rows.forEach((row, r) => {
        const tr = document.createElement('tr');
        body.appendChild(tr);
        tr.dataset.row = String(r);
        tr.tabIndex = 0;
        tr.title = 'Drive the inputs to this row';
        [...row.in, ...row.out].forEach((cell, i) => {
          const td = document.createElement('td');
          tr.appendChild(td);
          td.textContent = cellText(cell, cols[i].width, format);
          td.className = cell === null ? 'pg-truth-unknown' : cell === 0n ? 'pg-truth-low' : 'pg-truth-high';
          if (i === table.inputs.length) td.classList.add('pg-truth-first-out');
        });
        tr.addEventListener('click', () => void driveTruthRow(r));
        tr.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          e.preventDefault();
          void driveTruthRow(r);
        });
      });
      tableEl.appendChild(t);
      applyTruthGate();
      await refreshTruthTint();
    }

    /** What the card says instead of a table. */
    function showTruthNote(text: string) {
      truth.table = null;
      tableEl.innerHTML = '';
      tableEl.textContent = text;
      applyTruthGate();
    }

    async function runTruth(seq: number) {
      if (!state.tabs.files.length || !state.version) return;
      // The same refusal the chip is painted with, so the card and the chip
      // can never disagree about why there is no table.
      const refusal = truthBlock();
      if (refusal) {
        truth.filtered = false;
        truth.unknownBits = undefined;
        showTruthNote(refusal);
        return;
      }
      if (capRefusal(rootInputBits(), settings()) !== null) {
        await runTruthOverCap(seq);
        return;
      }
      const r = await client.call('truth_table', requestFor(state.tabs.files, optionsFor('truth_table', settings(), preloads())));
      if (!buildStage.isCurrent(seq)) return;
      if (r.status !== 0) {
        // A refusal leaves the last good table on screen; the reason goes to
        // the status bar rather than replacing what the reader was reading.
        pipe.failure = messageOf(r);
        setStale(tableEl.textContent !== '');
        return;
      }
      const { parseTruthTable } = await loadTruthView();
      if (!buildStage.isCurrent(seq)) return;
      truth.filtered = false;
      truth.unknownBits = undefined;
      await renderTruth(parseTruthTable(r.text!));
    }

    /**
     * Decision 10: over the cap the compiler would enumerate every input bit,
     * so the site enumerates only the unknown ones. The known pins are held
     * at the live session's values on a scratch session built from the same
     * artifact (same roms and images; no boot low, so a pin the reader never
     * set is unknown and enumerated), the rows are read, and the scratch is
     * destroyed. The live session is read and never written.
     */
    async function runTruthOverCap(seq: number) {
      const cap = settings().truthTableCap;
      const live = await ensureSession();
      if (!buildStage.isCurrent(seq)) return;
      if (!live) {
        truth.filtered = false;
        showTruthNote(state.simulateEnabled ? 'Compile a circuit first.' : 'Simulate is disabled, and the table over the cap needs it.');
        return;
      }
      const bytes = sim.bytes;
      if (!bytes) return;
      const [{ rowsForPins }, { CircRuntime: Runtime }] = await Promise.all([loadTruthView(), loadRenderer()]);
      if (!buildStage.isCurrent(seq) || sim.bytes !== bytes) return;
      const scratch = await SimSession.build({
        bytes,
        load: (b) => Runtime.loadFromBytes(b, { noInitialPinDrive: true }),
        roms: currentRoms(),
        images: romImages,
      });
      if (!buildStage.isCurrent(seq) || sim.bytes !== bytes || sim.session !== live) {
        scratch.destroy();
        return;
      }
      const t0 = performance.now();
      const outcome = rowsForPins(scratch, live, cap);
      truth.lastMs = performance.now() - t0;
      scratch.destroy();
      truth.unknownBits = outcome.unknownBits;
      if (!outcome.ok) {
        truth.filtered = false;
        showTruthNote(
          outcome.reason === 'stateful'
            ? 'A truth table needs a circuit without ram.'
            : `${outcome.unknownBits} unknown input bits are over the cap of ${cap}. Set more pins, on the canvas or in the Data panel, or raise the cap.`,
        );
        return;
      }
      truth.filtered = true;
      await renderTruth(outcome.table);
    }

    /** The copies: the compiler's own markdown or CSV for its table, the
     *  module's for rows the compiler never saw. */
    hooks.copySource = (what) => {
      if (what !== 'markdown' && what !== 'csv') return null;
      const table = truth.table;
      if (!table) return Promise.resolve('');
      if (truth.filtered) {
        return loadTruthView().then((m) => (what === 'markdown' ? m.toMarkdown : m.toCsv)(table, settings().valueFormat));
      }
      return client
        .call('truth_table', requestFor(state.tabs.files, optionsFor('truth_table', settings(), preloads(), what)))
        .then((r) => (r.status === 0 ? r.text! : ''));
    }

    function messageOf(r: WorkerReply): string {
      if (r.error) return r.error;
      if (r.status === 1 && r.text) {
        const diags = (JSON.parse(r.text) as Analysis).diagnostics;
        return diags.map((d) => `${d.range.start_line}:${d.range.start_col} ${d.code} ${d.message}`).join('\n');
      }
      return `status ${r.status}`;
    }

    // ---- diagnostics ----
    /** Map one analysis onto `snapshot`, render the list, and push the spans
     *  into the editor — the last step only while the document has not moved
     *  on, since a fresher run is already scheduled and will map correctly.
     *  The list itself always renders: it carries file-local positions, which
     *  do not go stale the same way. */
    function publishDiagnostics(snapshot: readonly string[], analysis: Analysis) {
      // Map ONCE PER TAB, each against a synthetic single-file array, so the
      // offsets are file-local and can address that tab's own document. The
      // mapper is total, so every call returns every diagnostic; a tab keeps
      // only the rows it could place (`from !== null`), and the placeless rows
      // — `<builtin>/…`, or a path naming no current tab — are emitted once,
      // from a single extra pass, so nothing is listed N times on N tabs.
      const { perTab, rows } = mapPerTab(state.tabs.files, analysis);
      state.mapped = rows;
      renderDiagnostics();
      renderDataCount();

      // Phase 1's staleness guard, re-based per tab: a reply computed against
      // a body the reader has since edited must not be pushed, because the
      // linter maps stored diagnostics forward and cannot know they were
      // stale. An add, delete or move in flight desynchronises every index, so
      // the whole push is skipped.
      if (!editor || snapshot.length !== state.tabs.files.length) return;
      state.tabs.files.forEach((f, i) => {
        if (snapshot[i] !== f.body) return;
        editor!.setDiagnosticsFor(i, toLintDiagnostics(perTab[i]));
      });
    }

    /** The bar: the counts on the left, what the source is made of on the
     *  right, both from the island's own state. The severity on the counts
     *  button is what colours it and shows its caret. */
    function renderFooterBar() {
      const summary = summarize(state.tabs.files, state.analysis, state.mapped);
      const [left, right] = summaryLabels(summary);
      footerCountsText.textContent = left;
      footerStats.textContent = right;
      footerCounts.dataset.severity = summary.errors > 0 ? 'error' : summary.warnings > 0 ? 'warning' : 'none';
    }

    /** The list as a grid (design file 3b: `14px 104px 52px 1fr`): a glyph,
     *  the compiler's own FILE-LOCAL position as the jump, the code, the
     *  message. A combined-document line number means nothing to a reader
     *  looking at `half_adder.circ`; the jump target keeps the absolute span. */
    function renderDiagnostics() {
      diagList.innerHTML = '';
      // All three derive from `state.mapped`, so they are refreshed together
      // with the list rather than by whoever remembers to call them.
      renderFooterBar();
      applyTruthGate();
      const cell = (cls: string, text: string): HTMLSpanElement => {
        const el = document.createElement('span');
        el.className = cls;
        el.textContent = text;
        return el;
      };
      if (state.mapped.length === 0) {
        const li = document.createElement('li');
        li.className = 'pg-diag-none';
        li.textContent = 'No diagnostics.';
        diagList.appendChild(li);
        return;
      }

      for (const m of state.mapped) {
        const li = document.createElement('li');
        li.className = 'pg-diag-row';
        li.dataset.severity = m.severity;
        const glyph = cell('pg-diag-glyph', '▲');
        glyph.setAttribute('role', 'img');
        glyph.setAttribute('aria-label', m.severity);
        const position = `${m.fileName}:${m.line}:${m.column}`;
        let pos: HTMLElement;
        if (m.from !== null && m.to !== null && m.tab !== null) {
          // A row with a span jumps, switching files first when the compiler
          // blamed another one. `showDocument` is synchronous, so the select
          // on the next statement lands in the file that just became visible.
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'pg-diag-pos';
          btn.textContent = position;
          const { from, to, tab } = m;
          btn.addEventListener('click', () => {
            if (editor) {
              if (tab !== state.tabs.active) {
                state.tabs = selectTab(state.tabs, tab);
                editor.showDocument(tab);
                renderTree();
              }
              editor.select(from, to);
            } else {
              // The fallback surface holds every file in one buffer, so the
              // file-local offsets do not address it; focus it and stop.
              source.focus();
            }
          });
          // Hovering or focusing a row lights up whatever it points at, so
          // the list is a third way into the picture.
          const show = () => {
            const line = m.line;
            const file = state.tabs.files[tab];
            const decl = file
              ? declarationAt(link.decls, line, m.column, file.body.split('\n')[line - 1] ?? '')
              : null;
            if (decl) highlightByName(decl.name);
          };
          btn.addEventListener('pointerenter', show);
          btn.addEventListener('focus', show);
          btn.addEventListener('pointerleave', () => highlightByName(null));
          btn.addEventListener('blur', () => highlightByName(null));
          pos = btn;
        } else {
          // A file with no editor buffer (`<builtin>/…`): the row stays, so
          // the count and the message are still visible, but there is nowhere
          // to go, and a span says so where a disabled button would not.
          pos = cell('pg-diag-pos', position);
        }
        li.append(glyph, pos, cell('pg-diag-code', m.code), cell('pg-diag-msg', m.message));
        diagList.appendChild(li);
      }
    }


    // ---- simulate ----
    /** What a root input pin holds: the renderer's own value shape. */
    type PinValue = BitValue;
    /** The canvas face: the renderer's own view shape minus the runtime,
     *  which is the session's. `destroy` ends the canvas and not the runtime. */
    type View = Pick<CircView<PaletteKey>, 'view' | 'canvas' | 'destroy'>;
    const simMount = el.querySelector<HTMLElement>('.pg-sim-mount')!;
    // The hint line under the view carries the gesture now; the note is for
    // what stops the picture.
    const simNoteBase = '';
    const sim = {
      /** One session per artifact: the runtime, the pins and memories by name,
       *  the listeners. Every face drives and reads through it. */
      session: null as SimSession | null,
      /** The bytes the session was built from, so a new artifact is told apart. */
      sessionBytes: null as Uint8Array | null,
      unsubscribe: null as null | (() => void),
      view: null as View | null,
      bytes: null as Uint8Array | null,
      renderedHash: -1,
      /** Keyed by root input-pin NAME: ids shift as the source changes. Holds
       *  the whole value, since a bus pin can be anything now, not just all-on
       *  or all-off. */
      pins: new Map<string, PinValue>(),
      rendererPromise: null as Promise<typeof import('circ-renderer')> | null,
      themesPromise: null as Promise<typeof import('../utils/circ-theme.mjs')> | null,
      assetsHooked: false,
      /** The one cell size, so the zoom line and the canvas agree. */
      cell: 14,
      /** The reader zoomed or panned this canvas. Set by `onViewChange` when
       *  a gesture preceded it, cleared by `fit`, `100%` and a new canvas;
       *  gates the refit when the inset changes, so a view the reader chose
       *  is never taken from them. */
      navigated: false,
      /** When the canvas last saw a wheel, a drag or a touch move. The
       *  renderer reports its own fits through `onViewChange` too (the first
       *  measurement under `viewport: 'parent'`), and those follow no gesture. */
      gestureAt: 0,
    };
    const GESTURE_WINDOW_MS = 500;

    /** The furniture's bands: the switch at the top, the two lines at the
     *  bottom. The canvas covers the whole region under them, so the fit
     *  keeps this much clear on every side. */
    const BENCH_INSET = 60;

    /**
     * The theme the bench draws with: the site's, plus the dot grid under the
     * circuit (design file: --fg at 14% light, 18% dark; 18px), drawn in world
     * space through the renderer's background hook so it moves and zooms
     * with the contents. The colour is the region's own token, read when the
     * theme is picked, so a flip re-reads it. Zoomed out, the spacing doubles
     * until the dots are 12px apart on screen; a dot stays one pixel wide.
     */
    function benchTheme(theme: CircTheme<PaletteKey>): CircTheme<PaletteKey> {
      const dot = getComputedStyle(outputPane).getPropertyValue('--pg-dot').trim() || 'rgba(0, 0, 0, 0.14)';
      return {
        ...theme,
        background: ({ ctx, view, viewport }) => {
          const scale = view.scale;
          const left = -view.x / scale;
          const top = -view.y / scale;
          const width = viewport.width / scale;
          const height = viewport.height / scale;
          // The whole element, not the grid: zoomed out, the grid is smaller
          // than the element, and the page must show through around it.
          ctx.clearRect(left, top, width, height);
          let step = 18;
          while (step * scale < 12) step *= 2;
          const r = 1 / scale;
          const x0 = Math.floor(left / step) * step;
          const y0 = Math.floor(top / step) * step;
          ctx.fillStyle = dot;
          ctx.beginPath();
          for (let x = x0; x <= left + width; x += step) {
            for (let y = y0; y <= top + height; y += step) {
              ctx.moveTo(x + r, y);
              ctx.arc(x, y, r, 0, Math.PI * 2);
            }
          }
          ctx.fill();
        },
      };
    }

    // ---- the zoom line ----
    /** The percentage follows the canvas; the two buttons need one, and the
     *  region's static dots yield to the canvas's own while one is showing. */
    function syncZoom() {
      const view = sim.view?.view ?? null;
      zoomPct.textContent = formatZoom(view ? view.getView().scale : 1);
      zoomPct.setAttribute('aria-disabled', String(view === null));
      zoomFit.setAttribute('aria-disabled', String(view === null));
      outputPane.dataset.canvas = String(view !== null);
    }
    zoomPct.addEventListener('click', () => {
      if (!sim.view) return;
      sim.view.view.resetView();
      sim.navigated = false;
      syncZoom();
    });
    zoomFit.addEventListener('click', () => {
      if (!sim.view) return;
      sim.view.view.fit();
      sim.navigated = false;
      syncZoom();
    });
    /**
     * The inset changed (the Data card opened or closed, the drawer grew): a
     * canvas the reader has not navigated refits to it; one they zoomed or
     * panned keeps their view. Deferred by one frame: ResizeObserver delivers
     * shallowest-first, so this mount's callback runs before the renderer's
     * own on the canvas in the same pass, and a synchronous `fit()` here would
     * measure the old size. The site never calls `fit()` synchronously from a
     * layout change.
     */
    let refitPending = false;
    function refitIfIdle() {
      if (refitPending) return;
      refitPending = true;
      requestAnimationFrame(() => {
        refitPending = false;
        if (!sim.view || sim.navigated) return;
        sim.view.view.fit();
        syncZoom();
      });
    }
    if (typeof ResizeObserver === 'function') new ResizeObserver(() => refitIfIdle()).observe(simMount);
    const loadRenderer = () => (sim.rendererPromise ??= import('circ-renderer'));
    const loadThemes = () => (sim.themesPromise ??= import('../utils/circ-theme.mjs'));
    // The Data tab's module reaches the renderer's index for its two value
    // helpers, so it stays behind a dynamic import like the renderer itself.
    let dataViewPromise: Promise<typeof import('../scripts/data-view.ts')> | null = null;
    let dataViewLoaded: typeof import('../scripts/data-view.ts') | null = null;
    const loadDataView = () =>
      (dataViewPromise ??= import('../scripts/data-view.ts').then((m) => { dataViewLoaded = m; return m; }));

    /** Root input names to ids, from the session's own pin table. */
    function rootInputs(session: SimSession): Map<string, number> {
      const m = new Map<string, number>();
      for (const p of session.pins) if (p.kind === 'in') m.set(p.name, p.id);
      return m;
    }

    /** End the canvas and the session, in that order: the canvas holds the runtime the session owns. */
    function dropSession() {
      sim.unsubscribe?.();
      sim.unsubscribe = null;
      sim.view?.destroy();
      sim.view = null;
      simMount.innerHTML = '';
      sim.session?.destroy();
      sim.session = null;
      sim.sessionBytes = null;
      syncZoom();
    }

    /**
     * The session for the current artifact, built on first need by whichever
     * face asks. Loads floating (`noInitialPinDrive`) so a console `reset` is
     * exactly a fresh `--sim` process, then boots low as the page always has,
     * then replays the reader's pins by name. Guarded at every await by the
     * bytes: a newer artifact while this one loads wins.
     */
    let sessionBuild: { bytes: Uint8Array; promise: Promise<SimSession | null> } | null = null;
    function ensureSession(): Promise<SimSession | null> {
      if (!state.simulateEnabled || !sim.bytes) return Promise.resolve(null);
      const bytes = sim.bytes;
      if (sim.session && sim.sessionBytes === bytes) return Promise.resolve(sim.session);
      if (sessionBuild?.bytes === bytes) return sessionBuild.promise;
      const pending = { bytes, promise: buildSession(bytes) };
      sessionBuild = pending;
      const clear = () => { if (sessionBuild === pending) sessionBuild = null; };
      void pending.promise.then(clear, clear);
      return pending.promise;
    }
    async function buildSession(bytes: Uint8Array): Promise<SimSession | null> {
      const { CircRuntime: Runtime } = await loadRenderer();
      if (sim.bytes !== bytes) return null;
      dropSession();
      const session = await SimSession.build({
        bytes,
        load: (b) => Runtime.loadFromBytes(b, { noInitialPinDrive: true }),
        roms: currentRoms(),
        images: romImages,
        // The handshake's `diag warning` lines, from the analysis this
        // artifact was built beside; `--sim` prints its own the same way.
        warnings: state.mapped
          .filter((m) => m.severity === 'warning')
          .map((m) => ({ code: m.code, file: m.fileName, line: m.line, col: m.column, message: m.message })),
        bootLow: true,
      });
      if (sim.bytes !== bytes) {
        session.destroy();
        return null;
      }
      sim.session = session;
      sim.sessionBytes = bytes;
      // The console's handshake, before the replay below: the replayed pins
      // are the page's state, silent like the boot, not lines of the session.
      consoleHandshake(session);
      refreshConsoleGate();
      // Replay the reader's pins by name onto the fresh session, value and
      // all. A pin whose name is gone from the new circuit is forgotten.
      const ids = rootInputs(session);
      for (const name of Array.from(sim.pins.keys())) if (!ids.has(name)) sim.pins.delete(name);
      for (const [name, v] of sim.pins) session.set(name, v.value, v.defined);
      sim.unsubscribe = session.subscribe((event) => {
        if (event.kind === 'drive' || event.kind === 'memory') {
          // Another face drove the circuit: the picture, the rows and the dump
          // follow. Only redrawn while on screen: each visible word costs a
          // call across the boundary.
          sim.view?.view.refreshState();
          if (state.dataOpen) renderData();
          if (memVisible()) renderMemory();
          // The filtered table is a function of the pins: a drive re-enumerates
          // it; under the cap the tint alone moves.
          if (state.view === 'truth') {
            if (truth.filtered) void runTruth(buildStage.seq);
            else void refreshTruthTint();
          }
          // The console is the record of every face: what another face did
          // is logged as the line that would have done it. The console's own
          // lines are already in the log (it is busy while they run).
          if (!consoleState.busy) consoleAppend(commandFor(event, session), 'page');
        } else if (event.kind === 'rebuilt') {
          // The protocol's reset: a new runtime, so a canvas over the old one
          // is rebuilt over the new, and the rows read the new.
          if (sim.view) void buildCanvas();
          if (state.dataOpen) renderData();
          renderMemory();
          // The console says so after the reply that caused it, or at once
          // when another face reset the session.
          if (consoleState.busy) consoleState.rebuilt = true;
          else {
            consoleAppend(commandFor(event, session), 'page');
            consoleHandshake(session);
          }
        } else if (event.kind === 'destroyed') {
          if (!consoleState.fresh) consoleAppend(['# session ended']);
          refreshConsoleGate();
        }
      });
      for (const mem of currentRoms()) updateRomStatus(mem);
      renderMemory();
      return session;
    }

    /** The Simulate face: a canvas over the session's runtime. */
    async function buildCanvas() {
      const session = await ensureSession();
      if (!session) return;
      const [{ CircCanvas: Canvas }, themeMod] = await Promise.all([loadRenderer(), loadThemes()]);
      if (sim.session !== session) return;
      const { pickTheme, onAssetsReady } = themeMod;
      sim.view?.destroy();
      sim.view = null;
      simMount.innerHTML = '';
      try {
        const canvas = new Canvas<PaletteKey>(session.runtime as CircRuntime, {
          cell: sim.cell,
          // The furniture's bands, or two cells if ever wider: the value chip
          // above a top-row pin reaches 1.42 cells over its box and wants air.
          padding: Math.max(BENCH_INSET, Math.ceil(sim.cell * 2)),
          interactive: true,
          theme: benchTheme(pickTheme()),
          // Two free rows between stacked boxes, for the same chip.
          layoutOptions: { rowGutter: 2 },
          // The canvas is the inset's size and the renderer fits the circuit
          // into it on its first measurement; a change of inset is the
          // site's to refit (`refitIfIdle`). Zoom on the modifier wheel (a
          // trackpad pinch arrives as one), pan by drag; the page keeps the
          // plain wheel. One finger is the canvas's own above the breakpoint
          // and the page's below it, where the page scrolls (decision 15).
          // Read at construction: a resize across the breakpoint keeps the
          // gesture until the next artifact.
          viewport: 'parent',
          navigation: { wheel: 'modifier', drag: true, touch: narrow.matches ? 'page' : 'own' },
          // Never for the view a canvas is built with, so `syncZoom` below
          // writes the first percentage itself. A change the reader made
          // follows a gesture; the renderer's own fit follows none.
          onViewChange: (view) => {
            if (Date.now() - sim.gestureAt < GESTURE_WINDOW_MS) sim.navigated = true;
            zoomPct.textContent = formatZoom(view.scale);
          },
          // onPinChange, not onPinToggle: the older callback collapses any
          // mixed bus to High, so a reader who typed 0x2A and then flipped the
          // theme would get 0xFF back on the rebuilt canvas. The canvas drove
          // the runtime itself; the session tells the other faces.
          onPinChange: (id: number, value: PinValue) => {
            const changed: DriveAssign[] = [];
            for (const [name, pid] of rootInputs(session)) {
              if (pid === id) {
                sim.pins.set(name, value);
                changed.push({ name, value: value.value, defined: value.defined });
              }
            }
            session.notifyExternal(changed);
          },
          // The base the bus badges are written in and a bare typed value is
          // read in. A change to the setting reaches the live canvas through
          // `setValueFormat` (see the settings drawer's `set`).
          valueFormat: settings().valueFormat,
          // Fires only on a change, so this needs no debounce of its own.
          onHover: (id: number | null) => {
            markInEditor(id === null ? null : (link.table?.byComponentId.get(id) ?? null));
          },
        });
        const view: View = { view: canvas, canvas: canvas.canvas, destroy: () => canvas.destroy() };
        sim.view = view;
        sim.navigated = false;
        const gesture = () => { sim.gestureAt = Date.now(); };
        canvas.canvas.addEventListener('wheel', gesture, { passive: true });
        canvas.canvas.addEventListener('pointermove', (e) => { if (e.buttons !== 0) gesture(); });
        canvas.canvas.addEventListener('touchmove', gesture, { passive: true });
        // The layout is the only place a collapsed macro box exists, so the
        // join is built from it rather than from the topology.
        link.table = linkLayout(link.decls, canvas.getLayout());
        simMount.appendChild(canvas.canvas);
        simMount.hidden = false;
        simNote.textContent = simNoteBase;
        syncZoom();
        if (!sim.assetsHooked) {
          sim.assetsHooked = true;
          // The theme's sprite sheet finished decoding: the same theme now
          // draws with sprites, so a repaint is all it takes.
          onAssetsReady(() => { sim.view?.view.redraw(); });
        }
      } catch (err) {
        simNote.textContent = `Could not render the circuit: ${(err as Error).message}`;
        simMount.hidden = true;
      }
    }
    // ---- the Data face ----
    /** A signature of the rows' shape: a change rebuilds the table, else the
     *  cells are updated in place so a field being typed into survives. */
    let dataShape = '';
    let dataSession: SimSession | null = null;

    /** Open the Data tab on the session, building it on first need. */
    async function showData() {
      const session = await ensureSession();
      if (!state.dataOpen) return;
      if (!session) {
        if (!dataNote.textContent) dataNote.textContent = state.simulateEnabled ? 'Compile a circuit first.' : dataNote.textContent;
        dataFooter.hidden = true;
        dataEl.hidden = true;
        return;
      }
      await loadDataView();
      if (sim.session !== session || !state.dataOpen) return;
      dataNote.textContent = '';
      dataFooter.hidden = false;
      dataEl.hidden = false;
      renderData();
    }

    /** Draw the rows from the session. Synchronous: the module is loaded by `showData` first. */
    function renderData() {
      const session = sim.session;
      const mod = dataViewLoaded;
      if (!session || !mod) return;
      const rows = mod.rowsFor(session, settings().valueFormat);
      dataSummary.textContent = `${rows.filter((r) => r.kind === 'in').length} in · ${rows.filter((r) => r.kind === 'out').length} out`;
      const shape = rows.map((r) => `${r.kind}:${r.name}:${r.width}`).join('|');
      if (session !== dataSession || shape !== dataShape || dataEl.childElementCount === 0) {
        dataSession = session;
        dataShape = shape;
        dataEl.innerHTML = '';
        const sections = new Map<string, HTMLElement>();
        for (const [kind, label] of [['in', 'input'], ['out', 'output']]) {
          const section = document.createElement('section');
          section.className = 'pg-data-section';
          section.setAttribute('aria-label', `${label} pins`);
          const header = document.createElement('div');
          header.className = 'pg-data-columns';
          for (const text of [label, 'bits', 'value']) {
            const span = document.createElement('span');
            span.textContent = text;
            header.appendChild(span);
          }
          section.appendChild(header);
          sections.set(kind, section);
          dataEl.appendChild(section);
        }
        for (const row of rows) {
          const tr = document.createElement('div');
          tr.className = 'pg-data-row';
          tr.dataset.name = row.name;
          tr.dataset.kind = row.kind;
          const name = document.createElement('span');
          name.textContent = row.name;
          name.className = 'pg-data-name';
          const width = document.createElement('span');
          width.textContent = String(row.width);
          width.className = 'pg-data-width';
          const cell = document.createElement('div');
          cell.className = 'pg-data-value';
          tr.append(name, width, cell);
          sections.get(row.kind)!.appendChild(tr);
          if (row.kind === 'out') {
            const span = document.createElement('span');
            span.className = 'pg-data-out';
            cell.appendChild(span);
          } else if (row.width === 1) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'pg-data-toggle';
            btn.title = 'Toggle';
            btn.addEventListener('click', () => {
              const r = mod.toggleRow(session, row.name);
              if (!r.ok) status.textContent = r.message;
            });
            cell.appendChild(btn);
          } else {
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'pg-data-in';
            input.spellcheck = false;
            input.autocomplete = 'off';
            input.setAttribute('aria-label', `${row.name}, ${row.width} bits`);
            const commit = () => {
              const r = mod.editRow(session, row.name, input.value, settings().valueFormat);
              if (!r.ok) {
                status.textContent = r.message;
                input.setAttribute('aria-invalid', 'true');
                return;
              }
              input.removeAttribute('aria-invalid');
            };
            input.addEventListener('keydown', (e) => {
              if (e.key === 'Enter') { e.preventDefault(); commit(); }
              if (e.key === 'Escape' && (input.value !== currentText(row.name) || input.hasAttribute('aria-invalid'))) {
                e.preventDefault(); e.stopPropagation();
                input.value = currentText(row.name); input.removeAttribute('aria-invalid');
              }
            });
            input.addEventListener('blur', () => { if (input.value !== currentText(row.name)) commit(); });
            cell.appendChild(input);
          }
        }
      }
      const active = document.activeElement;
      for (const row of rows) {
        const tr = dataEl.querySelector<HTMLElement>(`.pg-data-row[data-name="${CSS.escape(row.name)}"]`);
        if (!tr) continue;
        const out = tr.querySelector<HTMLElement>('.pg-data-out');
        if (out) out.textContent = row.text;
        const btn = tr.querySelector<HTMLButtonElement>('.pg-data-toggle');
        if (btn) {
          btn.textContent = row.signal === 2 ? '?' : String(row.signal);
          btn.setAttribute('aria-label', `${row.name}, ${row.signal === 2 ? 'unknown' : row.signal}`);
          btn.dataset.signal = String(row.signal);
          btn.setAttribute('aria-pressed', String(row.signal === 1));
        }
        const input = tr.querySelector<HTMLInputElement>('.pg-data-in');
        // A field being typed into keeps the reader's text; every other one
        // shows the circuit's.
        if (input && input !== active) {
          input.value = row.text;
          input.removeAttribute('aria-invalid');
        }
      }
    }

    /** What the circuit holds for a pin, spelled for the field. */
    function currentText(name: string): string {
      const session = sim.session;
      const mod = dataViewLoaded;
      if (!session || !mod) return '';
      return mod.rowsFor(session, settings().valueFormat).find((r) => r.name === name)?.text ?? '';
    }

    dataReset.addEventListener('click', () => {
      const session = sim.session;
      if (!session) return;
      dataReset.disabled = true;
      // The protocol's reset: every pin unknown, the ROM images re-applied.
      // The reader's remembered pins go with it, so a recompile does not
      // bring them back.
      sim.pins.clear();
      void session.reset().finally(() => { dataReset.disabled = false; });
    });

    hooks.onDataOpen = () => { void showData(); };
    hooks.onLive = () => {
      if (state.artifact && sim.renderedHash !== state.artifact.hash) {
        sim.renderedHash = state.artifact.hash;
        void buildCanvas();
      } else if (!state.artifact && !sim.bytes) {
        simNote.textContent = state.simulateEnabled ? 'Compile a circuit first.' : simNote.textContent;
      }
    };
    hooks.onArtifact = (bytes, reason) => {
      sim.bytes = bytes;
      // A new artifact is a new session; the reader's pins are replayed onto it
      // by name when a face next asks for it.
      if (bytes !== sim.sessionBytes) dropSession();
      if (!bytes) {
        link.table = null;
        link.current = null;
        simMount.hidden = true;
        simNote.textContent = state.simulateEnabled
          ? (reason === 'files-changed' ? 'Compile a circuit first.' : 'Fix the errors to simulate.')
          : simNote.textContent;
        dataNote.textContent = simNote.textContent;
        consoleNote.textContent = simNote.textContent;
        dataFooter.hidden = true;
        dataSummary.textContent = '';
        dataEl.hidden = true;
        dataEl.innerHTML = '';
        sim.renderedHash = -1;
        renderMemory();
        return;
      }
      simNote.textContent = '';
      if (state.dataOpen) void showData();
      if (state.view === 'live' && state.artifact && sim.renderedHash !== state.artifact.hash) {
        sim.renderedHash = state.artifact.hash;
        void buildCanvas();
      }
    };
    // Theme flips: circ-renderer captures the theme at construction, so the
    // canvas is rebuilt; the editor reconfigures its theme compartment in place.
    new MutationObserver(() => {
      if (editorMod) editor?.setTheme(editorMod.currentThemeMode());
      // In place: the pins the reader set, the values they typed and the
      // images they loaded are all runtime state of THIS canvas, and a
      // rebuild used to throw every one of them away and replay what it could.
      if (sim.view) void loadThemes().then(({ pickTheme }) => sim.view?.view.setTheme(benchTheme(pickTheme())));
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    // libcirc.wasm still loads only on interaction. `focusin` bubbles, so this
    // one listener covers the CodeMirror mount and the fallback textarea both.
    editorWrap.addEventListener('focusin', () => { void ensureReady(); }, { once: true });
  }
</script>
