---
import Base from '../layouts/Base.astro';
import Playground from '../components/Playground.astro';
import manifest from '../../public/wasm/libcirc.manifest.json';
import { SUPPORTED_TOPOLOGY_VERSIONS } from '../utils/renderer-versions.ts';
---
<Base
  title="Playground — circ"
  description="Write circ in the browser: diagnostics, the --preview schematic, a truth table, and a live simulation of the compiled circuit — no install, no server."
  mdTwin={null}
  layout="app"
>
  <Playground manifest={manifest} supportedVersions={SUPPORTED_TOPOLOGY_VERSIONS} />
</Base>
