---
import Base from '../layouts/Base.astro';
import CodePreview from '../components/CodePreview.astro';
import OpenInPlayground from '../components/OpenInPlayground.astro';
import LiveCanvas from '../components/LiveCanvas.astro';
import { examples, type ExampleLevel } from '../content/examples.ts';
import { GITHUB_REPO, GITHUB_PUBLIC, RENDERER_REPO } from '../utils/url.ts';

// Three tiers, shallow end first. Each carries a one-line brief so a reader
// landing mid-page knows what they are looking at without scrolling back up.
const TIERS: { level: ExampleLevel; title: string; blurb: string }[] = [
  {
    level: 'intro',
    title: 'Introduction',
    blurb: 'One idea each: gates and wiring, the built-in macros, and the bit-shape syntax.',
  },
  {
    level: 'medium',
    title: 'Building blocks',
    blurb: 'The standard combinational parts, each built from the primitives above.',
  },
  {
    level: 'advanced',
    title: 'Advanced',
    blurb: 'Where width, state and macros meet — multi-bit arithmetic, feedback and memory.',
  },
];
const tiers = TIERS.map((t) => ({ ...t, items: examples.filter((e) => e.level === t.level) })).filter(
  (t) => t.items.length > 0,
);
---
<Base
  title="Examples — circ"
  description="A gallery of circ circuits. Source on the left, the --preview ASCII schematic on the right, and a live interactive simulator where available."
>
  <h1>Examples</h1>

  <p class="examples-intro">
    A gallery of <code>circ</code> circuits in three tiers: an
    <a href="#intro">introduction</a> that adds one language feature at a time,
    the <a href="#medium">building blocks</a> those primitives compose into, and
    <a href="#advanced">advanced</a> circuits where width, state and macros meet.
    Each card shows the source on
    the left and the <code>--preview</code> output on the right. Where you see
    a <strong>▶ Run interactively</strong> button, click it to load
    <a href={RENDERER_REPO} rel="noreferrer noopener"><code>circ-renderer</code></a>
    and a compiled WASM artifact — you can then click input pins to flip them
    and watch the simulation propagate.
  </p>

  {tiers.map((tier) => (
  <section class="examples-tier">
    <h2 id={tier.level}>{tier.title}</h2>
    <p class="muted examples-tier-blurb">{tier.blurb}</p>
    <div class="examples-grid">
    {tier.items.map((ex) => (
      <article class="example-card" id={ex.slug}>
        <h3>{ex.title}</h3>
        <p class="lede">{ex.lede}</p>
        <CodePreview source={ex.source} preview={ex.preview} />
        {ex.wasm && <LiveCanvas wasm={ex.wasm} />}
        <OpenInPlayground id={`example:${ex.slug}`} />
        {ex.repoPath && GITHUB_PUBLIC && (
          <p class="source-link muted">
            Source: <a
              href={`${GITHUB_REPO}/blob/main/${ex.repoPath}`}
              rel="noreferrer noopener"
            >{ex.repoPath}</a>
          </p>
        )}
      </article>
    ))}
    </div>
  </section>
  ))}
</Base>
