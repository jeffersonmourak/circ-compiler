---
import Base from '../layouts/Base.astro';
import CodePreview from '../components/CodePreview.astro';
import LiveCanvas from '../components/LiveCanvas.astro';
import OpenInPlayground from '../components/OpenInPlayground.astro';
import { url } from '../utils/url.ts';
import { examples } from '../content/examples.ts';
import { tileMeta, tileMetaLabel } from '../scripts/tile-meta.ts';

const heroSource = `// half_adder.circ
import xor "<builtin>/xor.circ"
input a, b
xor s(a=a, b=b)
and c(a=a, b=b)
output sum(in=s.out)
output carry(in=c.out)
`;
const heroPreview = `╭───╮     ╭───╮
│ a ├○●──▶┤   │         ╭───────╮
╰───╯ │   │AND├○───────▶┤ carry │
      │╭─▶┤   │         ╰───────╯
╭───╮ ││  ╰───╯
│ b ├○┼╯
╰───╯ ││  ╭───────╮
      ╰┼─▶┤       │     ╭─────╮
       │  │[xor:s]├○───▶┤ sum │
       ╰─▶┤       │     ╰─────╯
          ╰───────╯`;
const vocabulary = [
  { key: 'primitives', chips: ['and', 'not', 'led', 'wire', 'rom', 'ram'] },
  { key: 'macros', chips: ['or', 'nand', 'nor', 'xor', 'xnor'], note: 'expand to primitives' },
  { key: 'signals', chips: ['1–64 bits', 'input[4] a', 'a[0..2]', '{a, b}'] },
  { key: 'files', chips: ['import adder "adder.circ"'], note: 'one circuit each' },
];
const pipeline = [
  { title: 'Write a .circ file', body: 'Use any text editor, or write in the playground to check your wiring as you type.' },
  { title: 'Compile it', body: 'Run circ-compile to produce a self-contained WebAssembly module. Use --preview to print a schematic in your terminal.' },
  { title: 'Run the circuit', body: 'Set input pins and read outputs from JavaScript. Run the module in a browser, in Node, or in the playground.' },
];
const tiles = [
  { slug: 'two-bit-adder', cell: 5, lede: 'Adds two 2-bit numbers and produces a sum and carry.' },
  { slug: 'four-bit-adder', cell: 6, lede: 'Adds two 4-bit numbers, passing the carry from one bit to the next.' },
  { slug: 'rom-lookup', cell: 6, lede: 'Stores the squares of 0 through 15. Set an address to read its square.' },
].map(tile => {
  const example = examples.find(example => example.slug === tile.slug);
  if (!example?.wasm) throw new Error(`Missing home-page example artifact: ${tile.slug}`);
  return { ...tile, example, wasm: example.wasm, meta: tileMetaLabel(tileMeta(example.source)) };
});
---
<Base>
  <section class="home-hero">
    <div class="home-hero-copy">
      <h1>Logic circuits, written down.</h1>
      <p class="home-tagline">
        A small language for building and simulating logic circuits, made for
        people learning how computers work.
      </p>
      <div class="home-calls">
        <a class="home-call home-call-primary" href={url('/playground')}>Open the playground &rarr;</a>
        <a class="home-call home-call-secondary" href={url('/reference')}>Read the reference</a>
      </div>
      <a class="home-download" href={url('/download')}>↓ Download circ-compile for Linux, macOS, or Windows</a>
    </div>
    <LiveCanvas
      wasm="hero-half-adder.wasm"
      label="half_adder.circ · live simulation"
      source={heroSource}
      values
      fit="parent"
      autoRun
    >
      <OpenInPlayground
        slot="values-link"
        class="lc-values-link"
        id="example:half-adder"
        label="edit this in the playground"
      />
    </LiveCanvas>
  </section>

  <section class="home-section home-lang">
    <div class="home-card">
      <div class="home-card-pane">
        <div class="home-card-head">vocabulary</div>
        <div class="home-vocab">
          {vocabulary.map(row => <div class="home-vocab-row">
            <span class="home-vocab-key">{row.key}</span>
            <div class="home-vocab-items">{row.chips.map(chip => <span class="home-chip">{chip}</span>)}
              {row.note && <span class="home-vocab-note">{row.note}</span>}
            </div>
          </div>)}
        </div>
      </div>
      <div class="home-card-pane">
        <div class="home-card-head">from file to running chip</div>
        <div class="home-steps">{pipeline.map((step, i) => <div class="home-step">
          <div class="home-step-track"><span class="home-step-n">{i + 1}</span>{i < pipeline.length - 1 && <span class="home-step-rule" />}</div>
          <div><div class="home-step-title">{step.title}</div><p class="home-step-body">{step.body}</p></div>
        </div>)}</div>
      </div>
    </div>
    <div class="home-text">
      <span class="home-kicker">The whole language</span>
      <h2 class="home-h2">Six primitives. Five macros. One import.</h2>
      <p class="home-lede">A program is a list of declarations: name input pins, place gates, and connect their ports. Combine circuits with imports to build larger ones. If you know the early Nand2Tetris hardware chapters, these building blocks will look familiar.</p>
    </div>
  </section>

  <section class="home-section home-preview">
    <div class="home-text">
      <span class="home-kicker">--preview</span>
      <h2 class="home-h2">Source on the left. Schematic on the right.</h2>
      <p class="home-lede">This half-adder uses XOR for the sum and AND for the carry. Run circ-compile with --preview to print its schematic in your terminal.</p>
      <OpenInPlayground class="home-preview-link" id="example:half-adder" label="Open it in the playground" />
    </div>
    <div class="home-figure">
      <CodePreview source={heroSource} preview={heroPreview} />
      <div class="home-status-row"><span>source</span><span>circ-compile --preview</span></div>
    </div>
  </section>

  <section class="home-section home-gallery">
    <div class="home-gallery-head"><span class="home-kicker">From the gallery</span><a class="home-gallery-all" href={url('/gallery')}>All examples &rarr;</a></div>
    <div class="home-tiles">{tiles.map(tile => <a class="home-tile" href={`${url('/gallery')}#${tile.slug}`}>
      <LiveCanvas wasm={tile.wasm} memory={tile.example.memory} cell={tile.cell} thumbnail autoRun />
      <div class="home-tile-body">
        <div class="home-tile-row"><span class="home-tile-name">{tile.slug}</span><span class="home-tile-meta">{tile.meta}</span></div>
        <p class="home-tile-lede">{tile.lede}</p>
      </div>
    </a>)}</div>
  </section>

  <section class="home-section home-install">
    <div class="home-install-head">
      <div class="home-install-title"><span class="home-kicker">Install</span><h2 class="home-install-h2">Run it on your own machine.</h2></div>
      <span class="home-install-platforms">Linux · macOS · Windows · GPL v3</span>
    </div>
    <a class="install-line" href={url('/download')}><span>↓ Download circ-compile for Linux, macOS, or Windows</span><span class="install-line-target">/download &rarr;</span></a>
  </section>
</Base>
