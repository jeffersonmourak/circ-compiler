---
// Loads PostHog's web snippet when PUBLIC_POSTHOG_KEY is set. The token is
// public (it ships to every browser), but reading from env keeps the value
// out of git and lets dev/prod target different projects. Renders nothing
// when the key is missing so contributors can run `bun dev` without one.
const token = import.meta.env.PUBLIC_POSTHOG_KEY;
// `||` (not `??`): GitHub Actions substitutes an empty string for unset
// `vars.*`, which `??` would treat as a real value and let through. An
// empty `api_host` makes the snippet fetch `/static/array.js` from the
// page origin and 404.
const host = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';

// Stub-only — installs `window.posthog` as a queueing stub but does NOT
// call `posthog.init`. Init happens in the bundled module script below so
// the `loaded` callback can be a real function that imports sillyname.
const snippet = token
  ? `!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);`
  : null;
---
{snippet && <script is:inline set:html={snippet} />}
<script>
  import { generateSillyName } from '../utils/sillyname';

  const token = import.meta.env.PUBLIC_POSTHOG_KEY;
  const host = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';

  if (token) {
    // FNV-1a string hash, then mulberry32 PRNG. Same distinct_id always
    // produces the same silly name across reloads, which is the whole
    // point — recurrence becomes "did Cheerful Walrus come back?"
    const hashString = (s: string): number => {
      let h = 2166136261 >>> 0;
      for (let i = 0; i < s.length; i++) {
        h ^= s.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return h >>> 0;
    };
    const mulberry32 = (seed: number) => {
      let a = seed >>> 0;
      return () => {
        a = (a + 0x6d2b79f5) >>> 0;
        let t = a;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    };

    const ph = (window as unknown as { posthog: any }).posthog;
    ph.init(token, {
      api_host: host,
      defaults: '2026-01-30',
      loaded: (instance: any) => {
        const id: string = instance.get_distinct_id();
        const sillyName = generateSillyName(mulberry32(hashString(id)));
        instance.identify(id, { silly_name: sillyName });
      },
    });
  }
</script>
